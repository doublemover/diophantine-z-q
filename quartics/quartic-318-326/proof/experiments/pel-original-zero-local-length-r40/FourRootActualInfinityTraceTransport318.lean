module
public import FourRootActualLocalUniformizer318
public import TraceDifferentPolynomialEquiv318
public section
noncomputable section
namespace FourRootActualInfinityTraceTransport318
open FourRootNormalizedPointCharts318 FourRootActualResidueInertia318
open FourRootReciprocalBranchData318 FourRootInfinityAffineComparison318
open FourRootActualInfinityRamification318
variable (b:Fin 4→ℂ) (hb:Function.Injective b)
local instance infinityBase:Algebra ℂ[X] (I b):=(Polynomial.aeval (iz b none^2)).toAlgebra
local instance finiteBase:Algebra ℂ[X] (A b):=(Polynomial.aeval (az b none)).toAlgebra
local instance infinityDedekind:IsDedekindDomain (I b):=FourRootActualDedekind318.infinity_dedekind b hb
local instance finiteDedekind:IsDedekindDomain (A b):=
  FourRootActualDedekind318.finite_dedekind (branches b) (branches_injective b hb)
local instance infinityFinite:Module.Finite ℂ[X] (I b):=(FourRootSquaredInfinityBase318.finite_free b).1
local instance infinityFree:Module.Free ℂ[X] (I b):=(FourRootSquaredInfinityBase318.finite_free b).2
local instance finiteFinite:Module.Finite ℂ[X] (A b):=(FourRootActualOrderGalois318.finite_free (branches b)).1
local instance finiteFree:Module.Free ℂ[X] (A b):=(FourRootActualOrderGalois318.finite_free (branches b)).2
local instance infinityPointPrime(p:InfinityPoints b):(infinityPrime b p).IsPrime:=infinity_prime b p
local instance finitePointPrime(p:InfinityPoints b):
    (finitePrime (branches b) (finitePoint b hb p)).IsPrime:=finite_prime _ _
abbrev Stalk(p:InfinityPoints b):=Localization.AtPrime (infinityPrime b p)
abbrev FiniteStalk(p:InfinityPoints b):=
  FourRootActualLocalTraceDifferent318.Stalk (branches b) (finitePoint b hb p)
lemma evaluation_comparison(p:InfinityPoints b)(x:I b):
    finiteEvaluation (branches b) (finitePoint b hb p) (equivalence b hb x)=infinityEvaluation b p x:=by
  have he:finiteEvaluation (branches b) (finitePoint b hb p)=
      (infinityEvaluation b p).comp (fromAffine b hb):=
    (FourRootAffineCoordinateRing318.pointEquiv (branches b)).symm_apply_apply _
  rw [he]
  change infinityEvaluation b p ((equivalence b hb).symm (equivalence b hb x))=_
  rw [AlgEquiv.symm_apply_apply]
lemma primeCompl_map(p:InfinityPoints b):
    (infinityPrime b p).primeCompl.map (equivalence b hb).toMonoidHom=
      (finitePrime (branches b) (finitePoint b hb p)).primeCompl:=by
  ext x
  constructor
  · rintro ⟨y,hy,rfl⟩
    change finiteEvaluation (branches b) (finitePoint b hb p) (equivalence b hb y)≠0
    rw [evaluation_comparison]
    exact hy
  · intro hx
    refine ⟨(equivalence b hb).symm x,?_,(equivalence b hb).apply_symm_apply x⟩
    change infinityEvaluation b p ((equivalence b hb).symm x)≠0
    rw [←evaluation_comparison,AlgEquiv.apply_symm_apply]
    exact hx
/-- Actual local-ring equivalence at EACH of the eight infinity points,
using its unchanged full sign triple and exact evaluation prime. -/
@[expose] def stalkEquiv(p:InfinityPoints b):Stalk b p≃ₐ[ℂ]FiniteStalk b hb p:=
  IsLocalization.algEquivOfAlgEquiv (Stalk b p) (FiniteStalk b hb p)
    (equivalence b hb) (primeCompl_map b hb p)
lemma on_source(p:InfinityPoints b)(x:I b):
    stalkEquiv b hb p (algebraMap (I b) (Stalk b p) x)=
      algebraMap (A b) (FiniteStalk b hb p) (equivalence b hb x):=
  IsLocalization.algEquivOfAlgEquiv_eq (primeCompl_map b hb p) x
@[expose] def uAt(p:InfinityPoints b):Stalk b p:=algebraMap (I b) (Stalk b p) (iz b none)
lemma u_image(p:InfinityPoints b):
    stalkEquiv b hb p (uAt b p)=
      FourRootActualLocalTraceDifferent318.rootAt (branches b) (finitePoint b hb p) 0:=by
  rw [uAt,on_source]
  rfl
@[expose] def traceAt(p:InfinityPoints b):Ideal (Stalk b p):=
  (differentIdeal ℂ[X] (I b)).map (algebraMap (I b) (Stalk b p))
lemma trace_image(p:InfinityPoints b):
    (traceAt b hb p).map (stalkEquiv b hb p).toRingHom=
      FourRootActualLocalTraceDifferent318.traceAt (branches b) (branches_injective b hb)
        (finitePoint b hb p):=by
  have he:(stalkEquiv b hb p).toRingHom.comp (algebraMap (I b) (Stalk b p))=
      (algebraMap (A b) (FiniteStalk b hb p)).comp (polynomialEquivalence b hb).toRingHom:=by
    ext x
    exact on_source b hb p x
  rw [traceAt,Ideal.map_map,he,←Ideal.map_map,
    TraceDifferentPolynomialEquiv318.map_different (polynomialEquivalence b hb)]
  rfl
/-- Actual reciprocal-base trace different is generated by literal u at
ALL eight infinity centers, not by a coordinate on an elliptic quotient. -/
theorem actual_infinity_trace(p:InfinityPoints b)(hp:p.val.1=0):
    traceAt b hb p=Ideal.span {uAt b p}:=by
  have hq:(finitePoint b hb p).val.1=branches b 0:=by
    rw [finitePoint_base,hp,zero_pow (by decide:2≠0),branches_zero]
  have hi:Function.Injective (Ideal.map (stalkEquiv b hb p).toRingHom):=by
    intro J K h
    have hinv:(stalkEquiv b hb p).symm.toRingHom.comp (stalkEquiv b hb p).toRingHom=
        RingHom.id (Stalk b p):=by
      ext x
      exact (stalkEquiv b hb p).symm_apply_apply x
    have h':=congrArg (Ideal.map (stalkEquiv b hb p).symm.toRingHom) h
    simpa only [Ideal.map_map,hinv,Ideal.map_id] using h'
  apply hi
  rw [trace_image,FourRootActualLocalTraceDifferent318.at_actual_branch
    (branches b) (branches_injective b hb) (finitePoint b hb p) 0 hq,Ideal.map_span]
  simp only [Set.image_singleton,u_image]
theorem actual_infinity_uniformizer(p:InfinityPoints b)(hp:p.val.1=0):
    Irreducible (uAt b p):=by
  apply (MulEquiv.irreducible_iff (f:=(stalkEquiv b hb p).toRingEquiv.toMulEquiv)).mp
  rw [u_image]
  have hq:(finitePoint b hb p).val.1=branches b 0:=by
    rw [finitePoint_base,hp,zero_pow (by decide:2≠0),branches_zero]
  exact FourRootActualLocalUniformizer318.actual_uniformizer
    (branches b) (branches_injective b hb) 0 (finitePoint b hb p) hq
end FourRootActualInfinityTraceTransport318
