module
public import FourRootActualRelativeDifferentUnit318
public section
noncomputable section
namespace FourRootActualLocalTraceDifferent318
open FourRootActualFiniteBranchChart318 FourRootActualFractionField318
open FourRootActualResidueInertia318 FourRootNormalizedPointCharts318
attribute [local instance] FractionRing.liftAlgebra FractionRing.isScalarTower_liftAlgebra
variable (b:Fin 4→ℂ) (hb:Function.Injective b)
local instance polyAlgebra:Algebra ℂ[X] (A b):=
  (Polynomial.aeval (FourRootAffineCoordinateRing318.coordinate b none)).toAlgebra
local instance affineDedekind:IsDedekindDomain (A b):=FourRootActualDedekind318.finite_dedekind b hb
local instance affineFinite:Module.Finite ℂ[X] (A b):=(FourRootActualOrderGalois318.finite_free b).1
local instance affineFree:Module.Free ℂ[X] (A b):=(FourRootActualOrderGalois318.finite_free b).2
local instance pointPrime(p:FinitePoints b):(finitePrime b p).IsPrime:=finite_prime b p
abbrev Stalk(p:FinitePoints b):=Localization.AtPrime (finitePrime b p)
@[expose] def rootAt(p:FinitePoints b)(i:Fin 4):Stalk b p:=
  algebraMap (A b) (Stalk b p) (FourRootAffineCoordinateRing318.coordinate b (some i))
@[expose] def traceAt(p:FinitePoints b):Ideal (Stalk b p):=
  (differentIdeal ℂ[X] (A b)).map (algebraMap (A b) (Stalk b p))
lemma ideal_unit_at (p:FinitePoints b) (J:Ideal (A b)) (h:¬finitePrime b p∣J):
    J.map (algebraMap (A b) (Stalk b p))=⊤:=by
  have hn:¬J≤finitePrime b p:=by simpa only [Ideal.dvd_iff_le] using h
  obtain ⟨x,hx,hxp⟩:=SetLike.not_le_iff_exists.mp hn
  apply Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_map_of_mem _ hx)
  exact IsLocalization.map_units (Stalk b p) ⟨x,hxp⟩

/-- The ACTUAL trace-dual different, localized at the original point,
is generated by the same signed root as the intrinsic Kähler frame.
The relative eightfold different vanishes here by the produced étale
neighborhood; no global relative-unit assertion is used. -/
theorem actual_trace_generator (p:FinitePoints b) (i:Fin 4)
    (hp:denominator b i∉finitePrime b p):
    traceAt b hb p=Ideal.span {rootAt b p i}:=by
  letI:Algebra (BranchBase b i) (A b):=(FourRootActualDifferentTower318.branchMap b i).toAlgebra
  letI:IsDedekindDomain (BranchBase b i):=ActualLinearRootDifferent318.dedekind (b i)
  letI:Module.Free (BranchBase b i) (A b):=(FourRootActualDifferentTower318.relative_finite_free b i).2
  have hu:=ideal_unit_at b hb p (differentIdeal (BranchBase b i) (A b))
    (FourRootActualRelativeDifferentUnit318.relative_trace_unit b hb i p hp)
  rw [traceAt,FourRootActualDifferentTower318.actual_factorization b hb i,
    Ideal.map_mul,hu,Ideal.top_mul,Ideal.map_span]
  simp only [Set.image_singleton,map_mul,map_ofNat]
  change Ideal.span {2*rootAt b p i}=Ideal.span {rootAt b p i}
  have h2:IsUnit (2:Stalk b p):=by
    simpa only [map_ofNat] using (IsUnit.mk0 (2:ℂ) (by norm_num)).map (algebraMap ℂ (Stalk b p))
  rw [Ideal.span_singleton_mul_left_unit h2]

theorem at_actual_branch (p:FinitePoints b) (i:Fin 4) (hp:p.val.1=b i):
    traceAt b hb p=Ideal.span {rootAt b p i}:=
  actual_trace_generator b hb p i
    (FourRootActualKaehlerNeighborhoods318.finite_branch_neighborhood b hb p i hp)
end FourRootActualLocalTraceDifferent318

namespace FourRootActualLocalTraceDifferent318
open FourRootActualFiniteBranchChart318 FourRootActualFractionField318
open FourRootActualResidueInertia318 FourRootNormalizedPointCharts318
variable (b:Fin 4→ℂ) (hb:Function.Injective b)
local instance polyAlgebra:Algebra ℂ[X] (A b):=
  (Polynomial.aeval (FourRootAffineCoordinateRing318.coordinate b none)).toAlgebra
local instance affineDedekind:IsDedekindDomain (A b):=FourRootActualDedekind318.finite_dedekind b hb
local instance affineFree:Module.Free ℂ[X] (A b):=(FourRootActualOrderGalois318.finite_free b).2
local instance pointPrime(p:FinitePoints b):(finitePrime b p).IsPrime:=finite_prime b p
abbrev Chart(i:Fin 4):=FourRootActualBranchKaehler318.SourceRing b i
local instance chartBase(i:Fin 4):Algebra ℂ[X] (Chart b i):=
  (Polynomial.aeval (FourRootActualBranchKaehler318.sourceParameter b i)).toAlgebra
/-- Literal annihilator ideal of the actual relative cotangent module. -/
@[expose] def cotangentAnnihilator(i:Fin 4):Ideal (Chart b i) where
  carrier:={a|∀ω:KaehlerDifferential ℂ[X] (Chart b i),a • ω=0}
  zero_mem':=by intro ω;simp
  add_mem':=by intro a c ha hc ω;rw [add_smul,ha,hc,add_zero]
  smul_mem':=by intro r a ha ω;change (r*a) • ω=0;rw [mul_smul,ha,smul_zero]
lemma cotangentAnnihilator_eq(i:Fin 4):
    cotangentAnnihilator b i=Ideal.span {FourRootActualBranchKaehler318.sourceCoordinate b i}:=by
  ext a
  exact FourRootActualRelativeCotangent318.finite_simple_annihilator b i a
@[expose] def chartToStalk(p:FinitePoints b)(i:Fin 4)
    (hp:denominator b i∉finitePrime b p):Chart b i→+*Stalk b p:=
  IsLocalization.Away.lift (denominator b i)
    (IsLocalization.map_units (Stalk b p) ⟨denominator b i,hp⟩)
lemma chartToStalk_coordinate(p:FinitePoints b)(i:Fin 4)
    (hp:denominator b i∉finitePrime b p):
    chartToStalk b p i hp (FourRootActualBranchKaehler318.sourceCoordinate b i)=rootAt b p i:=by
  rw [FourRootActualBranchKaehler318.source_coordinate_original]
  exact IsLocalization.Away.lift_eq _ _ _

/-- Equality is proved between independently constructed objects:
the original trace-dual different stalk and the image of the ACTUAL
relative cotangent annihilator on its proved principal neighborhood. -/
theorem trace_equals_cotangent(p:FinitePoints b)(i:Fin 4)
    (hp:denominator b i∉finitePrime b p):
    traceAt b hb p=(cotangentAnnihilator b i).map (chartToStalk b p i hp):=by
  rw [actual_trace_generator b hb p i hp,cotangentAnnihilator_eq,Ideal.map_span]
  simp only [Set.image_singleton,chartToStalk_coordinate]
end FourRootActualLocalTraceDifferent318
