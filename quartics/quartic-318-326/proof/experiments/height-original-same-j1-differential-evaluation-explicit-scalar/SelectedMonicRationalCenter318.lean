module
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
public import Mathlib.RingTheory.AdjoinRoot
public import Mathlib.Analysis.Complex.Basic
public section
noncomputable section
open Polynomial

namespace SelectedMonicRationalCenter318

variable {R : Type*} [CommRing R] (p : R[X])
variable (b : AdjoinRoot p →+* ℂ)
variable (ε : R →+* ℚ)
variable (hε : b.comp (algebraMap R (AdjoinRoot p)) = (algebraMap ℚ ℂ).comp ε)

abbrev root : ℂ := b (AdjoinRoot.root p)

/-- The simple field is generated by the root that the original evaluation
actually takes, not an arbitrary root chosen from the specialized polynomial. -/
@[expose] def centerField : IntermediateField ℚ ℂ :=
  IntermediateField.adjoin ℚ {root p b}

@[expose] def fieldRoot : centerField p b :=
  ⟨root p b, IntermediateField.subset_adjoin ℚ _ (Set.mem_singleton _)⟩

@[simp] theorem fieldRoot_val : (centerField p b).val (fieldRoot p b) = root p b :=
  rfl

include hε in
theorem eval_mk (f : R[X]) :
    b (AdjoinRoot.mk p f) = f.eval₂ ((algebraMap ℚ ℂ).comp ε) (root p b) := by
  rw [← AdjoinRoot.aeval_eq,Polynomial.aeval_def,Polynomial.hom_eval₂,hε] <;> rfl

include hε in
theorem specialized_root : aeval (root p b) (p.map ε) = 0 := by
  rw [Polynomial.aeval_def,Polynomial.eval₂_map,← eval_mk p b ε hε,AdjoinRoot.mk_self,map_zero]

include hε in
theorem root_integral (hp : p.Monic) : IsIntegral ℚ (root p b) :=
  ⟨p.map ε,hp.map ε,specialized_root p b ε hε⟩

include hε in
theorem center_finite (hp : p.Monic) : FiniteDimensional ℚ (centerField p b) :=
  IntermediateField.adjoin.finiteDimensional (root_integral p b ε hε hp)

include hε in
theorem center_degree_le (hp : p.Monic) : Module.finrank ℚ (centerField p b) ≤ p.natDegree := by
  rw [centerField,IntermediateField.adjoin.finrank (root_integral p b ε hε hp),← hp.natDegree_map ε]
  exact natDegree_le_of_dvd (minpoly.dvd ℚ (root p b) (specialized_root p b ε hε))
    (hp.map ε).ne_zero

private theorem incl_scalar :
    (centerField p b).val.toRingHom.comp (algebraMap ℚ (centerField p b)) = algebraMap ℚ ℂ := by
  apply RingHom.ext
  intro r
  exact (centerField p b).val.commutes r

include hε in
private theorem relation_in_field :
    p.eval₂ ((algebraMap ℚ (centerField p b)).comp ε) (fieldRoot p b) = 0 := by
  apply (centerField p b).val.injective
  change (centerField p b).val
    (p.eval₂ ((algebraMap ℚ (centerField p b)).comp ε) (fieldRoot p b)) = _
  rw [map_zero,Polynomial.hom_eval₂,← RingHom.comp_assoc,incl_scalar,fieldRoot_val,
    ← eval_mk p b ε hε,AdjoinRoot.mk_self,map_zero]

/-- Actual evaluation in the simple field, defined by the very same root
and the rational coefficient specialization, not a numerical field bound. -/
@[expose] def fieldEval : AdjoinRoot p →+* centerField p b :=
  AdjoinRoot.lift ((algebraMap ℚ (centerField p b)).comp ε) (fieldRoot p b)
    (relation_in_field p b ε hε)

theorem fieldEval_root :
    fieldEval p b ε hε (AdjoinRoot.root p) = fieldRoot p b :=
  AdjoinRoot.lift_root ..

theorem fieldEval_base (r : R) :
    fieldEval p b ε hε (algebraMap R (AdjoinRoot p) r) =
      algebraMap ℚ (centerField p b) (ε r) :=
  AdjoinRoot.lift_of ..

/-- Factorization on the whole arithmetic regular-ring evaluation, not
only algebraicity of a single coordinate. -/
theorem realizes_eval :
    (centerField p b).val.toRingHom.comp (fieldEval p b ε hε) = b := by
  apply RingHom.ext
  intro a
  obtain ⟨f,rfl⟩ := AdjoinRoot.mk_surjective a
  rw [RingHom.comp_apply,fieldEval,AdjoinRoot.lift_mk,Polynomial.hom_eval₂,
    ← RingHom.comp_assoc,incl_scalar,fieldRoot_val,eval_mk p b ε hε]

end SelectedMonicRationalCenter318

#print axioms SelectedMonicRationalCenter318.center_finite
#print axioms SelectedMonicRationalCenter318.realizes_eval
