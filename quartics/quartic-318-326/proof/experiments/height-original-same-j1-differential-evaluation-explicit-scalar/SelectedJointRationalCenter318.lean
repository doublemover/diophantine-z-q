module
public import SelectedMonicRationalCenter318
public import Mathlib.RingTheory.TensorProduct.Maps
public import Mathlib.LinearAlgebra.Matrix.Determinant.Basic
public section
noncomputable section
open Polynomial
open scoped TensorProduct

namespace SelectedJointRationalCenter318

section RationalFunctions

variable {B K K' : Type*} [CommRing B] [Field K] [Field K']
variable [Algebra ℚ K] [Algebra ℚ K']

/-- Extend each arithmetic evaluation by precisely its rational scalars.
This allows rational regular coefficients without declaring every basis
differential integral in the integer-coordinate chart. -/
@[expose] def rationalEval (f : B →+* K) : ℚ ⊗[ℤ] B →ₐ[ℚ] K :=
  Algebra.TensorProduct.lift (Algebra.ofId ℚ K)
    { toRingHom := f
      commutes' := fun n => by
        change f (n : B) = (n : K)
        exact map_intCast f n }
    (fun a b => Commute.all _ _)

theorem rationalEval_tmul (f : B →+* K) (q : ℚ) (b : B) :
    rationalEval f (q ⊗ₜ[ℤ] b) = algebraMap ℚ K q * f b := rfl

theorem rationalEval_comp (σ : K →ₐ[ℚ] K') (f : B →+* K) :
    σ.comp (rationalEval f) = rationalEval (σ.toRingHom.comp f) := by
  apply AlgHom.ext
  intro a
  induction a using TensorProduct.induction_on with
  | zero => simp only [map_zero]
  | tmul q b =>
    change σ (rationalEval f (q ⊗ₜ[ℤ] b)) =
      rationalEval (σ.toRingHom.comp f) (q ⊗ₜ[ℤ] b)
    rw [rationalEval_tmul,rationalEval_tmul,map_mul,AlgHom.commutes,RingHom.comp_apply] <;> rfl
  | add a b ha hb => simp only [map_add,ha,hb]

end RationalFunctions

section Joint

variable {ι R : Type*} [CommRing R]
variable (p : R[X]) (b : ι → AdjoinRoot p →+* ℂ)
variable (ε : R →+* ℚ)
variable (hε : ∀ i, (b i).comp (algebraMap R (AdjoinRoot p)) = (algebraMap ℚ ℂ).comp ε)

abbrev roots : ι → ℂ := fun i => SelectedMonicRationalCenter318.root p (b i)
abbrev simple (i : ι) : IntermediateField ℚ ℂ :=
  SelectedMonicRationalCenter318.centerField p (b i)

/-- The common field is the actual embedded compositum generated by the
same finite list of center coordinates. It is not any preselected field. -/
@[expose] def jointField : IntermediateField ℚ ℂ :=
  IntermediateField.adjoin ℚ (Set.range (roots p b))

theorem simple_le (i : ι) : simple p b i ≤ jointField p b := by
  apply IntermediateField.adjoin_le_iff.mpr
  intro z hz
  have hz' : z = roots p b i := Set.mem_singleton_iff.mp hz
  rw [hz']
  exact IntermediateField.subset_adjoin ℚ _ ⟨i,rfl⟩

theorem joint_le_iff (F : IntermediateField ℚ ℂ) :
    jointField p b ≤ F ↔ ∀ i, simple p b i ≤ F := by
  constructor
  · exact fun h i => (simple_le p b i).trans h
  · intro h
    apply IntermediateField.adjoin_le_iff.mpr
    rintro z ⟨i,rfl⟩
    exact h i (IntermediateField.subset_adjoin ℚ _ (Set.mem_singleton _))

include hε in
theorem finite_joint [Finite ι] (hp : p.Monic) :
    FiniteDimensional ℚ (jointField p b) := by
  letI : Finite (Set.range (roots p b)) := (Set.finite_range _).to_subtype
  apply IntermediateField.finiteDimensional_adjoin
  rintro z ⟨i,rfl⟩
  exact SelectedMonicRationalCenter318.root_integral p (b i) ε (hε i) hp

@[expose] def simpleIncl (i : ι) : simple p b i →ₐ[ℚ] jointField p b :=
  IntermediateField.inclusion (simple_le p b i)

theorem simpleIncl_val (i : ι) :
    (jointField p b).val.comp (simpleIncl p b i) = (simple p b i).val := by
  apply AlgHom.ext
  intro a
  rfl

/-- Keep every original point's evaluation; only its target changes by the
actual inclusion of its simple field in the common one. -/
@[expose] def jointEval (i : ι) : AdjoinRoot p →+* jointField p b :=
  (simpleIncl p b i).toRingHom.comp
    (SelectedMonicRationalCenter318.fieldEval p (b i) ε (hε i))

theorem jointEval_realizes (i : ι) :
    (jointField p b).val.toRingHom.comp (jointEval p b ε hε i) = b i := by
  change (jointField p b).val.toRingHom.comp
      ((simpleIncl p b i).toRingHom.comp
        (SelectedMonicRationalCenter318.fieldEval p (b i) ε (hε i))) = _
  have hc : (jointField p b).val.toRingHom.comp (simpleIncl p b i).toRingHom =
      (simple p b i).val.toRingHom :=
    congrArg AlgHom.toRingHom (simpleIncl_val p b i)
  rw [← RingHom.comp_assoc,hc,SelectedMonicRationalCenter318.realizes_eval]

theorem eval_at_embedding (σ : jointField p b →ₐ[ℚ] ℂ)
    (i : ι) (a : ℚ ⊗[ℤ] AdjoinRoot p) :
    σ (rationalEval (jointEval p b ε hε i) a) =
      rationalEval ((σ.comp (simpleIncl p b i)).toRingHom.comp
        (SelectedMonicRationalCenter318.fieldEval p (b i) ε (hε i))) a := by
  have h := DFunLike.congr_fun (rationalEval_comp σ (jointEval p b ε hε i)) a
  have hc : σ.toRingHom.comp (jointEval p b ε hε i) =
      (σ.comp (simpleIncl p b i)).toRingHom.comp
        (SelectedMonicRationalCenter318.fieldEval p (b i) ε (hε i)) := by
    rw [jointEval,← RingHom.comp_assoc] <;> rfl
  simpa only [AlgHom.comp_apply,hc] using h

theorem eval_at_original_embedding (i : ι) (a : ℚ ⊗[ℤ] AdjoinRoot p) :
    (jointField p b).val (rationalEval (jointEval p b ε hε i) a) = rationalEval (b i) a := by
  have h := DFunLike.congr_fun
    (rationalEval_comp (jointField p b).val (jointEval p b ε hε i)) a
  simpa only [AlgHom.comp_apply,jointEval_realizes] using h

variable {n : Type*} (row : n → ι) (a : Matrix n n (ℚ ⊗[ℤ] AdjoinRoot p))

/-- Same ordered row map and same regular coefficient in every entry. -/
@[expose] def minor : Matrix n n (jointField p b) :=
  fun i j => rationalEval (jointEval p b ε hε (row i)) (a i j)

@[expose] def observedMinor : Matrix n n ℂ :=
  fun i j => rationalEval (b (row i)) (a i j)

variable [Fintype n] [DecidableEq n]

theorem minor_realizes :
    (jointField p b).val.toRingHom.mapMatrix (minor p b ε hε row a) =
      observedMinor p b row a := by
  apply Matrix.ext
  intro i j
  exact eval_at_original_embedding p b ε hε (row i) (a i j)

theorem minor_at_embedding (σ : jointField p b →ₐ[ℚ] ℂ) :
    σ.toRingHom.mapMatrix (minor p b ε hε row a) =
      (fun i j => rationalEval
        ((σ.comp (simpleIncl p b (row i))).toRingHom.comp
          (SelectedMonicRationalCenter318.fieldEval p (b (row i)) ε (hε (row i)))) (a i j)) := by
  apply Matrix.ext
  intro i j
  exact eval_at_embedding p b ε hε σ (row i) (a i j)


/-- The determinant is the same minor under the original embedding; a
nonsingular original minor therefore stays nonsingular without reselecting
rows or changing signs. -/
theorem det_realizes :
    (jointField p b).val (minor p b ε hε row a).det = (observedMinor p b row a).det := by
  simpa only [minor_realizes] using
    (jointField p b).val.toRingHom.map_det (minor p b ε hε row a)

theorem det_ne_zero_iff :
    (minor p b ε hε row a).det ≠ 0 ↔ (observedMinor p b row a).det ≠ 0 := by
  rw [← det_realizes p b ε hε row a]
  constructor
  · intro h hz
    apply h
    apply (jointField p b).val.injective
    simpa only [map_zero] using hz
  · intro h hz
    exact h (by rw [hz,map_zero])

end Joint
end SelectedJointRationalCenter318

