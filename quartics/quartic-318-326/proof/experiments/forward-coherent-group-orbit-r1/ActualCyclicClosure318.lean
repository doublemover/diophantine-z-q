module
public import RealCoherentOrbit318
public import CompactGuardProgression318
public section
noncomputable section
namespace ActualCyclicClosure318
open Set RealQuarticAmbient318 RealQuarticGroup318
set_option maxHeartbeats 2000000

local instance ovalGroup (e : Fin 2) : AddCommGroup (Oval (d e)) :=
  group (d e) (lt_trans zero_lt_one (d_gt_one e))
local instance ovalTopology (e : Fin 2) : IsTopologicalAddGroup (Oval (d e)) :=
  RealQuarticTopologicalGroup318.topologicalGroup (d e) (lt_trans zero_lt_one (d_gt_one e))
local instance ovalCompact (e : Fin 2) : CompactSpace (Oval (d e)) :=
  RealQuarticTopologicalGroup318.compactSpace (d e) (lt_trans zero_lt_one (d_gt_one e))

/-- Both actual real embeddings, with their original real-subspace topologies. -/
abbrev Pair := (e : Fin 2) → Oval (d e)

instance pairGroup : AddCommGroup Pair := inferInstance
instance pairTopology : IsTopologicalAddGroup Pair := inferInstance
instance pairCompact : CompactSpace Pair := inferInstance

@[expose] def pairOrbit (n : ℤ) : Pair := fun e => RealCoherentOrbit318.orbit (embedding e) n
@[expose] def generator : Pair := pairOrbit 1

lemma pairOrbit_zsmul (n : ℤ) : pairOrbit n=n • generator := by
  funext e
  exact RealCoherentOrbit318.orbit_zsmul (embedding e) n

lemma pairOrbit_injective : Function.Injective pairOrbit := by
  intro n m he
  exact RealCoherentOrbit318.orbit_injective (embedding 0) (congrFun he 0)

/-- The genuine closed cyclic subgroup generated by the actual arithmetic
point in the two real ovals. It is not assumed to be the full product. -/
@[expose] def cyclicClosure : AddSubgroup Pair := (AddSubgroup.zmultiples generator).topologicalClosure

lemma cyclicClosure_eq : (cyclicClosure : Set Pair)=closure (range pairOrbit) := by
  change closure (range (fun n : ℤ => n • generator))=closure (range pairOrbit)
  congr 1
  congr 1
  funext n
  exact (pairOrbit_zsmul n).symm

instance closureCompact : CompactSpace cyclicClosure :=
  isCompact_iff_compactSpace.mp (AddSubgroup.isClosed_topologicalClosure _).isCompact

@[expose] def generatorInClosure : cyclicClosure :=
  ⟨generator,AddSubgroup.le_topologicalClosure _ (AddSubgroup.mem_zmultiples generator)⟩

/-- The integer orbit is dense in this exact closed subgroup by construction. -/
theorem integer_orbit_dense : DenseRange (fun n : ℤ => n • generatorInClosure) := by
  have hd := ((denseRange_inclusion_iff
      (subset_closure : range (fun n : ℤ => n • generator) ⊆ closure (range (fun n : ℤ => n • generator)))).2
      subset_rfl).comp (rangeFactorization_surjective (f:=fun n : ℤ => n • generator)).denseRange
      (continuous_inclusion subset_closure)
  exact hd

/-- Every actual open region of the closed arithmetic orbit is met arbitrarily
late by positive integer multiples. Region nonemptiness is not assumed away. -/
theorem positive_tail (U : Set cyclicClosure) (hU : IsOpen U) (hne : U.Nonempty) (B : ℕ) :
    ∃ n : ℕ, B<n ∧ n • generatorInClosure∈U := by
  simpa only [zero_add] using CompactGuardProgression318.positive_tail
    generatorInClosure (0:cyclicClosure) integer_orbit_dense U hU hne B

/-- The ambient point of each lifted integer multiple is exactly the same
coherent arithmetic point, in both embeddings. -/
lemma coe_integer_multiple (n : ℤ) :
    ((n • generatorInClosure : cyclicClosure) : Pair)=pairOrbit n :=
  (pairOrbit_zsmul n).symm

end ActualCyclicClosure318
