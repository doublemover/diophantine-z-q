module
public import SelectedGeneralizedAffineInfinity318
import Mathlib.Tactic.LinearCombination
public section
noncomputable section
open MvPolynomial Algebra SelectedGeneralizedAffineInfinity318

namespace SelectedGeneralizedInfinityCartier318

variable {R : Type*} [CommRing R]

/-- This extra literal factor isolates the identity from possible
other zeros of t inside the Jacobian open. -/
@[expose] def factor (d : Rˣ) : Chart d :=
  1+parameter d+algebraMap R (Chart d) (36*(↑d⁻¹ : R))*parameter d*ordinate d+
    algebraMap R (Chart d) (↑d⁻¹ : R)*(ordinate d)^2

theorem equation_factored (d : Rˣ) : ordinate d * factor d = (parameter d)^3 := by
  have h : Ideal.Quotient.mk (Ideal.span (Set.range (equations d))) (equation d) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.subset_span ⟨(),rfl⟩)
  simp only [equation,map_add,map_sub,map_mul,map_pow] at h
  let q : MvPolynomial (Fin 2) R →+* Chart d := Ideal.Quotient.mk _
  have hCoeff : q (C (36 : R)) * q (C (↑d⁻¹ : R)) =
      algebraMap R (Chart d) (36*(↑d⁻¹ : R)) := by
    change q (C (36 : R)) * q (C (↑d⁻¹ : R)) = q (C (36*(↑d⁻¹ : R)))
    simp only [map_mul]
  change q (X 1) + q (X 0)*q (X 1) - q (X 0)^3 +
    q (C (36 : R))*q (C (↑d⁻¹ : R))*q (X 0)*q (X 1)^2 +
    q (C (↑d⁻¹ : R))*q (X 1)^3 = 0 at h
  rw [hCoeff] at h
  change ordinate d + parameter d*ordinate d - (parameter d)^3 +
    algebraMap R (Chart d) (36*(↑d⁻¹ : R))*parameter d*(ordinate d)^2 +
    algebraMap R (Chart d) (↑d⁻¹ : R)*(ordinate d)^3 = 0 at h
  unfold factor
  linear_combination h

theorem origin_factor (d : Rˣ) : origin d (factor d) = 1 := by simp [factor]

@[expose] def den (d : Rˣ) : Chart d := (presentation d).jacobian * factor d
abbrev OpenRing (d : Rˣ) := Localization.Away (den d)

@[expose] def localT (d : Rˣ) : OpenRing d := algebraMap (Chart d) (OpenRing d) (parameter d)
@[expose] def localZ (d : Rˣ) : OpenRing d := algebraMap (Chart d) (OpenRing d) (ordinate d)

theorem origin_den (d : Rˣ) : origin d (den d) = 1 := by
  rw [den,map_mul,origin_jacobian,origin_factor,mul_one]

@[expose] def augmentation (d : Rˣ) : OpenRing d →ₐ[R] R :=
  IsLocalization.Away.liftAlgHom (f := origin d) (den d)
    (by rw [origin_den]; exact isUnit_one)

theorem augmentation_map (d : Rˣ) (y : Chart d) :
    augmentation d (algebraMap (Chart d) (OpenRing d) y) = origin d y := by
  rw [augmentation,IsLocalization.Away.liftAlgHom_apply,IsLocalization.Away.lift_eq] <;> rfl

theorem ordinate_mem_parameter (d : Rˣ) :
    localZ d ∈ Ideal.span ({localT d} : Set (OpenRing d)) := by
  let I : Ideal (OpenRing d) := Ideal.span {localT d}
  let c := algebraMap (Chart d) (OpenRing d) (factor d)
  have hu : IsUnit c := IsLocalization.Away.isUnit_of_dvd (den d)
    (dvd_mul_left (factor d) (presentation d).jacobian)
  have h : localZ d * c = (localT d)^3 := by
    change algebraMap (Chart d) (OpenRing d) (ordinate d) *
      algebraMap (Chart d) (OpenRing d) (factor d) =
        (algebraMap (Chart d) (OpenRing d) (parameter d))^3
    exact ((algebraMap (Chart d) (OpenRing d)).map_mul _ _).symm.trans
      ((congrArg (algebraMap (Chart d) (OpenRing d)) (equation_factored d)).trans
        (map_pow (algebraMap (Chart d) (OpenRing d)) _ _))
  apply (I.mul_unit_mem_iff_mem hu).1
  rw [h]
  exact Ideal.mem_span_singleton'.2 ⟨(localT d)^2,(pow_succ (localT d) 2).symm⟩

/-- On this exact smaller neighborhood, the full scheme-theoretic
identity ideal is generated by the same parameter t. Residue-point
or reduced-scheme reasoning would not suffice for this equality. -/
theorem augmentation_ker (d : Rˣ) :
    RingHom.ker (augmentation d).toRingHom = Ideal.span {localT d} := by
  let I : Ideal (OpenRing d) := Ideal.span {localT d}
  let C := OpenRing d
  let q := Ideal.Quotient.mkₐ R I
  let f : Chart d →ₐ[R] C ⧸ I := q.comp (IsScalarTower.toAlgHom R (Chart d) C)
  let g : Chart d →ₐ[R] C ⧸ I := (Algebra.ofId R _).comp (origin d)
  have hleft : q (localT d) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.subset_span (Set.mem_singleton _))
  have hright : q (localZ d) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.2 (ordinate_mem_parameter d)
  have hfg : f = g := by
    apply Ideal.Quotient.algHom_ext R
    apply MvPolynomial.algHom_ext
    intro i
    fin_cases i
    · change q (localT d) = algebraMap R (C ⧸ I) (origin d (parameter d))
      rw [hleft,origin_parameter,map_zero]
    · change q (localZ d) = algebraMap R (C ⧸ I) (origin d (ordinate d))
      rw [hright,origin_ordinate,map_zero]
  apply le_antisymm
  · intro y hy
    have hzero : augmentation d y = 0 := RingHom.mem_ker.mp hy
    obtain ⟨⟨a,b⟩,hab⟩ := IsLocalization.surj (Submonoid.powers (den d)) y
    have haug := congrArg (augmentation d) hab
    rw [map_mul,hzero,zero_mul,augmentation_map] at haug
    have hc := congrArg (fun k : Chart d →ₐ[R] C ⧸ I => k a) hfg
    change q (algebraMap (Chart d) C a) = algebraMap R (C ⧸ I) (origin d a) at hc
    rw [← haug,map_zero] at hc
    have hm : algebraMap (Chart d) C a ∈ I := Ideal.Quotient.eq_zero_iff_mem.1 hc
    have hb : IsUnit (algebraMap (Chart d) C (b : Chart d)) := IsLocalization.map_units C b
    exact (I.mul_unit_mem_iff_mem hb).1 (hab.symm ▸ hm)
  · apply (Ideal.span_singleton_le_iff_mem (RingHom.ker (augmentation d).toRingHom)).2
    apply RingHom.mem_ker.2
    exact (augmentation_map d _).trans (origin_parameter d)

end SelectedGeneralizedInfinityCartier318

#print axioms SelectedGeneralizedInfinityCartier318.equation_factored
#print axioms SelectedGeneralizedInfinityCartier318.augmentation_ker
