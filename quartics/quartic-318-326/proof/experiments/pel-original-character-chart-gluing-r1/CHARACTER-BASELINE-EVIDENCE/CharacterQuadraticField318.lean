module
public import CharacterRoot318
public import Mathlib.FieldTheory.Galois.Basic
public section
noncomputable section
namespace CharacterQuadraticField318
open KummerTensorField318 FourRootAutomorphisms318 CharacterRoot318
set_option maxHeartbeats 800000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
variable {F:Type*} [Field F] [CharZero F] (a:Fin 4→F)
  [Fact (QuadraticTower318.Independent a)] (s:Finset (Fin 4))
  [Fact (¬IsSquare (radicand a s))]
abbrev Quadratic:=QuadraticAlgebra F (radicand a s) 0
@[expose] def lift : Quadratic a s→ₐ[F]Raw a:=
  QuadraticAlgebra.lift ⟨root a s,by
    rw [←pow_two,root_square]
    simp [Algebra.smul_def]⟩
@[expose] def field : IntermediateField F (Raw a):=(lift a s).fieldRange
@[expose] def equiv : Quadratic a s≃ₐ[F]field a s:=(lift a s).equivFieldRange

theorem degree_two : Module.finrank F (field a s)=2:=by
  rw [←(equiv a s).toLinearEquiv.finrank_eq]
  exact QuadraticAlgebra.finrank_eq_two _ _

theorem root_mem : root a s∈field a s:=by
  refine ⟨⟨0,1⟩,?_⟩
  simp [lift,QuadraticAlgebra.lift_apply_apply]

/-- The actual character field is generated by the actual product of roots,
not just an abstract degree-two field with a matching radicand. -/
theorem field_eq_adjoin : field a s=IntermediateField.adjoin F {root a s}:=by
  apply le_antisymm
  · rintro x ⟨z,rfl⟩
    change z.re • (1:Raw a)+z.im • root a s∈IntermediateField.adjoin F {root a s}
    exact add_mem (IntermediateField.smul_mem _ (one_mem _))
      (IntermediateField.smul_mem _ (IntermediateField.subset_adjoin F _ (Set.mem_singleton _)))
  · exact IntermediateField.adjoin_le_iff.mpr (by
      intro x hx
      rcases Set.mem_singleton_iff.mp hx with rfl
      exact root_mem a s)

/-- Membership in the genuine Galois fixing subgroup is exactly the
positive-sign condition on the explicitly parametrized automorphisms. -/
theorem sign_mem_fixing_iff (b:Fin 4→Bool) :
    signEquiv a b∈(field a s).fixingSubgroup↔sign (F:=F) s b=1:=by
  rw [IntermediateField.mem_fixingSubgroup_iff,←sign_fixes_iff a s b]
  constructor
  · intro h
    exact h _ (root_mem a s)
  · intro h x hx
    obtain ⟨z,rfl⟩:=hx
    change signEquiv a b (z.re • (1:Raw a)+z.im • root a s)=_
    simp only [map_add,map_smul,map_one,h]
    rfl

/-- The actual character field is exactly the fixed field of its actual
sign stabilizer, using the established whole degree-sixteen Galois extension. -/
theorem actual_fixed_field : IntermediateField.fixedField (field a s).fixingSubgroup=field a s:=by
  letI:=ActualKummerGalois318.raw_galois a
  letI:FiniteDimensional F (Raw a):=Module.finite_of_finrank_pos
    (by rw [KummerTensorField318.actual_degree];norm_num)
  exact IsGalois.fixedField_fixingSubgroup (field a s)

theorem relative_degree_eight : Module.finrank (field a s) (Raw a)=8:=by
  letI:FiniteDimensional F (Raw a):=Module.finite_of_finrank_pos
    (by rw [KummerTensorField318.actual_degree];norm_num)
  have h:=Module.finrank_mul_finrank F (field a s) (Raw a)
  rw [degree_two,KummerTensorField318.actual_degree] at h
  omega

theorem fixing_subgroup_card : Nat.card (field a s).fixingSubgroup=8:=by
  letI:=ActualKummerGalois318.raw_galois a
  letI:FiniteDimensional F (Raw a):=Module.finite_of_finrank_pos
    (by rw [KummerTensorField318.actual_degree];norm_num)
  rw [IsGalois.card_fixingSubgroup_eq_finrank,relative_degree_eight]
end CharacterQuadraticField318
