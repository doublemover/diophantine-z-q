namespace SelectedBasedSignCodifferent318

section ExactChart
variable {S : Type*} [CommRing S] (J : S)
local notation "D" => XOpen J
local notation "b" => algebraMap S[X] D (linearX J)
local notation "f" => algebraMap S[X] D (cubicX J)

theorem signDiscriminantUnit : IsUnit (discriminant b f) := by
  have h := IsLocalization.Away.algebraMap_isUnit (S:=D)
    (discriminant (linearX J) (cubicX J))
  simpa only [discriminant,map_add,map_pow,map_mul,map_ofNat] using h

/-- THE contracted sign order of the given point ideal on the actual
denominator-free chart, not an abstract ring with matching rank. -/
abbrev ActualSignOrder (I : Ideal (JSignChart J)) := SignOrder b f I
abbrev ActualClosedOrder (I : Ideal (JSignChart J)) := ClosedOrder b f I

theorem actualIdeal_eq [Nontrivial D] (I : Ideal (JSignChart J))
    (stable : ∀ z ∈ I, sign b f z ∈ I) :
    (contraction b f I).map (algebraMap D (JSignChart J)) = I :=
  closedIdeal_eq b f I (signDiscriminantUnit J) stable

/-- The exact x-coordinate in the contracted sign algebra. -/
@[expose] def chosenX (I : Ideal (JSignChart J)) : ActualSignOrder J I :=
  Ideal.Quotient.mk (contraction b f I) (algebraMap S[X] D X)

variable [nd : Nontrivial D] (I : Ideal (JSignChart J))
local notation "A" => ActualSignOrder J I
local notation "P" => ActualClosedOrder J I

/-- Derive the literal M denominator in the true contracted sign
order. The source map comes from the actual full kernel to this
actual closed primitive branch, not a generic field surjection.
actualIdeal_eq identifies the target with the original signed ideal. -/
include nd in
theorem chosenDerivative [Algebra S A] [Algebra S P] [IsScalarTower S A P]
    {T : Type*} [CommRing T] [Algebra S T]
    (χ : T →ₐ[S] P) (surjT : Function.Surjective χ)
    (M : ℕ) (kill : ∀ ω : KaehlerDifferential S T, M • ω = 0)
    (p : S[X]) (hp : aeval (chosenX J I) p = 0)
    (surj : Function.Surjective (aeval (R:=S) (chosenX J I)))
    (kernel : ∀ q : S[X], aeval (chosenX J I) q = 0 → p ∣ q) :
    ∃ w : A, aeval (chosenX J I) p.derivative*w = (M:A) := by
  letI : Algebra T P := χ.toRingHom.toAlgebra
  letI : IsScalarTower S T P := IsScalarTower.of_algHom χ
  letI : Algebra.Etale A P := closedOrder_etale b f I (signDiscriminantUnit J)
  letI : Module.FaithfullyFlat A P := closedOrder_faithfullyFlat b f I
  have hP : ∀ ω : KaehlerDifferential S P, M • ω = 0 :=
    kills_of_integral_quotient surjT M kill
  have hA : ∀ ω : KaehlerDifferential S A, M • ω = 0 :=
    kills_of_etale_cover M hP
  exact specialized_derivative_dvd (RingHom.id A) (aeval (chosenX J I))
    surj p hp kernel M (hA _)

end ExactChart

section Normalization
variable {S : Type*} [CommRing S] [IsDomain S] [IsIntegrallyClosed S] (J : S)
variable [nd : Nontrivial (XOpen J)] (I : Ideal (JSignChart J))
local notation "A" => ActualSignOrder J I
local notation "P" => ActualClosedOrder J I
variable [Algebra S A] [Algebra S P] [IsScalarTower S A P]
variable {K F : Type*} [Field K] [Field F] [Algebra S K] [IsFractionRing S K]
variable [Algebra K F] [Algebra S F] [IsScalarTower S K F]
variable [FiniteDimensional K F] [Algebra.IsSeparable K F]
local notation "B" => integralClosure S F
local notation "C" => normalizedComplementary (R:=S) (F:=F) K

/-- Strongest pre-resolution result for this order: the actual
normalization-linear multiplication map by M sends the codifferent
back into the original monogenic order generated by the named x.
No stable Hodge, minimal-model or special fiber premise enters. -/
include nd in
theorem chosenNormalization
    (stable : ∀ z ∈ I, sign (algebraMap S[X] (XOpen J) (linearX J))
      (algebraMap S[X] (XOpen J) (cubicX J)) z ∈ I)
    {T : Type*} [CommRing T] [Algebra S T]
    (χ : T →ₐ[S] P) (surjT : Function.Surjective χ)
    (M : ℕ) (kill : ∀ ω : KaehlerDifferential S T, M • ω = 0)
    (p : S[X]) (hp : aeval (chosenX J I) p = 0)
    (surj : Function.Surjective (aeval (R:=S) (chosenX J I)))
    (kernel : ∀ q : S[X], aeval (chosenX J I) q = 0 → p ∣ q)
    (φ : A →ₐ[S] F)
    (hx : Algebra.adjoin K ({φ (chosenX J I)} : Set F) = ⊤)
    (hint : IsIntegral S (φ (chosenX J I)))
    (hmin : p.map (algebraMap S K) = minpoly K (φ (chosenX J I))) :
    (contraction (algebraMap S[X] (XOpen J) (linearX J))
      (algebraMap S[X] (XOpen J) (cubicX J)) I).map
      (algebraMap (XOpen J) (JSignChart J)) = I ∧
      ∃ g : C →ₗ[B] B, ∀ z : C, (g z:F) = (M:F)*(z:F) ∧
        (g z:F) ∈ Algebra.adjoin S ({φ (chosenX J I)} : Set F) := by
  refine ⟨actualIdeal_eq J I stable,?_⟩
  obtain ⟨w,hw⟩ := chosenDerivative J I χ surjT M kill p hp surj kernel
  obtain ⟨q,hq⟩ := surj w
  have hwA : φ w ∈ Algebra.adjoin S ({φ (chosenX J I)} : Set F) := by
    rw [Algebra.adjoin_singleton_eq_range_aeval]
    exact ⟨q, (Polynomial.aeval_algHom_apply φ (chosenX J I) q).trans (congrArg φ hq)⟩
  have hwF : aeval (φ (chosenX J I)) p.derivative * φ w = (M:F) := by
    rw [Polynomial.aeval_algHom_apply,← map_mul,hw,map_natCast]
  obtain ⟨g,hg⟩ := literal_dual_functional hx hint p hmin M hwA hwF
  refine ⟨g,fun z => ⟨hg z,?_⟩⟩
  rw [hg]
  exact (actual_normalization_clear hx hint p hmin M hwA hwF (z:F)
    (normalized_mem_complementary _ z.2)).1

end Normalization
end SelectedBasedSignCodifferent318

