module
public import OriginalIntegralBranchPointComparison318
public import IntegralZoomFiberNaturality318
public import OriginalZoomFiberLattice318
public section
noncomputable section
namespace OriginalZoomDifferentialFrameScalar318
open NumberField OriginalPointFinitePlaceRoots318 OriginalAllPlaceNormalizedData318
open scoped TensorProduct
set_option maxHeartbeats 2200000
set_option backward.isDefEq.respectTransparency false
variable (c : Fin 4 → ℚˣ) (t : ℚ)
  (hn : ∀ j,RationalContactPoint318.parameters c t j≠0)
  (w : FinitePlace (K c t)) (D : Data c t w)
  {m : OriginalAllPrimeZoomInput318.Mode} (I : OriginalAllPrimeZoomInput318.Input c t w D m)
abbrev d := IntegralContactZoomBaseChange318.mapped (S:=K c t) D.coefficients
abbrev a := IntegralContactZoomBaseChange318.mapped (S:=K c t) (OriginalAllPrimeIntegralBicanonical318.contacts c t w)
abbrev τ := algebraMap (V c t w) (K c t) I.coordinate
abbrev mode := OriginalAllPrimeIntegralBicanonical318.mode m
abbrev Chart := OriginalAllPrimeIntegralBicanonical318.ChangedChart c t w D I

/-- The ACTUAL differential of the original branch coordinate, expressed
in the actual etale coordinate frame and evaluated at the SAME point. -/
@[expose] def scalar (i : Fin 4) : K c t :=
  IntegralZoomTensorFiber318.frame (d c t w D) (a c t w) (τ c t w D I) (mode (m:=m))
    (KaehlerDifferential.D (K c t) (Chart c t w D I)
      (OriginalAllPrimeIntegralBicanonical318.originalBranchMap c t w D I i
        (ContactFrameNormalization318.sourceCoordinate c i)))

theorem unscaled_fiber (i : Fin 4) :
    algebraMap (V c t w) (K c t)
      (IntegralZoomPointCoefficient318.fiber0 I.coordinate D.coefficients
        (OriginalAllPrimeIntegralBicanonical318.contacts c t w) (mode (m:=m)))=
      ContactBranchPoint318.branchPoint c t hn i (ContactBicanonicalCoefficients318.branchQ0 c i)*
        (scalar c t w D I i)^2 := by
  have h := congrArg (IntegralZoomTensorFiber318.tensorFiber (d c t w D) (a c t w)
    (τ c t w D I) (mode (m:=m))) (OriginalAllPrimeIntegralBicanonical318.original_q0 c t w D I i)
  rw [OriginalAllPrimeIntegralBicanonical318.genericSection0,
    IntegralContactZoomTensorBaseChange318.genericSection0_eq D.coefficients
      (OriginalAllPrimeIntegralBicanonical318.contacts c t w) I.coordinate (mode (m:=m)) I.root
      (OriginalAllPrimeIntegralBicanonical318.integral_root_equation c t w D I)
      (OriginalAllPrimeIntegralBicanonical318.field_root_ne c t w D I),
    IntegralZoomTensorFiber318.tensorFiber_section0] at h
  rw [ContactBicanonicalGenericPullback318.branchImage,LinearMap.map_smulₛₗ,
    IntegralZoomTensorFiber318.tensorFiber_tmul,smul_eq_mul] at h
  have hp := RingHom.congr_fun
    (OriginalIntegralBranchPointComparison318.whole_original_branch_point c t hn w D I i)
    (ContactBicanonicalCoefficients318.branchQ0 c i)
  change IntegralZoomTensorFiber318.point (d c t w D) (a c t w) (τ c t w D I) (mode (m:=m))
    (OriginalAllPrimeIntegralBicanonical318.originalBranchMap c t w D I i
      (ContactBicanonicalCoefficients318.branchQ0 c i))=_ at hp
  rw [hp] at h
  rw [IntegralZoomFiberNaturality318.fiber0_map]
  simpa only [scalar,pow_two] using h

theorem scaled_fiber (i : Fin 4) :
    algebraMap (V c t w) (K c t) (OriginalZoomIntegralFiber318.b0 c t w D I)=
      ContactBicanonicalPointHeight318.a0 c t hn i*(scalar c t w D I i)^2 := by
  rw [OriginalZoomIntegralFiber318.b0,map_mul,map_pow,map_natCast,unscaled_fiber c t hn w D I i]
  have ha : ContactBicanonicalPointHeight318.a0 c t hn i=
      (ContactScaledBicanonicalPoint318.J : K c t)^2*
        ContactBranchPoint318.branchPoint c t hn i (ContactBicanonicalCoefficients318.branchQ0 c i) := by
    rw [ContactBicanonicalPointHeight318.a0,ContactScaledBicanonicalPoint318.scaledQ0,
      ContactScaledBicanonicalPoint318.value_nsmul,ContactBicanonicalPointValue318.value_q0,
      nsmul_eq_mul,Nat.cast_pow]
  rw [ha]
  ring

include hn in
theorem scalar_ne (i : Fin 4) : scalar c t w D I i≠0 := by
  intro h
  apply OriginalZoomIntegralFiber318.field_b0_ne c t w D I
  rw [scaled_fiber c t hn w D I i,h,zero_pow (by decide),mul_zero]

/-- The local lattice generator previously constructed from the genuine
section fibers is the INVERSE SQUARE OF THE ACTUAL DIFFERENTIAL FRAME
SCALAR. This proves geometric frame compatibility, not merely a matching
section ratio. It still does not identify a global arithmetic Hodge line. -/
theorem generator_eq_inverse_square (i : Fin 4) :
    OriginalZoomFiberLattice318.generator c t hn i w D I=(scalar c t w D I i)⁻¹^2 := by
  rw [OriginalZoomFiberLattice318.generator,scaled_fiber c t hn w D I i]
  field_simp [ContactBicanonicalPointHeight318.a0_ne c t hn i,scalar_ne c t hn w D I i]

/-- The embedded integral lattice is exactly the lattice generated by the
inverse-square actual branch-to-zoom differential change, with all scalar
and original-point maps fixed above. -/
theorem lattice_eq_differential (i : Fin 4) :
    FinitePlacePrincipalLattice318.lattice w (OriginalZoomFiberLattice318.generator c t hn i w D I)=
      FinitePlacePrincipalLattice318.lattice w ((scalar c t w D I i)⁻¹^2) := by
  rw [generator_eq_inverse_square c t hn w D I i]
end OriginalZoomDifferentialFrameScalar318
