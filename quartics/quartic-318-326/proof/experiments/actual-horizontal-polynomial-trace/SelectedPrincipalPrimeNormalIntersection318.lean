module
public import Mathlib.RingTheory.Localization.NumDen
public import Mathlib.RingTheory.Spectrum.Prime.Defs
public import Mathlib.FieldTheory.Minpoly.IsIntegrallyClosed
public import Mathlib.Algebra.Polynomial.Lifts
public section
noncomputable section

open Polynomial
open scoped nonZeroDivisors

namespace SelectedPrincipalPrimeNormalIntersection318

variable {A K : Type*} [CommRing A] [IsDomain A] [Field K]
variable [Algebra A K] [IsFractionRing A K]

abbrev localRing (q : PrimeSpectrum A) := Localization.AtPrime q.asIdeal

/-- The prime localization maps into this very same coefficient field. -/
@[expose] def localAlgebra (q : PrimeSpectrum A) : Algebra (localRing q) K :=
  IsLocalization.localizationAlgebraOfSubmonoidLe (localRing q) K
    q.asIdeal.primeCompl A⁰ q.asIdeal.primeCompl_le_nonZeroDivisors

attribute [local instance] localAlgebra

instance localized_tower (q : PrimeSpectrum A) : IsScalarTower A (localRing q) K :=
  IsLocalization.localization_isScalarTower_of_submonoid_le (localRing q) K
    q.asIdeal.primeCompl A⁰ q.asIdeal.primeCompl_le_nonZeroDivisors

instance localized_fraction (q : PrimeSpectrum A) : IsFractionRing (localRing q) K :=
  IsFractionRing.isFractionRing_of_isDomain_of_isLocalization q.asIdeal.primeCompl _ _

/-- Use true prime ideals generated by irreducibles. In a UFD each of
these is height one and they detect every reduced denominator. -/
def principalPrime (q : PrimeSpectrum A) : Prop :=
  ∃ a : A, Irreducible a ∧ q.asIdeal = Ideal.span ({a} : Set A)

/-- The intersection of the actual principal prime localizations
inside K is the image of A. A nonunit denominator would have a prime
factor dividing the numerator, contradicting reducedness. -/
theorem integer_of_local [UniqueFactorizationMonoid A] (z : K)
    (hz : ∀ q : PrimeSpectrum A, principalPrime q →
      z ∈ Set.range (algebraMap (localRing q) K)) :
    z ∈ Set.range (algebraMap A K) := by
  apply (IsFractionRing.isUnit_den_iff (A:=A) z).1
  by_contra h
  let d : A := IsFractionRing.den A z
  let n : A := IsFractionRing.num A z
  have hd : d≠0 := mem_nonZeroDivisors_iff_ne_zero.mp (IsFractionRing.den A z).2
  obtain ⟨p,hp,hpd⟩ := WfDvdMonoid.exists_irreducible_factor h hd
  have hp' : Prime p := UniqueFactorizationMonoid.irreducible_iff_prime.mp hp
  let q : PrimeSpectrum A := ⟨Ideal.span ({p}:Set A),Ideal.isPrime_span_singleton_of_prime hp'⟩
  obtain ⟨y,hy⟩ := hz q ⟨p,hp,rfl⟩
  obtain ⟨a,s,hs⟩ := IsLocalization.exists_mk'_eq q.asIdeal.primeCompl y
  have hy' : y * algebraMap A (localRing q) (s:A) = algebraMap A (localRing q) a := by
    rw [←hs]
    exact IsLocalization.mk'_spec (localRing q) a s
  have hz' : z * algebraMap A K (s:A) = algebraMap A K a := by
    have hh := congrArg (algebraMap (localRing q) K) hy'
    simpa only [map_mul,hy,←IsScalarTower.algebraMap_apply A (localRing q) K] using hh
  have hn : z * algebraMap A K d = algebraMap A K n :=
    IsFractionRing.num_mul_den_eq_num_iff_eq.mpr rfl
  have hmul : n * (s:A) = a*d := by
    apply IsFractionRing.injective A K
    rw [map_mul,map_mul,←hn,←hz']
    ac_rfl
  have ha : p ∣ n := by
    have hprod : p ∣ n*(s:A) := by
      rw [hmul]
      exact dvd_mul_of_dvd_right hpd a
    have hns : ¬ p ∣ (s:A) := fun hs' => s.2 (Ideal.mem_span_singleton.mpr hs')
    exact (hp'.2.2 _ _ hprod).resolve_right hns
  exact hp.not_isUnit ((IsFractionRing.num_den_reduced A z) ha hpd)

variable {F : Type*} [CommRing F] [IsDomain F] [Algebra K F]
variable [Algebra A F] [IsScalarTower A K F]

/-- An element of the fixed general function field which is integral
at every actual principal prime is integral on the whole normal
affine base. The monic polynomial is recovered coefficientwise from
one global minimal polynomial in K[T], not by choosing local roots or
enlarging the field. -/
theorem integral_of_local [UniqueFactorizationMonoid A] [IsIntegrallyClosed A]
    (x : F) (hx : IsIntegral K x)
    (hlocal : ∀ q : PrimeSpectrum A, principalPrime q →
      letI : Algebra (localRing q) F := Algebra.compHom F (algebraMap (localRing q) K)
      IsIntegral (localRing q) x) : IsIntegral A x := by
  have hc (i : ℕ) : (minpoly K x).coeff i ∈ Set.range (algebraMap A K) := by
    apply integer_of_local
    intro q hq
    letI : Algebra (localRing q) F := Algebra.compHom F (algebraMap (localRing q) K)
    letI : IsScalarTower (localRing q) K F := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    letI : IsIntegrallyClosed (localRing q) :=
      isIntegrallyClosed_of_isLocalization (localRing q) q.asIdeal.primeCompl
        q.asIdeal.primeCompl_le_nonZeroDivisors
    have hqx : IsIntegral (localRing q) x := hlocal q hq
    have he := minpoly.isIntegrallyClosed_eq_field_fractions' K hqx
    exact ⟨(minpoly (localRing q) x).coeff i, by rw [he,Polynomial.coeff_map]⟩
  obtain ⟨f,hf⟩ := (Polynomial.mem_lifts (minpoly K x)).mp
    ((Polynomial.lifts_iff_coeff_lifts (minpoly K x)).mpr hc)
  refine ⟨f,Polynomial.monic_of_injective (IsFractionRing.injective A K) (hf.symm ▸ minpoly.monic hx),?_⟩
  have he : aeval x (f.map (algebraMap A K)) = 0 := by
    rw [hf]
    exact minpoly.aeval K x
  rw [aeval_map_algebraMap] at he
  exact he

end SelectedPrincipalPrimeNormalIntersection318

#print axioms SelectedPrincipalPrimeNormalIntersection318.integer_of_local
#print axioms SelectedPrincipalPrimeNormalIntersection318.integral_of_local
