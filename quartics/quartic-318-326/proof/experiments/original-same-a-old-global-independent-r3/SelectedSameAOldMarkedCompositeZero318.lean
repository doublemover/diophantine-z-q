module

public import IntrinsicDifferentialFunctor318
public import Mathlib.Algebra.Homology.ShortComplex.Basic

/-!
# The two original cotangent arrows compose to zero at the actual mark

The proof takes the iterated adjoint of the actual pullback arrows and uses the
literal factorization through the original residue point. It uses neither the
directional cotangent row nor an exactness theorem for either row.
-/

public section
noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace

namespace SelectedSameAOldMarkedCompositeZero318

universe u
set_option maxHeartbeats 700000
set_option backward.isDefEq.respectTransparency.types false
set_option backward.isDefEq.respectTransparency false

local notation "Ω" => FamilyIntrinsicDifferentials318.omega
local notation "PB" => IntrinsicDifferentialPullback318.pullbackMap

variable {k : Type u} [Field k]

/-- On the one-point residue scheme every section is a coefficient, including
on the empty open. This uses the actual structure sheaf of the spectrum. -/
private theorem residue_coefficients_surjective
    (U : (Spec (CommRingCat.of k)).Opens) :
    Function.Surjective ((FamilyIntrinsicDifferentials318.coefficients
      (𝟙 (Spec (CommRingCat.of k)))).app (op U)) := by
  let X := Spec (CommRingCat.of k)
  by_cases h : ∃ x : X, x ∈ U
  · obtain ⟨x, hx⟩ := h
    have hU : U = ⊤ := by
      apply top_le_iff.mp
      intro y _
      have he : y = x := Subsingleton.elim (α := PrimeSpectrum k) y x
      exact he.symm ▸ hx
    subst U
    intro s
    refine ⟨(Scheme.ΓSpecIso (CommRingCat.of k)).hom s, ?_⟩
    have hTop : (homOfLE (show (⊤ : X.Opens) ≤ ⊤ from le_top)).op =
        𝟙 (op (⊤ : X.Opens)) := Subsingleton.elim _ _
    change (((Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ (𝟙 X).appTop) ≫
      X.presheaf.map (homOfLE (show (⊤ : X.Opens) ≤ ⊤ from le_top)).op)
        ((Scheme.ΓSpecIso (CommRingCat.of k)).hom s) = s
    rw [Scheme.Hom.id_appTop, Category.comp_id, hTop, Functor.map_id,
      Category.comp_id]
    exact congrArg (fun f : Γ(X, ⊤) ⟶ Γ(X, ⊤) => f s)
      (Scheme.ΓSpecIso (CommRingCat.of k)).hom_inv_id
  · intro s
    refine ⟨0, ?_⟩
    change (_ : (structureSheafInType k k).1.obj (op U)) = s
    exact Subtype.ext (funext fun t => (h ⟨t.1, t.2⟩).elim)

/-- Any map out of the actual residue scheme has zero pulled differential
over that same field: Ω(Spec k/Spec k) is generated by relative differentials
of coefficients, all of which vanish. -/
private theorem mark_map_zero {S : Scheme.{u}} (b : S ⟶ Spec (CommRingCat.of k))
    (m : Spec (CommRingCat.of k) ⟶ S) (hm : m ≫ b = 𝟙 _) :
    IntrinsicDifferentialPullback318.map m (𝟙 _) b hm = 0 := by
  apply UniversalSheafDifferentials318.hom_ext
    (FamilyIntrinsicDifferentials318.coefficients b)
  ext U r
  obtain ⟨c, hc⟩ := residue_coefficients_surjective (m ⁻¹ᵁ U.unop) (m.app U.unop r)
  have hd := (FamilyIntrinsicDifferentials318.D (𝟙 (Spec (CommRingCat.of k)))).d_app
    (X := op (m ⁻¹ᵁ U.unop)) c
  change (IntrinsicDifferentialPullback318.map m (𝟙 _) b hm).val.app (op U.unop)
    ((FamilyIntrinsicDifferentials318.D b).d r) = 0
  rw [IntrinsicDifferentialPullback318.map_D, ← hc]
  exact hd

private theorem map_zero_of_equal {A S : Scheme.{u}}
    (a : A ⟶ Spec (CommRingCat.of k)) (b : S ⟶ Spec (CommRingCat.of k))
    {f g : A ⟶ S} (h : f = g) (hf : f ≫ b = a) (hg : g ≫ b = a)
    (hz : IntrinsicDifferentialPullback318.map g a b hg = 0) :
    IntrinsicDifferentialPullback318.map f a b hf = 0 := by
  subst g
  exact hz

private theorem adjoint_zero {A P : Scheme.{u}} (i : A ⟶ P)
    (M : P.Modules) (N : A.Modules) :
    (Scheme.Modules.pullbackPushforwardAdjunction i).homEquiv M N 0 = 0 := by
  rw [Adjunction.homEquiv_unit, Functor.map_zero, comp_zero]

private theorem mark_over_field {T : Type u} [CommRing T] [Algebra k T]
    (x : T →ₐ[k] k) :
    Spec.map (CommRingCat.ofHom x.toRingHom) ≫ Spec.algebraMap k T =
      𝟙 (Spec (CommRingCat.of k)) := by
  have hx : CommRingCat.ofHom (algebraMap k T) ≫
      CommRingCat.ofHom x.toRingHom = 𝟙 (CommRingCat.of k) :=
    CommRingCat.hom_ext (RingHom.ext fun c => x.commutes c)
  change Spec.map (CommRingCat.ofHom x.toRingHom) ≫
    Spec.map (CommRingCat.ofHom (algebraMap k T)) = 𝟙 _
  rw [← Spec.map_comp, hx, Spec.map_id]

/-- The original right map uses the given reduced base map itself, not
a reselected field map. This is the literal structure triangle. -/
theorem old_marked_over_field {A P : Scheme.{u}} {T : Type u} [CommRing T] [Algebra k T]
    (p : P ⟶ Spec (CommRingCat.of T)) (i : A ⟶ P)
    (a : A ⟶ Spec (CommRingCat.of k)) (x : T →ₐ[k] k)
    (hMarked : i ≫ p = a ≫ Spec.map (CommRingCat.ofHom x.toRingHom)) :
    i ≫ (p ≫ Spec.algebraMap k T) = a := by
  rw [← Category.assoc, hMarked, Category.assoc, mark_over_field x, Category.comp_id]

/-- Exact original arrows: the reduced inclusion i has its actual base map a,
and its composite with the old p is the original mark Spec(x) after a. -/
theorem old_composite_zero {A P : Scheme.{u}} {T : Type u} [CommRing T] [Algebra k T]
    (p : P ⟶ Spec (CommRingCat.of T)) (i : A ⟶ P)
    (a : A ⟶ Spec (CommRingCat.of k)) (x : T →ₐ[k] k)
    (hMarked : i ≫ p = a ≫ Spec.map (CommRingCat.ofHom x.toRingHom)) :
    (Scheme.Modules.pullback i).map
        (PB p (p ≫ Spec.algebraMap k T) (Spec.algebraMap k T) rfl) ≫
      PB i a (p ≫ Spec.algebraMap k T)
        (old_marked_over_field p i a x hMarked) = 0 := by
  let b : Spec (CommRingCat.of T) ⟶ Spec (CommRingCat.of k) := Spec.algebraMap k T
  let m : Spec (CommRingCat.of k) ⟶ Spec (CommRingCat.of T) :=
    Spec.map (CommRingCat.ofHom x.toRingHom)
  have hm : m ≫ b = 𝟙 _ := mark_over_field x
  have hh : (a ≫ m) ≫ b = a := by rw [Category.assoc, hm, Category.comp_id]
  have hi : i ≫ (p ≫ b) = a := old_marked_over_field p i a x hMarked
  have hb : (i ≫ p) ≫ b = a := (Category.assoc i p b).trans hi
  have hz₀ : IntrinsicDifferentialPullback318.map (a ≫ m) a b hh = 0 := by
    rw [IntrinsicDifferentialFunctor318.map_comp a m a (𝟙 _) b
      (Category.comp_id a) hm hh, mark_map_zero b m hm, zero_comp]
  have hz := map_zero_of_equal a b hMarked hb hh hz₀
  change (Scheme.Modules.pullback i).map (PB p (p ≫ b) b rfl) ≫
    PB i a (p ≫ b) hi = 0
  apply ((Scheme.Modules.pullbackPushforwardAdjunction i).homEquiv _ _).injective
  rw [Adjunction.homEquiv_naturality_left, IntrinsicDifferentialPullback318.pullbackMap_adjoint,
    adjoint_zero]
  apply ((Scheme.Modules.pullbackPushforwardAdjunction p).homEquiv _ _).injective
  rw [Adjunction.homEquiv_naturality_right, IntrinsicDifferentialPullback318.pullbackMap_adjoint,
    adjoint_zero]
  have he := IntrinsicDifferentialFunctor318.map_comp i p a (p ≫ b) b hi rfl hb
  rw [hz] at he
  apply (cancel_mono ((Scheme.Modules.pushforwardComp i p).hom.app (Ω a))).mp
  rw [Category.assoc, zero_comp]
  exact he.symm

/-- The direct original complex, with exactly i*dp and di as its maps.
The only geometric input here is the marked composite identity. -/
@[expose] def oldDirect {A P : Scheme.{u}} {T : Type u} [CommRing T] [Algebra k T]
    (p : P ⟶ Spec (CommRingCat.of T)) (i : A ⟶ P)
    (a : A ⟶ Spec (CommRingCat.of k)) (x : T →ₐ[k] k)
    (hMarked : i ≫ p = a ≫ Spec.map (CommRingCat.ofHom x.toRingHom)) :
    ShortComplex A.Modules :=
  ShortComplex.mk _ _ (old_composite_zero p i a x hMarked)

end SelectedSameAOldMarkedCompositeZero318
