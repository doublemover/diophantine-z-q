module
public import OriginalExcludedPlaceData318
public import FinitePlaceTwoSectionLattice318
public section
noncomputable section
namespace OriginalMinimalExcludedSections318
open NumberField OriginalPointFinitePlaceRoots318 OriginalExcludedPlaceData318
open FinitePlacePrincipalLattice318 FinitePlaceTwoSectionLattice318
variable (c : Fin 4 → ℚˣ) (t : ℚ)
  (hn : ∀ j, RationalContactPoint318.parameters c t j ≠ 0) (i : Fin 4)

/-- Construct the previously explicit excluded-place section containment
record using the actual two evaluated sections. This proves that record's
existence only: geometric cotangent provenance and KS remain separate. -/
@[expose] def minimalGenerators : ExcludedGenerators c t hn i where
  generator b := FinitePlaceTwoSectionLattice318.generator b.val
    (ContactBicanonicalPointHeight318.a0 c t hn i)
    (ContactBicanonicalPointHeight318.a1 c t hn i)
  nonzero b := FinitePlaceTwoSectionLattice318.generator_ne b.val _ _
    (ContactBicanonicalPointHeight318.a0_ne c t hn i)
  original_mem b n := by
    fin_cases n
    · exact FinitePlaceTwoSectionLattice318.left_mem b.val _ _
        (ContactBicanonicalPointHeight318.a0_ne c t hn i)
    · exact FinitePlaceTwoSectionLattice318.right_mem b.val _ _
        (ContactBicanonicalPointHeight318.a0_ne c t hn i)

theorem exists_generators : Nonempty (ExcludedGenerators c t hn i) :=
  ⟨minimalGenerators c t hn i⟩

/-- Every other admissible excluded lattice contains this one. Thus replacing
it by an actual geometric lattice is a genuine additional comparison, not
something that follows from both objects merely having rank one. -/
theorem contained_in (B : ExcludedGenerators c t hn i) (b : BadPlace c t) :
    lattice b.val ((minimalGenerators c t hn i).generator b) ≤
      lattice b.val (B.generator b) := by
  apply FinitePlaceTwoSectionLattice318.minimal
  · exact B.original_mem b 0
  · exact B.original_mem b 1

/-- Any actual cotangent lattice generated by these two original values
must equal the constructed lattice. Generation, unlike mere containment,
is the remaining geometric assertion at an excluded place. -/
theorem equal_of_generated (b : BadPlace c t)
    (M : Submodule (ActualFinitePlaceIntegers318.Integers b.val) (K c t))
    (hM : M = Submodule.span (ActualFinitePlaceIntegers318.Integers b.val)
      ({ContactBicanonicalPointHeight318.a0 c t hn i,
        ContactBicanonicalPointHeight318.a1 c t hn i} : Set (K c t))) :
    lattice b.val ((minimalGenerators c t hn i).generator b) = M := by
  rw [hM]
  exact FinitePlaceTwoSectionLattice318.eq_span b.val _ _
    (ContactBicanonicalPointHeight318.a0_ne c t hn i)
/-- The original branch-frame change transports the constructed excluded
lattice by exactly its existing field scalar. All excluded places, including
places where this scalar is nonunit, are retained. -/
theorem frame_change (j : Fin 4) (b : BadPlace c t) :
    lattice b.val ((minimalGenerators c t hn j).generator b) =
      (lattice b.val ((minimalGenerators c t hn i).generator b)).map
        (FinitePlacePrincipalImage318.scalarMap b.val
          (ContactBicanonicalPointHeight318.frameScalar c t hn i j)) := by
  change FinitePlaceTwoSectionLattice318.sectionLattice b.val
      (ContactBicanonicalPointHeight318.a0 c t hn j)
      (ContactBicanonicalPointHeight318.a1 c t hn j) = _
  rw [ContactBicanonicalPointHeight318.frameScalar_a0 c t hn i j,
    ContactBicanonicalPointHeight318.frameScalar_a1 c t hn i j]
  exact FinitePlaceTwoSectionLattice318.lattice_scale b.val _ _ _
    (ContactBicanonicalPointHeight318.frameScalar_ne c t hn i j)
end OriginalMinimalExcludedSections318
