      + (-2*D*b*x^7)
      + (-2*D*a^4*y^3)
      + (-2*a^2*b*x^7)
      + (-2*a^4*b*x^5)
      + (-2*a^5*x^4*y)
      + (-2*D^2*x^2*y^3)
      + (-2*a^4*x^2*y^3)
      + (2*D^4*a*y)
      + (4*D*a^7*y)
      + (4*D^2*b*x^5)
      + (4*a^3*b*x^6)
      + (4*a^7*x^2*y)
      + (6*D^4*a*b)
      + (6*D^3*b*x^3)
      + (8*D*a^7*b)
      + (8*a^7*b*x^2)
      + (8*D^3*a^3*y)
      + (12*D^2*a^2*y^3)
      + (12*a^2*b^3*x^4)
      + (16*D^3*a^3*b)
      + (16*D^2*b^3*x^2)
      + (32*D*a*b^5)
      + (60*D^2*a^2*b^3)
      + (-96*D*b^4*x*y)
      + (-96*D*b^3*x*y^2)
      + (-96*D^2*a*b^3*x)
      + (-94*D^2*a^2*b*x^3)
      + (-76*D*a^4*b^2*y)
      + (-66*D^3*a^2*b*x)
      + (-64*D*a*b^3*x^3)
      + (-36*D^2*a^2*x^3*y)
      + (-32*D*b^2*x*y^3)
      + (-28*D^2*b^2*x^2*y)
      + (-26*D^2*a*b*x^4)
      + (-24*D*a^5*x^2*y)
      + (-20*D*a^5*b*x^2)
      + (-20*D^2*b*x^2*y^2)
      + (-20*D^3*a^2*x*y)
      + (-16*D*a^2*x^5*y)
      + (-12*a^4*b^2*x^2*y)
      + (-8*D*a^6*b*x)
      + (-8*D*a^4*b*y^2)
      + (-8*a^4*b*x^2*y^2)
      + (-4*D*a^6*x*y)
      + (-2*D^2*a*x^4*y)
      + (2*D*a^2*b*x^5)
      + (2*D*b*x^4*y^2)
      + (2*a^2*b*x^4*y^2)
      + (4*D*a*b*x^6)
      + (8*D*b^2*x^4*y)
      + (8*D^3*a*b*x^2)
      + (8*a^2*b^2*x^4*y)
      + (12*D*a^2*x^2*y^3)
      + (20*D*a^4*b*x^3)
      + (24*D*a^4*x^3*y)
      + (24*D^2*a^4*x*y)
      + (28*D*a^3*x^4*y)
      + (32*D*a*b^2*y^3)
      + (32*D*a^3*b*x^4)
      + (32*D*a^3*b^3*x)
      + (36*D^2*a^3*x^2*y)
      + (50*D^2*a^2*b*y^2)
      + (54*D^2*a^4*b*x)
      + (72*D*a^2*b^3*x^2)
      + (80*D^2*a^2*b^2*y)
      + (96*D*a*b^4*y)
      + (96*D*a*b^3*y^2)
