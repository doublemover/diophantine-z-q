      + (10*D^2*a*x^4*y)
      + (10*D^2*a^4*b*x)
      + (16*D*a^5*b*x^2)
      + (20*D^2*a^2*b^2*y)
      + (30*D^2*a^3*x^2*y)
      + (32*D*a*b^3*x^3)
      + (36*D^2*a^3*b*x^2)
      + (44*D*a^3*x^4*y)
      + (46*D^2*b^2*x^2*y)
      + (84*D*a^2*b*x^5)
      + (84*D^3*a*b*x^2)
      + (-96*D^2*a*b^2*x*y)
      + (-36*D*a^2*b^2*x^2*y)
      + (96*D*a*b^2*x^3*y))*hd

end CoherentSecantPolynomial318
