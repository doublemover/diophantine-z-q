module
public import ScalarActualInputs318
public section
noncomputable section
namespace ScalarCompleteSource318
open CircuitReplay Raw318FinalReplay NormalizedPolePoints318
set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-- The final independent ternary norm representation. It is not inferred
from real positivity; the required semilocal/arithmetic producer is separate. -/
structure Anchor (S a b : ℚ) where
  x : ℚ
  y : ℚ
  z : ℚ
  equation : x^2+6*y^2-2*z^2=3*(4096*a*S+b)^2-2*S^2

@[expose] def finish (S : ℚ) (w : Assignment) (C : Certificate (w 314))
    (A : Anchor S (w 145) (w 308)) : Assignment := fun i =>
  if i=51 then C.e else if i=52 then C.s else if i=53 then C.p else if i=54 then C.q else
  if i=55 then A.x else if i=56 then A.y else if i=57 then A.z else
  if i=315 then C.e*w 314 else if i=316 then C.s^2 else
  if i=317 then -((C.s^2-C.e*(17-w 314))*(C.s^2+3*(C.e*(17-w 314))))/3 else w i

lemma scalar_pole_rows (S : ℚ) (w : Assignment) (C : Certificate (w 314))
    (A : Anchor S (w 145) (w 308)) :
    Constraints [r282 S,r283 S,r284 S,r285 S,r286 S,r287 S] (finish S w C A) := by
  simp only [Constraints,List.mem_cons,List.not_mem_nil,or_false,forall_eq_or_imp]
  refine ⟨?_,?_,?_,?_,?_,?_⟩
  · norm_num [r282,finish] <;> ring
  · norm_num [r283,finish] <;> ring
  · norm_num [r284,finish] <;> ring
  · norm_num [r285,finish]
    linear_combination C.first
  · norm_num [r286,finish]
    linear_combination C.second
  · norm_num [r287,finish]
    linear_combination A.equation

/-- Full literal source completion. Every scalar gate is constructed; only
actual rational twist points (via Certificate) and the final ternary norm
representation are additional mathematical inputs. -/
theorem full_rows (S : ℚ) (w : Assignment) (n : ℤ)
    (hw : Constraints ((stage0 S).take 263) w)
    (h0 : n≠0) (h1 : n≠1) (hq : w 118=(w 0)^2)
    (hroot : ConcreteG8Domain.pair (w 82) (w 83)=CoherentMultipleCharts318.fixedRoot n)
    (hr : ScalarForwardWitness318.inputR (w 0)≠0) (hH : w 37≠0)
    (ha : 1+114444*ScalarForwardWitness318.inputR (w 0)≠0)
    (C : Certificate (ScalarForwardWitness318.poleInput w n))
    (A : Anchor S (w 145) (ActualScalarRoot318.inverseNorm n)) :
    Constraints (stage0 S) (finish S (ScalarForwardWitness318.fill w n) C A) := by
  have hs := ScalarForwardWitness318.scalar_rows S w n h0 h1 hq hroot hr hH ha
  have hp := scalar_pole_rows S (ScalarForwardWitness318.fill w n) C A
  have hw' : Constraints ((stage0 S).take 263) (finish S (ScalarForwardWitness318.fill w n) C A) := by
    change Constraints [r0 S,r1 S,r2 S,r3 S,r4 S,r5 S,r6 S,r7 S,r8 S,r9 S,r10 S,r11 S,r12 S,r13 S,r14 S,r15 S,r16 S,r17 S,r18 S,r19 S,r20 S,r21 S,r22 S,r23 S,r24 S,r25 S,r26 S,r27 S,r28 S,r29 S,r30 S,r31 S,r32 S,r33 S,r34 S,r35 S,r36 S,r37 S,r38 S,r39 S,r40 S,r41 S,r42 S,r43 S,r44 S,r45 S,r46 S,r47 S,r48 S,r49 S,r50 S,r51 S,r52 S,r53 S,r54 S,r55 S,r56 S,r57 S,r58 S,r59 S,r60 S,r61 S,r62 S,r63 S,r64 S,r65 S,r66 S,r67 S,r68 S,r69 S,r70 S,r71 S,r72 S,r73 S,r74 S,r75 S,r76 S,r77 S,r78 S,r79 S,r80 S,r81 S,r82 S,r83 S,r84 S,r85 S,r86 S,r87 S,r88 S,r89 S,r90 S,r91 S,r92 S,r93 S,r94 S,r95 S,r96 S,r97 S,r98 S,r99 S,r100 S,r101 S,r102 S,r103 S,r104 S,r105 S,r106 S,r107 S,r108 S,r109 S,r110 S,r111 S,r112 S,r113 S,r114 S,r115 S,r116 S,r117 S,r118 S,r119 S,r120 S,r121 S,r122 S,r123 S,r124 S,r125 S,r126 S,r127 S,r128 S,r129 S,r130 S,r131 S,r132 S,r133 S,r134 S,r135 S,r136 S,r137 S,r138 S,r139 S,r140 S,r141 S,r142 S,r143 S,r144 S,r145 S,r146 S,r147 S,r148 S,r149 S,r150 S,r151 S,r152 S,r153 S,r154 S,r155 S,r156 S,r157 S,r158 S,r159 S,r160 S,r161 S,r162 S,r163 S,r164 S,r165 S,r166 S,r167 S,r168 S,r169 S,r170 S,r171 S,r172 S,r173 S,r174 S,r175 S,r176 S,r177 S,r178 S,r179 S,r180 S,r181 S,r182 S,r183 S,r184 S,r185 S,r186 S,r187 S,r188 S,r189 S,r190 S,r191 S,r192 S,r193 S,r194 S,r195 S,r196 S,r197 S,r198 S,r199 S,r200 S,r201 S,r202 S,r203 S,r204 S,r205 S,r206 S,r207 S,r208 S,r209 S,r210 S,r211 S,r212 S,r213 S,r214 S,r215 S,r216 S,r217 S,r218 S,r219 S,r220 S,r221 S,r222 S,r223 S,r224 S,r225 S,r226 S,r227 S,r228 S,r229 S,r230 S,r231 S,r232 S,r233 S,r234 S,r235 S,r236 S,r237 S,r238 S,r239 S,r240 S,r241 S,r242 S,r243 S,r244 S,r245 S,r246 S,r247 S,r248 S,r249 S,r250 S,r251 S,r252 S,r253 S,r254 S,r255 S,r256 S,r257 S,r258 S,r259 S,r260 S,r261 S,r262 S] _ at hw ⊢
    simp only [Constraints,List.mem_cons,List.not_mem_nil,or_false,forall_eq_or_imp] at hw ⊢
    simpa [r0,r1,r2,r3,r4,r5,r6,r7,r8,r9,r10,r11,r12,r13,r14,r15,r16,r17,r18,r19,r20,r21,r22,r23,r24,r25,r26,r27,r28,r29,r30,r31,r32,r33,r34,r35,r36,r37,r38,r39,r40,r41,r42,r43,r44,r45,r46,r47,r48,r49,r50,r51,r52,r53,r54,r55,r56,r57,r58,r59,r60,r61,r62,r63,r64,r65,r66,r67,r68,r69,r70,r71,r72,r73,r74,r75,r76,r77,r78,r79,r80,r81,r82,r83,r84,r85,r86,r87,r88,r89,r90,r91,r92,r93,r94,r95,r96,r97,r98,r99,r100,r101,r102,r103,r104,r105,r106,r107,r108,r109,r110,r111,r112,r113,r114,r115,r116,r117,r118,r119,r120,r121,r122,r123,r124,r125,r126,r127,r128,r129,r130,r131,r132,r133,r134,r135,r136,r137,r138,r139,r140,r141,r142,r143,r144,r145,r146,r147,r148,r149,r150,r151,r152,r153,r154,r155,r156,r157,r158,r159,r160,r161,r162,r163,r164,r165,r166,r167,r168,r169,r170,r171,r172,r173,r174,r175,r176,r177,r178,r179,r180,r181,r182,r183,r184,r185,r186,r187,r188,r189,r190,r191,r192,r193,r194,r195,r196,r197,r198,r199,r200,r201,r202,r203,r204,r205,r206,r207,r208,r209,r210,r211,r212,r213,r214,r215,r216,r217,r218,r219,r220,r221,r222,r223,r224,r225,r226,r227,r228,r229,r230,r231,r232,r233,r234,r235,r236,r237,r238,r239,r240,r241,r242,r243,r244,r245,r246,r247,r248,r249,r250,r251,r252,r253,r254,r255,r256,r257,r258,r259,r260,r261,r262,finish,ScalarForwardWitness318.fill] using hw
  have hs' : Constraints [r263 S,r264 S,r265 S,r266 S,r267 S,r268 S,r269 S,r270 S,r271 S,r272 S,r273 S,r274 S,r275 S,r276 S,r277 S,r278 S,r279 S,r280 S,r281 S]
      (finish S (ScalarForwardWitness318.fill w n) C A) := by
    simp only [Constraints,List.mem_cons,List.not_mem_nil,or_false,forall_eq_or_imp] at hs ⊢
    simpa [r263,r264,r265,r266,r267,r268,r269,r270,r271,r272,r273,r274,r275,r276,r277,r278,r279,r280,r281,finish] using hs
