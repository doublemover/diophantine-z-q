module
public import FourRootActualGenericSigns318
public import CharacterQuadraticField318
public section
noncomputable section
namespace FourRootActualCharacterFields318
open FourRootActualGenericField318
variable (b:Fin 4→ℂ) (hb:Function.Injective b)
local instance independentFact:Fact (QuadraticTower318.Independent (parameter b)):=⟨independent b hb⟩
variable (s:Finset (Fin 4)) (hs:s.Nonempty)
local instance nonsquareFact:Fact (¬IsSquare (CharacterRoot318.radicand (parameter b) s)):=
  ⟨product_nonsquare b hb s hs⟩

/-- The literal root monomial in the SAME finite coordinate ring. -/
@[expose] def monomial:FourRootAffineCoordinateRing318.Ring b:=
  ∏k∈s,FourRootAffineCoordinateRing318.coordinate b (some k)

lemma affine_root (k:Fin 4):affineEmbedding b (FourRootAffineCoordinateRing318.coordinate b (some k))=
    FourRootAutomorphisms318.generator (parameter b) k:=by
  change embedding b (FourRootAffineTensorPresentation318.toTensor b
    (FourRootAffineCoordinateRing318.coordinate b (some k)))=_
  rw [FourRootAffineTensorPresentation318.toTensor_root]
  exact FourRootSignBaseChange318.coefficientMap_generator
    (FourRootAffineTensorPresentation318.radicand b) K k

lemma affine_monomial:affineEmbedding b (monomial b s)=CharacterRoot318.root (parameter b) s:=by
  simp only [monomial,CharacterRoot318.root,map_prod,affine_root]

@[expose] def field:IntermediateField K (KummerTensorField318.Raw (parameter b)):=
  CharacterQuadraticField318.field (parameter b) s

/-- This is the actual field generated by the literal affine root monomial,
not an abstract quadratic extension with a matching discriminant. -/
theorem field_eq_actual_adjoin:field b hb s hs=
    IntermediateField.adjoin K {affineEmbedding b (monomial b s)}:=by
  rw [affine_monomial]
  exact CharacterQuadraticField318.field_eq_adjoin _ _

theorem degree_two:Module.finrank K (field b hb s hs)=2:=
  CharacterQuadraticField318.degree_two _ _
theorem relative_degree_eight:Module.finrank (field b hb s hs)
    (KummerTensorField318.Raw (parameter b))=8:=
  CharacterQuadraticField318.relative_degree_eight _ _
theorem actual_fixed_field:IntermediateField.fixedField (field b hb s hs).fixingSubgroup=
    field b hb s hs:=CharacterQuadraticField318.actual_fixed_field _ _
theorem fixing_subgroup_card:Nat.card (field b hb s hs).fixingSubgroup=8:=
  CharacterQuadraticField318.fixing_subgroup_card _ _

lemma actual_sign (g:FourBinaryCharacters318.Group):
    CharacterRoot318.sign (F:=K) s (FourBinaryCharacters318.signPattern g)=
      algebraMap ℂ K (∏i∈s,FourBinaryCharacters318.coordinate (F:=ℂ) i g):=by
  simp only [CharacterRoot318.sign,map_prod]
  apply Finset.prod_congr rfl
  intro i hi
  by_cases h:Multiplicative.toAdd (g i)=0
  · simp [FourBinaryCharacters318.signPattern,FourBinaryCharacters318.coordinate,h]
  · simp [FourBinaryCharacters318.signPattern,FourBinaryCharacters318.coordinate,h]

/-- The genuine Galois fixing subgroup consumes the SAME full-label sign
maps already identified with the original whole contact deck action. -/
theorem original_sign_mem_fixing_iff (g:FourBinaryCharacters318.Group):
    FourRootActualGenericSigns318.genericAutomorphism b g∈(field b hb s hs).fixingSubgroup ↔
      ∏i∈s,FourBinaryCharacters318.coordinate (F:=ℂ) i g=1:=by
  change FourRootAutomorphisms318.signEquiv (parameter b)
    (FourBinaryCharacters318.signPattern g)∈(CharacterQuadraticField318.field (parameter b) s).fixingSubgroup ↔ _
  rw [CharacterQuadraticField318.sign_mem_fixing_iff,actual_sign]
  constructor
  · intro h
    apply (algebraMap ℂ K).injective
    simpa only [map_one] using h
  · intro h
    rw [h,map_one]
end FourRootActualCharacterFields318
