module
public import ContactRelationImageBaseChange318
public section
noncomputable section
namespace ContactPicardGeometricCoverCriterion318
open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite LineSheafClass318
open ContactOriginalRelativePolynomialCharts318
variable (R : CommRingCat.{0}) [Algebra ℚ R] (c : Fin 4 → ℚˣ) (L K : Line (curve R c))
local notation "Q" => Spec (CommRingCat.of ℚ)
local notation "B" => Over.mk (baseMap R)
local notation "p" => ContactIntrinsicDifferentials318.structureMap c
local notation "P" => OriginalAbsoluteLinePresheaf318.presheaf p
local notation "V" => OriginalAbsoluteLinePresheaf318.value p
local notation "J" => RelativeFppfLineSheaf318.topology Q
/-- Equality in the ACTUAL relative Picard sheaf is exactly covering by
the sieve generated by the actual difference-frame projection. Covering
of its sieve is NOT asserted equivalent to this map being flat or surjective. -/
lemma iff_generated_covering :
    V.app (op B) (classOf L)=V.app (op B) (classOf K) ↔
      Sieve.ofArrows (fun _ : PUnit => ContactRelationProjectionImage318.object R c L K)
        (fun _ => ContactRelationProjectionImage318.projection R c L K) ∈ J B := by
  rw [OriginalPicardAbsoluteEquality318.iff_covering,
    ContactRelationProjectionImage318.equalizer_eq_image,MorphismImageSieve318.generated]
/-- Same exact criterion after EVERY coefficient base change, with the
actual pulled-back geometric projection and the full original sheaf values. -/
lemma pullback_iff_covering (T : Over Q) (f : T ⟶ B) :
    V.app (op T) (P.map f.op (classOf L))=
      V.app (op T) (P.map f.op (classOf K)) ↔
      MorphismImageSieve318.image
        (ContactRelationImageBaseChange318.projection R c L K T f) ∈ J T := by
  rw [OriginalPicardAbsoluteEquality318.iff_covering,
    ContactRelationImageBaseChange318.equalizer_eq_image]
/-- An actual lift through the relation projection proves original
Picard equality after that test, without assuming global quotient injectivity. -/
lemma equality_of_lift (T : Over Q) (f : T ⟶ B)
    (z : T ⟶ ContactRelationProjectionImage318.object R c L K)
    (hz : z ≫ ContactRelationProjectionImage318.projection R c L K=f) :
    V.app (op T) (P.map f.op (classOf L))=
      V.app (op T) (P.map f.op (classOf K)) := by
  have h : Presheaf.equalizerSieve (show P.obj (op B) from classOf L)
      (show P.obj (op B) from classOf K) f := by
    rw [ContactRelationProjectionImage318.equalizer_eq_image]
    exact ⟨z,hz⟩
  exact congrArg (V.app (op T)) h
/-- The original two Picard classes actually coincide on the concrete
universal relation object itself. No equality is inferred back on the base
without the covering condition above. -/
lemma universal_equality :
    V.app (op (ContactRelationProjectionImage318.object R c L K))
      (P.map (ContactRelationProjectionImage318.projection R c L K).op (classOf L))=
    V.app (op (ContactRelationProjectionImage318.object R c L K))
      (P.map (ContactRelationProjectionImage318.projection R c L K).op (classOf K)) :=
  equality_of_lift R c L K _ _ (𝟙 _) (Category.id_comp _)
end ContactPicardGeometricCoverCriterion318
