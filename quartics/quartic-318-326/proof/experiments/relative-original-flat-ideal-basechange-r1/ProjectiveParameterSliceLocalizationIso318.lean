module
public import ProjectiveParameterSliceLocalization318
public section
noncomputable section
namespace ProjectiveParameterSliceLocalizationIso318
open ProjectiveParameterSliceLocalization318
universe u v w
variable (R : Type u) [CommRing R] (P : Type v) [AddCommGroup P] [Module R P]
  [Module.Finite R P] [Module.Projective R P]
local notation "A" => ProjectiveSectionParameter318.algebra R P
local notation "F" => FiniteProjectiveEvaluationFrame318.frame R P
local notation "B" => ProjectiveParameterSliceAlgebra318.algebra R P
variable (i j : Fin F.size)
local notation "O" => algebra R P i j
local notation "O'" => algebra R P j i

/-- The SAME localized overlap is generated by the original symmetric
algebra and the inverse of its actual selected coordinate. -/
lemma hom_ext {T : Type w} [CommRing T] [Algebra R T] {f g : O →ₐ[R] T}
    (h : ∀ a : A,f (point R P i j a)=g (point R P i j a)) : f=g := by
  have he : f.toRingHom=g.toRingHom := by
    apply IsLocalization.ringHom_ext (Submonoid.powers (coordinate R P i j))
    apply RingHom.ext
    intro b
    obtain ⟨a,rfl⟩ := Ideal.Quotient.mk_surjective b
    exact h a
  exact AlgHom.ext (fun z => DFunLike.congr_fun he z)

lemma transition_unit : transition R P i j (unit R P j i : O')=
    (((unit R P i j)⁻¹:Oˣ):O) := by
  rw [unit_val,transition_point,ProjectiveParameterUnitSlice318.scale_coordinate,first,mul_one]

/-- The transition and reverse transition compose to the identity on
all ring elements, including localized fractions, not merely on points. -/
lemma transition_comp : (transition R P i j).comp (transition R P j i)=AlgHom.id R O := by
  have hm : transition R P i j (((unit R P j i)⁻¹:O'ˣ):O') *
      (((unit R P i j)⁻¹:Oˣ):O)=1 := by
    have h := congrArg (transition R P i j) (Units.inv_mul (unit R P j i))
    simpa only [map_mul,map_one,transition_unit] using h
  have hb : ((transition R P i j).comp (transition R P j i)).comp (point R P i j)=
      point R P i j := by
    apply SymmetricAlgebra.algHom_ext
    ext φ
    change transition R P i j (transition R P j i
      (point R P i j (SymmetricAlgebra.ι R _ φ)))=_
    rw [transition_point,ProjectiveParameterUnitAction318.pointScale_generator,map_mul,
      transition_point,ProjectiveParameterUnitAction318.pointScale_generator,← mul_assoc,hm,one_mul]
  apply hom_ext R P i j
  intro a
  exact DFunLike.congr_fun hb a

/-- Actual affine overlap coordinate-ring isomorphisms for the local
unit quotient charts. They preserve the ground coefficient algebra and
are built from the original parameter coordinates. -/
@[expose] def equivalence : O' ≃ₐ[R] O where
  __ := transition R P i j
  invFun := transition R P j i
  left_inv z := DFunLike.congr_fun (transition_comp R P j i) z
  right_inv z := DFunLike.congr_fun (transition_comp R P i j) z
end ProjectiveParameterSliceLocalizationIso318
