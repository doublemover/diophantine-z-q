module
public import FramedSectionInverseIdealMap318
public import OpenRestrictionImages318
public import Mathlib.AlgebraicGeometry.Properties
public section
noncomputable section
namespace IntegralInverseIdealImage318
open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace
open FramedSectionInverseIdealMap318
variable {X : Scheme} [IsIntegral X] (L : LineSheafClass318.Line X)
  (c : ∀ i,Γ(X,L.opens i))
  (hc : ∀ i j,X.presheaf.map (homOfLE inf_le_left).op (c i)=
    ((LineFrameCocycle318.cocycle L.object L.opens L.frame).transition i j).val*
      X.presheaf.map (homOfLE inf_le_right).op (c j))
  (hn : ∀ i,c i≠0)
include hn in
lemma app_injective (W : X.Opens) : Function.Injective ((hom L c hc).app W) := by
  intro s t he
  apply ModuleLocalGluing318.ext_value (N := (inverse L).object) (U := L.opens) L.cover W s t
  intro i
  let V := W⊓L.opens i
  rcases (V : Set X).eq_empty_or_nonempty with hV | hV
  · have hz : V=⊥ := SetLike.ext' hV
    change (inverse L).object.presheaf.map (homOfLE (show V≤W from inf_le_left)).op s=
      (inverse L).object.presheaf.map (homOfLE (show V≤W from inf_le_left)).op t
    haveI : Subsingleton Γ((inverse L).object,V) := by rw [hz]; infer_instance
    exact Subsingleton.elim _ _
  · letI : Nonempty V := ⟨⟨Classical.choose hV,Classical.choose_spec hV⟩⟩
    letI : IsDomain Γ(X,V) := IsIntegral.component_integral V
    have hcv : X.presheaf.map (homOfLE (show V≤L.opens i from inf_le_right)).op (c i)≠0 := by
      intro h
      exact hn i (map_injective_of_isIntegral X (homOfLE inf_le_right) (h.trans (map_zero _).symm))
    have hs := congrArg (fun a => a s)
      ((hom L c hc).mapPresheaf.naturality (homOfLE (show V≤W from inf_le_left)).op)
    have ht := congrArg (fun a => a t)
      ((hom L c hc).mapPresheaf.naturality (homOfLE (show V≤W from inf_le_left)).op)
    change (hom L c hc).app V ((inverse L).object.presheaf.map (homOfLE inf_le_left).op s)=
      X.presheaf.map (homOfLE inf_le_left).op ((hom L c hc).app W s) at hs
    change (hom L c hc).app V ((inverse L).object.presheaf.map (homOfLE inf_le_left).op t)=
      X.presheaf.map (homOfLE inf_le_left).op ((hom L c hc).app W t) at ht
    have h := hs.trans ((congrArg (X.presheaf.map (homOfLE (show V≤W from inf_le_left)).op) he).trans ht.symm)
    rw [hom_subopen L c hc i V inf_le_right,hom_subopen L c hc i V inf_le_right] at h
    apply (localFrame L i V inf_le_right).symm.injective
    exact mul_left_cancel₀ hcv h
include hn in
lemma mono : Mono (hom L c hc) where
  right_cancellation := by
    intro N f g h
    apply Scheme.Modules.hom_ext
    intro W
    ext s
    apply app_injective L c hc hn W
    exact congrArg (fun ψ => ψ.app W s) h

/-- The actual categorical image inside the unchanged structure sheaf. -/
abbrev idealModule := image (hom L c hc)
abbrev inclusion : idealModule L c hc ⟶ SheafOfModules.unit X.ringCatSheaf := image.ι (hom L c hc)

/-- The inverse line is isomorphic to the genuine ideal IMAGE, not just
its class, using the proved whole sheaf monomorphism. -/
@[expose] def iso : (inverse L).object ≅ idealModule L c hc := by
  letI := mono L c hc hn
  exact image.isoStrongEpiMono (𝟙 _) (hom L c hc) (Category.id_comp _)
@[reassoc] lemma iso_inclusion : (iso L c hc hn).hom≫inclusion L c hc=hom L c hc := by
  letI := mono L c hc hn
  exact image.isoStrongEpiMono_hom_comp_ι (𝟙 _) (hom L c hc) (Category.id_comp _)

include hn in
/-- Exact section-image description follows from the actual image
isomorphism. No general assertion that categorical images are computed
sectionwise is used. -/
lemma image_range (W : X.Opens) (r : Γ(X,W)) :
    (∃ s : Γ(idealModule L c hc,W),(inclusion L c hc).app W s=r) ↔
      ∃ s : Γ((inverse L).object,W),(hom L c hc).app W s=r := by
  constructor
  · rintro ⟨s,hs⟩
    refine ⟨(iso L c hc hn).inv.app W s,?_⟩
    rw [←iso_inclusion]
    change (inclusion L c hc).app W ((iso L c hc hn).hom.app W ((iso L c hc hn).inv.app W s))=r
    simpa only [←ConcreteCategory.comp_apply,←Scheme.Modules.Hom.comp_app,
      Iso.inv_hom_id,Scheme.Modules.Hom.id_app,ConcreteCategory.id_apply] using hs
  · rintro ⟨s,hs⟩
    refine ⟨(iso L c hc hn).hom.app W s,?_⟩
    exact (congrArg (fun f => f.app W s) (iso_inclusion L c hc hn)).trans hs

include hn in
/-- On EVERY subopen of EVERY frame, the full image is precisely the
principal ideal generated by the SAME actual coefficient. -/
lemma local_range (i : L.Index) (W : X.Opens) (hW : W≤L.opens i) (r : Γ(X,W)) :
    (∃ s : Γ(idealModule L c hc,W),(inclusion L c hc).app W s=r) ↔
      r∈Ideal.span {X.presheaf.map (homOfLE hW).op (c i)} := by
  rw [image_range L c hc hn,Ideal.mem_span_singleton]
  constructor
  · rintro ⟨s,hs⟩
    refine ⟨(localFrame L i W hW).symm s,?_⟩
    exact (hom_subopen L c hc i W hW s).symm.trans hs
  · rintro ⟨a,ha⟩
    refine ⟨localFrame L i W hW a,?_⟩
    exact (hom_frame L c hc i W hW a).trans ha
end IntegralInverseIdealImage318
