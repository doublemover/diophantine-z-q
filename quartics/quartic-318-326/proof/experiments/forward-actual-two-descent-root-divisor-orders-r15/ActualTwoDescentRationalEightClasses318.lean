module
public import ActualTwoDescentLiteralEightClasses318
public section
noncomputable section
namespace ActualTwoDescentRationalEightClasses318
open ActualTwoDescentRationalPointPlaces318 ActualTwoDescentRationalClassBound318
open ActualTwoDescentLiteralEightClasses318 ActualTwoDescentPrimeMonomials318
open ActualTwoDescentCoordinateSymbols318 ActualTwoDescentFiniteConclusion318
open scoped BigOperators
set_option maxHeartbeats 16000000
variable {U : Type*} [Fintype U] [DecidableEq U]

/-- Every actual non-two-torsion RATIONAL point has one of the eight
literal Kummer squareclasses generated by(3,-n),(n,1),(beta,1). The theorem
starts with a point; it does NOT assert that the beta class has such a point. -/
theorem actual_rational_eight_classes (p : Option U → ℕ) [∀ i, Fact (p i).Prime]
    (hd : Function.Injective p) (hp2 : ∀ i, p i ≠ 2) (hp3 : ∀ i, p i ≠ 3)
    (a beta : Option U → ZMod 2) (N : ℕ) (C : Conclusion p a beta N)
    (P : RationalPoint (∏ i, p i)) :
    ∃ ε c e : ZMod 2, ∃ r s : ℚ, r ≠ 0 ∧ s ≠ 0 ∧
      P.x+3*(∏ i, p i : ℕ)=
        (3 : ℚ)^ε.val*((∏ i, p i : ℕ) : ℚ)^c.val*(monomial p beta : ℚ)^e.val*r^2 ∧
      P.x-(∏ i, p i : ℕ)=(-((∏ i, p i : ℕ) : ℚ))^ε.val*s^2 := by
  obtain ⟨ε,c,e,r,s,hr,hs,hA,hB⟩ := actual_rational_class_bound p hd hp2 hp3 a beta N C P
  obtain ⟨t,ht,he⟩ := actual_four_monomial_classes p beta c e
  refine ⟨ε,c,e,t*r,s,mul_ne_zero ht hr,hs,?_,?_⟩
  · rw [hA,firstRepresentative,Nat.cast_mul,Nat.cast_pow,Nat.cast_ofNat,he,mul_pow]
    ring
  · rwa [actual_second_torsion_representative] at hB

end ActualTwoDescentRationalEightClasses318
