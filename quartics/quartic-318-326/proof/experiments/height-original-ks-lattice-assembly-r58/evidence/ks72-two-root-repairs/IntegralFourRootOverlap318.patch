+      (reciprocalCoefficient d a))
+    (fullOverlap R d a).toRingEquiv
+    (FourRootOrderOpenMaps318.baseChangedOrderMapAlong_open (reciprocalMap R).toRingHom
+      (reciprocalCoefficient d a) (X:R[X])
