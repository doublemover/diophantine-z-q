module
public import ThreeJRelativeDifferentials318
public import LocalizedKaehlerFrame318
public import Mathlib.RingTheory.Kaehler.Polynomial
public section
noncomputable section
namespace FramedRelativeDifferentials318
open Polynomial KaehlerDifferential TensorProduct
open scoped TensorProduct
set_option maxHeartbeats 1500000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
variable {R B : Type*} [CommRing R] [CommRing B]
  [Algebra R B] [Algebra R[X] B] [IsScalarTower R R[X] B]

@[expose] def coordinate : B := algebraMap R[X] B X
@[expose] def projection : KaehlerDifferential R B →ₗ[B] KaehlerDifferential R[X] B :=
  KaehlerDifferential.map R R[X] B B

lemma polynomial_generator (w : KaehlerDifferential R R[X]) :
    w=KaehlerDifferential.polynomialEquiv R w • D R R[X] X := by
  exact ((KaehlerDifferential.polynomialEquiv R).symm_apply_apply w).symm

/-- The full transitivity kernel is generated by the actual image of the
target differential. No assumption that a visible derivative generates the
kernel is smuggled into the presentation. -/
theorem projection_kernel : LinearMap.ker (projection (R:=R) (B:=B))=
    Submodule.span B {D R B (coordinate (R:=R))} := by
  rw [projection,←KaehlerDifferential.range_mapBaseChange R R[X] B]
  apply le_antisymm
  · rintro _ ⟨v,rfl⟩
    induction v using TensorProduct.induction_on with
    | zero => simp
    | add x y hx hy => rw [map_add]; exact Submodule.add_mem _ hx hy
    | tmul b w =>
      rw [KaehlerDifferential.mapBaseChange_tmul,polynomial_generator w,
        map_smul,←IsScalarTower.algebraMap_smul B,KaehlerDifferential.map_D]
      exact Submodule.smul_mem _ b (Submodule.smul_mem _ _
        (Submodule.subset_span (Set.mem_singleton _)))
  · rw [Submodule.span_le]
    rintro _ rfl
    refine ⟨1 ⊗ₜ[R[X]] D R R[X] X,?_⟩
    rw [KaehlerDifferential.mapBaseChange_tmul,one_smul,KaehlerDifferential.map_D]
    rfl

variable (frame : KaehlerDifferential R B ≃ₗ[B] B)
@[expose] def jacobian : B := frame (D R B (coordinate (R:=R)))
@[expose] def relativeGenerator : B →ₗ[B] KaehlerDifferential R[X] B :=
  (projection (R:=R)).comp frame.symm.toLinearMap

lemma relativeGenerator_surjective : Function.Surjective (relativeGenerator frame) :=
  (KaehlerDifferential.map_surjective R R[X] B).comp frame.symm.surjective

theorem relativeGenerator_kernel : LinearMap.ker (relativeGenerator frame)=
    (Ideal.span {jacobian frame} : Submodule B B) := by
  ext b
  change projection (frame.symm b)=0 ↔ b ∈ Ideal.span {jacobian frame}
  rw [←LinearMap.mem_ker,projection_kernel,Submodule.mem_span_singleton,
    Ideal.mem_span_singleton]
  constructor
  · rintro ⟨a,ha⟩
    have h := congrArg frame ha
    simp only [map_smul,smul_eq_mul,LinearEquiv.apply_symm_apply] at h
    exact ⟨a,h.symm.trans (mul_comm _ _)⟩
  · rintro ⟨a,ha⟩
    refine ⟨a,?_⟩
    apply frame.injective
    rw [map_smul,smul_eq_mul,LinearEquiv.apply_symm_apply]
    change a*jacobian frame=b
    rw [ha,mul_comm]

/-- A coordinate-free frame computes the entire relative differential
module for an actual polynomial target coordinate, including localized source
charts where no monic source presentation was supplied. -/
@[expose] def quotientEquiv : (B ⧸ Ideal.span {jacobian frame}) ≃ₗ[B]
    KaehlerDifferential R[X] B := by
  change (B ⧸ (Ideal.span {jacobian frame} : Submodule B B)) ≃ₗ[B] _
  rw [←relativeGenerator_kernel frame]
  exact (relativeGenerator frame).quotKerEquivOfSurjective (relativeGenerator_surjective frame)

end FramedRelativeDifferentials318
