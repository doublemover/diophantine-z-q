open ActualTwoDescentGaloisPointAction318 ActualTwoDescentGaloisFixedRational318
open scoped BigOperators

local instance : DecidableEq Qbar := Classical.decEq _

/-- The ideal-class index is tied to the subfield actually generated by the
chosen geometric square root, not to an unrelated field of the same degree. -/
abbrev BaseField (κ : Qbar) := ↥(IntermediateField.adjoin ℚ ({κ} : Set Qbar))

instance actualBaseNumberField (κ : Qbar) : NumberField (BaseField κ) where
  to_charZero := inferInstance
  to_finiteDimensional := IntermediateField.adjoin.finiteDimensional
    (Algebra.IsIntegral.isIntegral (R := ℚ) κ)

abbrev Index (κ : Qbar) := ClassGroup (NumberField.RingOfIntegers (BaseField κ))

/-- This is the full unaveraged class-group sum, taken in the actual
algebraic-closure group of the literal original Weierstrass model. -/
@[expose] def trace (κ : Qbar) (n : ℚ)
    (P : Index κ → Point (algebraMap ℚ Qbar n)) : Point (algebraMap ℚ Qbar n) :=
  ∑ a, P a

private def translate {G : Type*} [Group G] (u : G) : Equiv.Perm G where
  toFun a := a * u
  invFun a := a * u⁻¹
  left_inv a := by simp [mul_assoc]
  right_inv a := by simp [mul_assoc]

/-- All absolute automorphisms restrict to one of the two square-root signs. -/
lemma galois_square_root_sign (d : ℚ) (κ : Qbar)
    (hκ : κ ^ 2 = algebraMap ℚ Qbar d) (σ : GalQ) :
    σ κ = κ ∨ σ κ = -κ := by
  have h : (σ κ) ^ 2 = κ ^ 2 := by
    calc
      _ = σ (κ ^ 2) := (map_pow σ κ 2).symm
      _ = _ := by rw [hκ, σ.commutes]
  have hz : (σ κ - κ) * (σ κ + κ) = 0 := by
    calc
      _ = (σ κ) ^ 2 - κ ^ 2 := by ring
      _ = 0 := sub_eq_zero.mpr h
  rcases mul_eq_zero.mp hz with hz | hz
  · exact Or.inl (sub_eq_zero.mp hz)
  · right
    calc
      σ κ = (σ κ + κ) - κ := by abel
      _ = -κ := by rw [hz, zero_sub]

/-- Exact fixed-orientation and reversed-orientation pointwise arithmetic
inputs. A class translation (and inversion on reversal) reindexes the entire
literal orbit. The translation correction is the same rational cusp point
at every class, not a cohomology class or an arbitrary translate of the sum. -/
structure IndexedAction (κ : Qbar) (n : ℚ) (hn : n ≠ 0) where
  point : Index κ → Point (algebraMap ℚ Qbar n)
  cusp : Point n
  fixedOrientation : ∀ (σ : GalQ), σ κ = κ →
    ∃ u : Index κ, ∀ a : Index κ,
      galoisPointHom σ n hn (point a) = point (a * u)
  conjugation : GalQ
  conjugationSign : conjugation κ = -κ
  reversedShift : Index κ
  reversedOrientation : ∀ a : Index κ,
    galoisPointHom conjugation n hn (point a) =
      point (a⁻¹ * reversedShift) + rationalPointMap n hn cusp

/-- The actual Galois action preserves the unaveraged sum for the fixed sign. -/
theorem trace_fixed (κ : Qbar) (n : ℚ) (hn : n ≠ 0)
    (D : IndexedAction κ n hn) (σ : GalQ) (hσ : σ κ = κ) :
    galoisPointHom σ n hn (trace κ n D.point) = trace κ n D.point := by
  obtain ⟨u, hu⟩ := D.fixedOrientation σ hσ
  unfold trace
  calc
    _ = ∑ a, galoisPointHom σ n hn (D.point a) :=
      map_sum (galoisPointHom σ n hn) D.point Finset.univ
    _ = ∑ a, D.point (translate u a) :=
      Finset.sum_congr rfl (fun a _ => hu a)
    _ = _ := Equiv.sum_comp (translate u) D.point

/-- For the distinguished reversal the difference is exactly the class
number times the one rational cusp translation, with the Fricke +1 sign. -/
theorem trace_conjugation (κ : Qbar) (n : ℚ) (hn : n ≠ 0)
    (D : IndexedAction κ n hn) :
    galoisPointHom D.conjugation n hn (trace κ n D.point) =
      trace κ n D.point + NumberField.classNumber (BaseField κ) • rationalPointMap n hn D.cusp := by
  let e : Equiv.Perm (Index κ) := (Equiv.inv (Index κ)).trans (translate D.reversedShift)
  unfold trace
  calc
    _ = ∑ a, galoisPointHom D.conjugation n hn (D.point a) :=
      map_sum (galoisPointHom D.conjugation n hn) D.point Finset.univ
    _ = ∑ a, (D.point (e a) + rationalPointMap n hn D.cusp) :=
      Finset.sum_congr rfl (fun a _ => D.reversedOrientation a)
    _ = _ := by
      rw [Finset.sum_add_distrib, Equiv.sum_comp e D.point]
      simp only [Finset.sum_const, Finset.card_univ, NumberField.classNumber]

/-- Factor any other reversal through the single supplied one; no second
Fricke comparison or re-selection of geometric points is needed. -/
theorem trace_reversed (κ : Qbar) (n : ℚ) (hn : n ≠ 0)
    (D : IndexedAction κ n hn) (σ : GalQ) (hσ : σ κ = -κ) :
    galoisPointHom σ n hn (trace κ n D.point) =
      trace κ n D.point + NumberField.classNumber (BaseField κ) • rationalPointMap n hn D.cusp := by
  let τ : GalQ := σ * D.conjugation⁻¹
  have hτc : τ * D.conjugation = σ := by simp [τ, mul_assoc]
  have hci : D.conjugation⁻¹ κ = -κ := by
    have hcn : D.conjugation (-κ) = κ := by
      rw [map_neg, D.conjugationSign, neg_neg]
    change D.conjugation.symm κ = -κ
    calc
      D.conjugation.symm κ = D.conjugation.symm (D.conjugation (-κ)) :=
        congrArg (fun y : Qbar => D.conjugation.symm y) hcn.symm
      _ = -κ := AlgEquiv.symm_apply_apply D.conjugation (-κ)
  have hτ : τ κ = κ := by
    change σ (D.conjugation⁻¹ κ) = κ
    rw [hci, map_neg, hσ, neg_neg]
  rw [← hτc, actual_galois_mul, trace_conjugation κ n hn D, map_add, map_nsmul,
    trace_fixed κ n hn D τ hτ, actual_rational_point_fixed]

/-- The same rational cuspidal annihilator kills every translate of the
original sum. This discharges the killed-translates field of the existing
Heegner descent; no non-torsion statement about the trace is supplied. -/
theorem trace_killed_translates (d : ℚ) (κ : Qbar)
    (hκ : κ ^ 2 = algebraMap ℚ Qbar d) (n : ℚ) (hn : n ≠ 0)
    (D : IndexedAction κ n hn) (m : ℕ) (hcusp : m • D.cusp = 0) :
    ∀ σ : GalQ, m • (galoisPointHom σ n hn (trace κ n D.point) - trace κ n D.point) = 0 := by
  intro σ
  rcases galois_square_root_sign d κ hκ σ with hσ | hσ
  · rw [trace_fixed κ n hn D σ hσ, sub_self, nsmul_zero]
  · have hc : m • rationalPointMap n hn D.cusp = 0 := by
      rw [← map_nsmul, hcusp, map_zero]
    rw [trace_reversed κ n hn D σ hσ]
    have hsub :
        trace κ n D.point + NumberField.classNumber (BaseField κ) • rationalPointMap n hn D.cusp
          - trace κ n D.point =
          NumberField.classNumber (BaseField κ) • rationalPointMap n hn D.cusp := by abel
    rw [hsub]
    let h := NumberField.classNumber (BaseField κ)
    calc
      m • (h • rationalPointMap n hn D.cusp) =
          (m * h) • rationalPointMap n hn D.cusp := (mul_nsmul _ _ _).symm
      _ = (h * m) • rationalPointMap n hn D.cusp := by rw [Nat.mul_comm m h]
      _ = h • (m • rationalPointMap n hn D.cusp) := mul_nsmul _ _ _
      _ = 0 := by rw [hc, nsmul_zero]

end ActualSelectedIndexedFrickeTrace318
