module
public import QuadraticFiniteDual318
public import TensorFiniteDual318
public import DVRNormalizedFiniteOrder318
public section
noncomputable section
namespace NormalizedOrderFiniteDual318
open scoped TensorProduct
open QuadraticPresentation318 FourRootOrder318
variable (R : Type*) [CommRing R] (p : Fin 4 → R)
local instance rootFinite (b : R) : Module.Finite R (RootRing b) := root_finite b
local instance rootFree (b : R) : Module.Free R (RootRing b) := root_free b

@[expose] def pair01 : Pair01 p ≃ₗ[R] Module.Dual R (Pair01 p) :=
  TensorFiniteDual318.perfect R (RootRing (p 0)) (RootRing (p 1))
    (QuadraticFiniteDual318.rootPerfect R (p 0)) (QuadraticFiniteDual318.rootPerfect R (p 1))
@[expose] def pair23 : Pair23 p ≃ₗ[R] Module.Dual R (Pair23 p) :=
  TensorFiniteDual318.perfect R (RootRing (p 2)) (RootRing (p 3))
    (QuadraticFiniteDual318.rootPerfect R (p 2)) (QuadraticFiniteDual318.rootPerfect R (p 3))

/-- The ACTUAL entire four-root order is perfectly paired with its actual
finite relative dual Hom_R(A,R), with no etaleness or unit hypothesis. -/
@[expose] def perfect : Order p ≃ₗ[R] Module.Dual R (Order p) :=
  TensorFiniteDual318.perfect R (Pair01 p) (Pair23 p) (pair01 R p) (pair23 R p)

theorem perfect_mul (x y z : Order p) :
    perfect R p (x*y) z=perfect R p x (y*z) := by
  apply TensorFiniteDual318.perfect_mul
  · exact TensorFiniteDual318.perfect_mul R (RootRing (p 0)) (RootRing (p 1))
      (QuadraticFiniteDual318.rootPerfect R (p 0)) (QuadraticFiniteDual318.rootPerfect R (p 1))
      (QuadraticFiniteDual318.rootPerfect_mul R (p 0)) (QuadraticFiniteDual318.rootPerfect_mul R (p 1))
  · exact TensorFiniteDual318.perfect_mul R (RootRing (p 2)) (RootRing (p 3))
      (QuadraticFiniteDual318.rootPerfect R (p 2)) (QuadraticFiniteDual318.rootPerfect R (p 3))
      (QuadraticFiniteDual318.rootPerfect_mul R (p 2)) (QuadraticFiniteDual318.rootPerfect_mul R (p 3))

/-- The full finite dual is generated by the coefficient functional under
actual multiplication: every functional is represented by a UNIQUE element.
The codomain remains Hom_R(A,R), not a renamed free target. -/
theorem unique_representation (φ : Module.Dual R (Order p)) :
    ∃! x : Order p, ∀ y : Order p,φ y=perfect R p 1 (x*y) := by
  refine ⟨(perfect R p).symm φ,?_,?_⟩
  · intro y
    rw [←perfect_mul,one_mul,LinearEquiv.apply_symm_apply]
  · intro x hx
    apply (perfect R p).injective
    rw [LinearEquiv.apply_symm_apply]
    apply LinearMap.ext
    intro y
    rw [hx y,←perfect_mul,one_mul]

section ActualNormalized
variable (V : Type*) [CommRing V] (d a : Fin 4 → V)
/-- The entire original normalized finite model's finite dual module over
V[T], including all bad nonunit twists and primes over2. -/
@[expose] def normalizedPerfect :
    DVRNormalizedFiniteOrder318.Order V d a ≃ₗ[(Polynomial V)]
      Module.Dual (Polynomial V) (DVRNormalizedFiniteOrder318.Order V d a) :=
  perfect (Polynomial V) (DVRNormalizedFiniteOrder318.coefficient V d a)
end ActualNormalized
end NormalizedOrderFiniteDual318
