/-- These integer certificates verify the actual chronological words,
including their exact nonzero scalar. No orbit-search oracle is trusted. -/
theorem coordinate_certificate (k : Fin 77) :
    integerWord (path k)=wordScale k • smallConjugator k := by
  revert k
  decide

theorem scale_ne_zero (k : Fin 77) : wordScale k≠0 := by
  revert k
  decide

theorem small_intertwining (k : Fin 77) :
    product (smallConjugator k) (PELInertiaNormalizerData318.coefficients (label k))=
      product (candidate k) (smallConjugator k) := by
  revert k
  decide

/-- Exact intertwining for the ENTIRE ORIGINAL WORD, not merely a
projectively equivalent guessed quaternion. -/
theorem word_intertwining (k : Fin 77) :
    product (integerWord (path k)) (PELInertiaNormalizerData318.coefficients (label k))=
      product (candidate k) (integerWord (path k)) := by
  revert k
  decide

@[expose] def conjugator (k : Fin 77) : positiveNormalizer := positiveWord (path k)

theorem actual_intertwining (k : Fin 77) :
    ((conjugator k).val:B)*PELInertiaNormalizerData318.element (label k)=
      embed (candidate k)*((conjugator k).val:B) := by
  have h := congrArg embed (word_intertwining k)
  simpa only [embed_mul,←positiveWord_value,conjugator,PELInertiaNormalizerData318.element] using h

/-- Every listed candidate is a conjugate of its ORIGINAL labeled inertia
inside the ACTUAL positive normalizer. Both order normalization and norm
positivity follow from the proved original generators and subgroup closure. -/
theorem actual_conjugation (k : Fin 77) :
    ((conjugator k).val:B)*PELInertiaNormalizerData318.element (label k)*
        (((conjugator k).val⁻¹:Bˣ):B)=embed (candidate k) := by
  rw [actual_intertwining,mul_assoc]
  simp

/-- An application-facing existential, with an explicit word producer. -/
theorem exists_original_conjugator (k : Fin 77) :
    ∃ g : positiveNormalizer, (g.val:B)*PELInertiaNormalizerData318.element (label k)*
      ((g.val⁻¹:Bˣ):B)=embed (candidate k) :=
  ⟨conjugator k,actual_conjugation k⟩
end PELFixedCandidateConjugators318
