module
public import Mathlib.RingTheory.FinitePresentation
public section
noncomputable section
namespace FinitePolynomialRetractPresentation318
universe u v
variable (R : Type u) [CommRing R] (A : Type v) [CommRing A] [Algebra R A]
  (n : ℕ) (a : MvPolynomial (Fin n) R →ₐ[R] A)
  (b : A →ₐ[R] MvPolynomial (Fin n) R) (hab : a.comp b=AlgHom.id R A)

@[expose] def relation (i : Fin n) : MvPolynomial (Fin n) R :=
  MvPolynomial.X i-b (a (MvPolynomial.X i))
@[expose] def ideal : Ideal (MvPolynomial (Fin n) R) := Ideal.span (Set.range (relation R A n a b))

lemma kernel : RingHom.ker a.toRingHom=ideal R A n a b := by
  let J := ideal R A n a b
  let q := Ideal.Quotient.mkₐ R J
  have hq : (q.comp b).comp a=q := by
    apply MvPolynomial.algHom_ext
    intro i
    apply sub_eq_zero.mp
    change q (b (a (MvPolynomial.X i)))-q (MvPolynomial.X i)=0
    have hz : q (MvPolynomial.X i-b (a (MvPolynomial.X i)))=0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨i,rfl⟩)
    rw [map_sub] at hz
    exact sub_eq_zero.mpr (sub_eq_zero.mp hz).symm
  apply le_antisymm
  · intro x hx
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    have h := congrArg (fun k => k x) hq
    change q (b (a x))=q x at h
    change a x=0 at hx
    rw [hx,map_zero,map_zero] at h
    exact h.symm
  · apply Ideal.span_le.mpr
    rintro x ⟨i,rfl⟩
    change a (MvPolynomial.X i-b (a (MvPolynomial.X i)))=0
    rw [map_sub]
    have h := DFunLike.congr_fun hab (a (MvPolynomial.X i))
    change a (b (a (MvPolynomial.X i)))=a (MvPolynomial.X i) at h
    rw [h,sub_self]

/-- An explicit finite polynomial retract has an explicit FINITE
presentation: its kernel is generated by the n literal idempotent
relations X_i-b(a(X_i)), not assumed finitely generated. -/
lemma finitePresentation : Algebra.FinitePresentation R A where
  out := by
    refine ⟨n,a,?_,?_⟩
    · intro x
      exact ⟨b x,DFunLike.congr_fun hab x⟩
    · rw [kernel R A n a b hab]
      exact Submodule.fg_span (Set.finite_range (relation R A n a b))
end FinitePolynomialRetractPresentation318
