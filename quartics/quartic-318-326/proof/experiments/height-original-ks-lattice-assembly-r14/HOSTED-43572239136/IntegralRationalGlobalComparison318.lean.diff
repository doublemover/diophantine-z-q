+    (h : f ≫ eB.hom = eA.hom ≫ g) :
+    (Scheme.Spec.mapIso eB.symm.op).inv ≫ Spec.map f =
+      Spec.map g ≫ (Scheme.Spec.mapIso eA.symm.op).inv := by
+  change Spec.map eB.hom ≫ Spec.map f = Spec.map g ≫ Spec.map eA.hom
+  rw [←Spec.map_comp, ←Spec.map_comp, h]
