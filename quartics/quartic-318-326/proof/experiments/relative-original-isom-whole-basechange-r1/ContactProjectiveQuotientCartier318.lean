module
public import ContactProjectiveQuotientProperties318
public import ActualCartierIdealLine318
public section
noncomputable section
namespace ContactProjectiveQuotientCartier318
open AlgebraicGeometry CategoryTheory CategoryTheory.Limits
open ContactProjectiveQuotientData318 ContactProjectiveQuotientGluing318
variable (R : CommRingCat.{0}) [Algebra ℚ R] (c : Fin 4 → ℚˣ) (D : Datum R c)
variable (hf : OriginalRegularIdealCover318.Property (CommRingCat.of (finiteRing R c)) D.finiteIdeal)
  (hi : OriginalRegularIdealCover318.Property (CommRingCat.of (infinityRing R c)) D.infinityIdeal)
/-- Actual compatible full ideals that are locally generated by regular
elements produce Cartier charts on the ENTIRE original projective curve.
The local models are the literal quotient rings and actual pullbacks. -/
lemma regular_charts : OriginalRegularClosedCharts318.Property (into R c D) := by
  intro x
  have hx : x ∈ (ContactOriginalRelativePolynomialCharts318.finiteInto R c).opensRange ⊔
      (ContactOriginalRelativePolynomialCharts318.infinityInto R c).opensRange := by
    rw [ContactOriginalRelativePolynomialCharts318.cover]
    trivial
  rcases hx with ⟨a,ha⟩ | ⟨b,hb⟩
  · obtain ⟨A,k,hk,⟨y,hy⟩,d,z,hz,hd⟩ := OriginalRegularClosedCharts318.quotient
      (CommRingCat.of (finiteRing R c)) D.finiteIdeal hf a
    letI : IsOpenImmersion k := hk
    refine ⟨A,k ≫ ContactOriginalRelativePolynomialCharts318.finiteInto R c,
      inferInstance,⟨y,?_⟩,d,z ≫ finiteChart R c D,
      hz.paste_vert (finite_square R c D).flip,hd⟩
    rw [Scheme.Hom.comp_apply,hy,ha]
  · obtain ⟨A,k,hk,⟨y,hy⟩,d,z,hz,hd⟩ := OriginalRegularClosedCharts318.quotient
      (CommRingCat.of (infinityRing R c)) D.infinityIdeal hi b
    letI : IsOpenImmersion k := hk
    refine ⟨A,k ≫ ContactOriginalRelativePolynomialCharts318.infinityInto R c,
      inferInstance,⟨y,?_⟩,d,z ≫ infinityChart R c D,
      hz.paste_vert (infinity_square R c D).flip,hd⟩
    rw [Scheme.Hom.comp_apply,hy,hb]
/-- This is the actual invertible kernel sheaf O(-D). The dual O(D),
its Abel class and its Jacobian identification are separate consumers. -/
@[expose] def idealLine : LineSheafClass318.Line (ContactOriginalRelativePolynomialCharts318.curve R c) :=
  ActualCartierIdealLine318.line (into R c D) (regular_charts R c D hf hi)
lemma idealLine_object : (idealLine R c D hf hi).object=ActualClosedIdealModule318.object (into R c D) := rfl
@[expose] def inclusion : (idealLine R c D hf hi).object ⟶
    SheafOfModules.unit (ContactOriginalRelativePolynomialCharts318.curve R c).ringCatSheaf :=
  ActualCartierIdealLine318.inclusion (into R c D) (regular_charts R c D hf hi)
end ContactProjectiveQuotientCartier318
