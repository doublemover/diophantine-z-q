module
public import Mathlib.Data.Complex.Basic
public import Mathlib.RingTheory.AlgebraicIndependent.TranscendenceBasis
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra
public import Mathlib.RingTheory.Algebraic.Integral
public import Mathlib.RingTheory.EssentialFiniteness
public section
noncomputable section
namespace IndependentPairGenericFinite318
open scoped nonZeroDivisors
variable (A:Type) [CommRing A] [IsDomain A] [Algebra ℂ A]
variable (x:Fin 2→A)
@[expose] def PolynomialBase:Subalgebra ℂ A:=Algebra.adjoin ℂ (Set.range x)
abbrev RationalBase:=FractionRing (PolynomialBase A x)
abbrev FunctionField:=FractionRing A
attribute [local instance] FractionRing.liftAlgebra FractionRing.isScalarTower_liftAlgebra

/-- A third transcendental element would extend the ACTUAL independent
pair to three independent elements. Thus the entire original ring is
algebraic over the actual subalgebra generated by this specified pair. -/
theorem algebraic_over_pair(hx:AlgebraicIndependent ℂ x)
    (hd:Algebra.trdeg ℂ A≤2):Algebra.IsAlgebraic (PolynomialBase A x) A:=by
  constructor
  intro a
  by_contra ha
  have hi:AlgebraicIndependent ℂ (fun o:Option (Fin 2)=>o.elim a x):=
    (hx.option_iff_transcendental a).mpr ha
  have hc:=hi.cardinalMk_le_trdeg.trans hd
  norm_num at hc

/-- The base is genuinely the two-variable rational function field,
with its polynomial coordinates mapped to the specified original pair. -/
@[expose] def rationalEquivalence(hx:AlgebraicIndependent ℂ x):
    FractionRing (MvPolynomial (Fin 2) ℂ)≃ₐ[ℂ]RationalBase A x:=
  IsFractionRing.algEquivOfAlgEquiv
    (show MvPolynomial (Fin 2) ℂ ≃ₐ[ℂ] PolynomialBase A x from hx.aevalEquiv)
lemma rational_coordinate(hx:AlgebraicIndependent ℂ x)(i:Fin 2):
    algebraMap (RationalBase A x) (FunctionField A)
      (rationalEquivalence A x hx
        (algebraMap (MvPolynomial (Fin 2) ℂ) _ (MvPolynomial.X i)))=
      algebraMap A (FunctionField A) (x i):=by
  rw [rationalEquivalence,IsFractionRing.algEquivOfAlgEquiv_algebraMap]
  rw [←IsScalarTower.algebraMap_apply (PolynomialBase A x) (RationalBase A x) (FunctionField A),
    IsScalarTower.algebraMap_apply (PolynomialBase A x) A (FunctionField A)]
  congr 1
  simpa only [MvPolynomial.aeval_X] using hx.algebraMap_aevalEquiv (MvPolynomial.X i)

/-- The SAME original fraction field is algebraic over the specified
rational base, with the actual inclusion scalar tower. -/
theorem fraction_algebraic(hx:AlgebraicIndependent ℂ x)
    (hd:Algebra.trdeg ℂ A≤2):
    Algebra.IsAlgebraic (RationalBase A x) (FunctionField A):=by
  letI:Algebra.IsAlgebraic (PolynomialBase A x) A:=algebraic_over_pair A x hx hd
  letI:Algebra.IsAlgebraic A (FunctionField A):=
    IsLocalization.isAlgebraic (FunctionField A) A⁰
  letI:Algebra.IsAlgebraic (PolynomialBase A x) (FunctionField A):=
    Algebra.IsAlgebraic.trans (PolynomialBase A x) A (FunctionField A)
  exact Algebra.IsAlgebraic.extendScalars
    (IsFractionRing.injective (PolynomialBase A x) (RationalBase A x))

/-- Actual finite type of the whole chart makes its genuine fraction
field essentially finite type. Algebraicity over the specified pair
then gives a FINITE field extension, not merely a transcendence bound. -/
theorem finite_generic_degree [Algebra.FiniteType ℂ A]
    (hx:AlgebraicIndependent ℂ x)(hd:Algebra.trdeg ℂ A≤2):
    Module.Finite (RationalBase A x) (FunctionField A):=by
  letI:Algebra.EssFiniteType A (FunctionField A):=
    Algebra.EssFiniteType.of_isLocalization (FunctionField A) A⁰
  letI:Algebra.EssFiniteType ℂ (FunctionField A):=
    Algebra.EssFiniteType.comp ℂ A (FunctionField A)
  letI:Algebra.EssFiniteType (RationalBase A x) (FunctionField A):=
    Algebra.EssFiniteType.of_comp ℂ (RationalBase A x) (FunctionField A)
  letI:Algebra.IsAlgebraic (RationalBase A x) (FunctionField A):=
    fraction_algebraic A x hx hd
  exact Algebra.finite_of_essFiniteType_of_isAlgebraic
end IndependentPairGenericFinite318
