module
public import Mathlib.Data.Finset.Card
public import Mathlib.Data.Fintype.Prod
public section

namespace OriginalParityReferenceClassTable318

/-- Bits are sign, valuation at 2, valuation at 3, valuation at the
single positive reference prime. They denote the literal signed integer
(-1)^s 2^i 3^j n^k, not an auxiliary descent labeling. -/
abbrev Word := Bool × Bool × Bool × Bool
abbrev Labels := Word × Word

def signBit (a : Word) : Bool := a.1
def bitTwo (a : Word) : Bool := a.2.1
def bitThree (a : Word) : Bool := a.2.2.1
def bitPrime (a : Word) : Bool := a.2.2.2

def signed (b : Bool) : ℤ := if b then -1 else 1
def factor (p : ℤ) (b : Bool) : ℤ := if b then p else 1

def label (n : ℕ) (a : Word) : ℤ :=
  signed (signBit a) * factor 2 (bitTwo a) * factor 3 (bitThree a) *
    factor (n : ℤ) (bitPrime a)

/-- The literal class of the first factor has positive sign over the reals. -/
def realFilter (z : Labels) : Bool := !(signBit z.1)

/-- The second factor is square over Q₃. Its stripped unit is 1 mod 3;
the first local class is unrestricted on these two references. -/
def threeFilter (n : ℕ) (z : Labels) : Bool :=
  !(bitThree z.2) && decide
    ((signed (signBit z.2) * factor 2 (bitTwo z.2) *
      factor (n : ℤ) (bitPrime z.2)) % 3 = 1)

/-- Nonzero square residues at the only two reference primes. -/
def primeSquare (n : ℕ) (u : ℤ) : Bool :=
  if n = 11 then decide (u % 11 ∈ [1, 3, 4, 5, 9])
  else decide (u % 23 ∈ [1, 2, 3, 4, 6, 8, 9, 12, 13, 16, 18])

def primeUnit (a : Word) : ℤ :=
  signed (signBit a) * factor 2 (bitTwo a) * factor 3 (bitThree a)

/-- At n, the four actual torsion classes are generated by (n,1)
and (3,-n). The stripped first unit has trivial class since 3 is
a square mod n; the stripped second unit has class (-1)^(v_n B). -/
def primeFilter (n : ℕ) (z : Labels) : Bool :=
  primeSquare n (primeUnit z.1) &&
    primeSquare n (primeUnit z.2 * signed (bitPrime z.2))

def oddUnit (n : ℕ) (a : Word) : ℤ :=
  signed (signBit a) * factor 3 (bitThree a) * factor (n : ℤ) (bitPrime a)

/-- The local dyadic images at these references have zero valuation bit
in each slot, all four first units, and second units 1 or 5 modulo 8. -/
def twoFilter (n : ℕ) (z : Labels) : Bool :=
  !(bitTwo z.1) && !(bitTwo z.2) &&
    decide ((oddUnit n z.2) % 8 ∈ [1, 5])

def full : Finset Labels := Finset.univ
def afterReal : Finset Labels := full.filter (fun z => realFilter z = true)
def afterThree (n : ℕ) : Finset Labels :=
  afterReal.filter (fun z => threeFilter n z = true)
def afterPrime (n : ℕ) : Finset Labels :=
  (afterThree n).filter (fun z => primeFilter n z = true)
def afterTwo (n : ℕ) : Finset Labels :=
  (afterPrime n).filter (fun z => twoFilter n z = true)

/-- Exactly the four positive first classes 1,3,n,3n and the two
second classes 1,-n. -/
def finalFilter (z : Labels) : Bool :=
  !(signBit z.1) && !(bitTwo z.1) && !(bitTwo z.2) && !(bitThree z.2) &&
    decide (signBit z.2 = bitPrime z.2)

def finalLabels : Finset Labels := full.filter (fun z => finalFilter z = true)

set_option maxRecDepth 8192

theorem square_residues11 : ∀ a : Fin 11,
    (a.val : ℤ) ∈ [1, 3, 4, 5, 9] ↔
      ∃ b : Fin 11, b.val ≠ 0 ∧ b.val * b.val % 11 = a.val := by decide

theorem square_residues23 : ∀ a : Fin 23,
    (a.val : ℤ) ∈ [1, 2, 3, 4, 6, 8, 9, 12, 13, 16, 18] ↔
      ∃ b : Fin 23, b.val ≠ 0 ∧ b.val * b.val % 23 = a.val := by decide

theorem initial_counts : full.card = 256 ∧ afterReal.card = 128 := by decide

theorem counts11 : (afterThree 11).card = 32 ∧ (afterPrime 11).card = 16 ∧
    (afterTwo 11).card = 8 := by decide

theorem counts23 : (afterThree 23).card = 32 ∧ (afterPrime 23).card = 16 ∧
    (afterTwo 23).card = 8 := by decide

theorem final11 : afterTwo 11 = finalLabels := by decide
theorem final23 : afterTwo 23 = finalLabels := by decide

end OriginalParityReferenceClassTable318
