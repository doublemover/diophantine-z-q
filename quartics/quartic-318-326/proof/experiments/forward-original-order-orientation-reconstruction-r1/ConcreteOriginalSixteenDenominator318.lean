/-- Only the x-coordinate is needed for the actual denominator test;
the group identity is certified from the exact8R affine point. -/
lemma coordinate : ((16:ℤ) • R).xRep 0=x16 := by
  obtain ⟨hn,hp⟩:=multiple8
  have hy : y8≠0 := by
    intro hz
    have hh:=congrArg QuadraticAlgebra.re hz
    norm_num [y8,pair] at hh
  have hm : (16:ℤ) • R=(8:ℤ) • R+(8:ℤ) • R := by rw [←add_zsmul];norm_num
  rw [hm,hp]
  exact GlobalDoubleCoordinateCertificate318.double_x x8 y8 slope16 x16 hn hy
    (by ext <;> norm_num [slope16,x8,y8,D,i,pair,pow_succ])
    (by ext <;> norm_num [slope16,x8,x16,pair,pow_succ])
/-- Exact arithmetic in canonical rational denominators, not a residue
order probe. The output is reused for BOTH original selected embeddings. -/
lemma denominator_mod : multipleDenominator 16%9649=7229 := by
  unfold multipleDenominator pointDenominator
  rw [coordinate]
  norm_num [denominator,x16,pair]
lemma nondivisibility : ¬9649∣multipleDenominator 16 := by
