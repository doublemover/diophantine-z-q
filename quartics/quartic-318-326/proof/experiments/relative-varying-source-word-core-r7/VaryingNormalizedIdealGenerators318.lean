module
public import VaryingWordIdealOverlap318
public section
noncomputable section
namespace VaryingNormalizedIdealGenerators318
open VaryingNormalizedWordFrame318 CyclicQuotientEvaluation318
open scoped TensorProduct
universe u
variable (R A ι : Type u) [CommRing R] [CommRing A] [Algebra R A]
  [Fintype ι] [DecidableEq ι] (w : ι → List A)
variable (S : Type u) [CommRing S] [Algebra R S]
variable (d : VaryingNormalizedWordParameter318.Point R A ι w S)
local notation "B" => (S ⊗[R] A)
local notation "F" => framed R A ι w S d
@[expose] def evaluate : B →ₗ[S] (ι → S) := evaluation F.action F.marked
@[expose] def sectionMap : (ι → S) →ₗ[S] B :=
  (VaryingSourceWordQuotient318.standardBasis ι S).constr S
    (fun j => (1 : S) ⊗ₜ[R] (w j).prod)
lemma section_formula (x : ι → S) :
    sectionMap R A ι w S x=∑ j, x j ⊗ₜ[R] (w j).prod := by
  simp only [sectionMap,Module.Basis.constr_apply_fintype,VaryingSourceWordQuotient318.standardBasis,
    Module.Basis.equivFun_ofEquivFun,LinearEquiv.refl_apply,TensorProduct.smul_tmul',smul_eq_mul,mul_one]
lemma evaluation_section : (evaluate R A ι w S d).comp (sectionMap R A ι w S)=LinearMap.id := by
  apply (VaryingSourceWordQuotient318.standardBasis ι S).ext
  intro j
  rw [LinearMap.comp_apply,show sectionMap R A ι w S
    ((VaryingSourceWordQuotient318.standardBasis ι S) j)=(1 : S) ⊗ₜ[R] (w j).prod from
      Module.Basis.constr_basis _ S _ j]
  change evaluation F.action F.marked ((1 : S) ⊗ₜ[R] (w j).prod)=
    (VaryingSourceWordQuotient318.standardBasis ι S) j
  exact (normalized R A ι w S d j).trans
    (congrFun (Module.Basis.coe_ofEquivFun (LinearEquiv.refl S (ι → S))) j).symm

@[expose] def defect : B →ₗ[S] B := LinearMap.id-(sectionMap R A ι w S).comp (evaluate R A ι w S d)
@[expose] def relation (a : A) : B := defect R A ι w S d ((1 : S) ⊗ₜ[R] a)
@[expose] def relations : Ideal B := Ideal.span (Set.range (relation R A ι w S d))
lemma evaluation_defect (z : B) : evaluate R A ι w S d (defect R A ι w S d z)=0 := by
  change evaluate R A ι w S d (z-sectionMap R A ι w S (evaluate R A ι w S d z))=0
  rw [map_sub,show evaluate R A ι w S d
      (sectionMap R A ι w S (evaluate R A ι w S d z))=evaluate R A ι w S d z from
    congrArg (fun f : (ι → S) →ₗ[S] (ι → S) => f (evaluate R A ι w S d z))
      (evaluation_section R A ι w S d),sub_self]
lemma defect_mem (z : B) : defect R A ι w S d z ∈ relations R A ι w S d := by
  induction z using TensorProduct.induction_on with
  | zero => rw [map_zero]; exact Ideal.zero_mem _
  | add x y hx hy => rw [map_add]; exact Ideal.add_mem _ hx hy
  | tmul s a =>
    have hs : s ⊗ₜ[R] a=s • ((1 : S) ⊗ₜ[R] a) := by
      simp only [TensorProduct.smul_tmul',smul_eq_mul,mul_one]
    rw [hs,map_smul]
    exact ((relations R A ι w S d).restrictScalars S).smul_mem s
      (Ideal.subset_span (Set.mem_range_self a))

/-- The full normalized quotient ideal is generated by explicit original
source-element relations, not only their fibres or radical. -/
lemma ideal_eq_relations : ideal F.action F.marked=relations R A ι w S d := by
  apply le_antisymm
  · intro z hz
    have he : evaluate R A ι w S d z=0 := hz
    have hd : defect R A ι w S d z=z := by
      change z-sectionMap R A ι w S (evaluate R A ι w S d z)=z
      rw [he,map_zero,sub_zero]
    exact hd ▸ defect_mem R A ι w S d z
  · apply Ideal.span_le.mpr
    rintro z ⟨a,rfl⟩
    exact evaluation_defect R A ι w S d ((1 : S) ⊗ₜ[R] a)
end VaryingNormalizedIdealGenerators318
