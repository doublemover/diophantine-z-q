module
public import PELOriginalWholeSectionRatioDependence318
public import Mathlib.RingTheory.AlgebraicIndependent.Transcendental
public section
noncomputable section
namespace PELOriginalWholeSectionRatioAlgebraic318
open PELOriginalGradedSectionRing318 PELOriginalSectionMultiplication318
variable (τ : ℂ) (hτ : 0 < τ.im)

/-- An independent pair of actual same-degree full-section ratios controls
EVERY third such ratio algebraically. The coefficient algebra is the literal
subalgebra generated by that pair in the same field, not a replacement field. -/
theorem isAlgebraic {K : Type*} [Field K] [Algebra ℂ K]
    (F : Ring τ hτ →ₐ[ℂ] K) (D : ℕ) (hd : 0 < D)
    (B : homogeneous τ hτ D) (A : Fin 2 → homogeneous τ hτ D)
    (hden : F (includeDegree τ hτ D B) ≠ 0)
    (hind : AlgebraicIndependent ℂ
      (fun i => F (includeDegree τ hτ D (A i)) / F (includeDegree τ hτ D B)))
    (s : homogeneous τ hτ D) :
    IsAlgebraic
      (Algebra.adjoin ℂ (Set.range
        (fun i => F (includeDegree τ hτ D (A i)) / F (includeDegree τ hτ D B))))
      (F (includeDegree τ hτ D s) / F (includeDegree τ hτ D B)) := by
  classical
  by_contra ht
  have hi := (hind.option_iff_transcendental _).mpr ht
  let e : Fin 3 ≃ Option (Fin 2) := Fintype.equivOfCardEq (by simp)
  apply PELOriginalWholeSectionRatioDependence318.not_algebraicIndependent τ hτ F D hd B
    (fun i => (e i).elim s A) hden
  convert hi.comp e e.injective using 1
  funext i
  cases e i <;> rfl
end PELOriginalWholeSectionRatioAlgebraic318
