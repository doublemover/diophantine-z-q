module
public import Mathlib.FieldTheory.Minpoly.IsIntegrallyClosed
public import Mathlib.RingTheory.Finiteness.Basic
public section
noncomputable section
namespace FiniteNormalBaseMonogenicSuborder318
open Polynomial Algebra
variable (R A : Type*) [CommRing R] [IsDomain R] [IsIntegrallyClosed R]
  [CommRing A] [IsDomain A] [Algebra R A] [IsTorsionFree R A] [Module.Finite R A]

/-- The literal minimal polynomial over the WHOLE normal base. No
base denominator or discriminant is inverted. -/
lemma monic (t : A) : (minpoly R t).Monic :=
  minpoly.monic (IsIntegral.of_finite R t)

/-- The actual monogenic suborder generated by the chosen original
element, embedded into the whole original finite algebra. -/
@[expose] def embedding (t : A) : AdjoinRoot (minpoly R t) →ₐ[R] A :=
  (Algebra.adjoin R ({t} : Set A)).val.comp
    (minpoly.equivAdjoin (IsIntegral.of_finite R t)).toAlgHom

lemma embedding_injective (t : A) : Function.Injective (embedding R A t) :=
  Subtype.val_injective.comp (minpoly.equivAdjoin (IsIntegral.of_finite R t)).injective

lemma embedding_root (t : A) : embedding R A t (AdjoinRoot.root (minpoly R t)) = t := by
  change ↑(Minpoly.toAdjoin R t (AdjoinRoot.mk (minpoly R t) X)) = t
  exact Minpoly.coe_toAdjoin_mk_X

/-- The whole original algebra is finite over this actual monogenic
suborder, not merely integral after passing to its fraction field. -/
lemma embedding_finite (t : A) : (embedding R A t).Finite := by
  have hc : (embedding R A t).toRingHom.comp
      (algebraMap R (AdjoinRoot (minpoly R t))) = algebraMap R A := by
    ext r
    exact (embedding R A t).commutes r
  apply RingHom.Finite.of_comp_finite (f := algebraMap R (AdjoinRoot (minpoly R t)))
  rw [hc]
  exact RingHom.finite_algebraMap.mpr inferInstance
end FiniteNormalBaseMonogenicSuborder318
