module
public import PELOriginalGradedSectionRing318
public import PELOriginalSectionDegreeZero318
public import HomogeneousSectionMarker318
public section
noncomputable section
namespace PELOriginalFullSectionImageGrowth318
open PELOriginalGradedSectionRing318 PELOriginalSectionMultiplication318
variable (τ : ℂ) (hτ : 0 < τ.im) {σ : Type*} (D : ℕ)
  (s : σ → homogeneous τ hτ D)

/-- Any family of genuine whole H0 sections of the same original degree,
not necessarily products of cubic generators. -/
@[expose] def presentation : MvPolynomial σ ℂ →ₐ[ℂ] Ring τ hτ :=
  MvPolynomial.aeval (fun i => includeDegree τ hτ D (s i))
lemma underlying_presentation (p : MvPolynomial σ ℂ) :
    (presentation τ hτ D s p).val =
      HomogeneousSectionMarker318.marker D (algebraMap ℂ (Values τ)) (fun i => (s i).val) p := by
  have he : (sectionAlgebra τ hτ).val.comp (presentation τ hτ D s) =
      MvPolynomial.aeval (fun i => Polynomial.monomial D (s i).val) := by
    apply MvPolynomial.algHom_ext
    intro i
    simp only [AlgHom.comp_apply,presentation,MvPolynomial.aeval_X]
    rfl
  exact congrArg (fun f : MvPolynomial σ ℂ →ₐ[ℂ] Polynomial (Values τ) => f p) he

@[expose] def degreePiece (n : ℕ) : Submodule ℂ (Ring τ hτ) :=
  (MvPolynomial.homogeneousSubmodule σ ℂ n).map (presentation τ hτ D s).toLinearMap
@[expose] def sectionCoefficient (n : ℕ) : Ring τ hτ →ₗ[ℂ] homogeneous τ hτ (D*n) where
  toFun p := ⟨p.val.coeff (D*n),p.property _⟩
  map_add' p q := by apply Subtype.ext; exact Polynomial.coeff_add _ _ _
  map_smul' c p := by apply Subtype.ext; exact Polynomial.coeff_smul _ _ _
@[expose] def intoOriginalHZero (n : ℕ) :
    degreePiece τ hτ D s n →ₗ[ℂ] homogeneous τ hτ (D*n) :=
  (sectionCoefficient τ hτ D n).comp (degreePiece τ hτ D s n).subtype

lemma reconstruct (n : ℕ) (a : degreePiece τ hτ D s n) :
    includeDegree τ hτ (D*n) (intoOriginalHZero τ hτ D s n a) = a.val := by
  obtain ⟨p,hp,hpa⟩ := a.property
  apply Subtype.ext
  change Polynomial.monomial (D*n) (a.val.val.coeff (D*n)) = a.val.val
  rw [← hpa,underlying_presentation,HomogeneousSectionMarker318.homogeneous_marker _ _ _ p n hp,
    Polynomial.coeff_monomial_same]
lemma intoOriginalHZero_injective (n : ℕ) :
    Function.Injective (intoOriginalHZero τ hτ D s n) := by
  intro a b h
  apply Subtype.ext
  rw [← reconstruct τ hτ D s n a,← reconstruct τ hτ D s n b,h]

instance pieceFinite (n : ℕ) : FiniteDimensional ℂ (degreePiece τ hτ D s n) := by
  by_cases hn : D*n=0
  · haveI : FiniteDimensional ℂ (homogeneous τ hτ (D*n)) := by rw [hn]; infer_instance
    exact FiniteDimensional.of_injective (intoOriginalHZero τ hτ D s n)
      (intoOriginalHZero_injective τ hτ D s n)
  · letI : NeZero (D*n) := ⟨hn⟩
    exact FiniteDimensional.of_injective (intoOriginalHZero τ hτ D s n)
      (intoOriginalHZero_injective τ hτ D s n)

/-- The full original H0 dimension bounds every finite homogeneous image,
including images generated by genuinely new full sections. -/
theorem whole_growth_bound (n : ℕ) :
    Module.finrank ℂ (degreePiece τ hτ D s n) ≤ if D*n=0 then 1 else (D*n)^2 := by
  by_cases hn : D*n=0
  · haveI : FiniteDimensional ℂ (homogeneous τ hτ (D*n)) := by rw [hn]; infer_instance
    simpa only [PELOriginalSectionDegreeZero318.whole_hilbert_function] using
      (LinearMap.finrank_le_finrank_of_injective (intoOriginalHZero_injective τ hτ D s n))
  · letI : NeZero (D*n) := ⟨hn⟩
    simpa only [PELOriginalSectionDegreeZero318.whole_hilbert_function] using
      (LinearMap.finrank_le_finrank_of_injective (intoOriginalHZero_injective τ hτ D s n))
end PELOriginalFullSectionImageGrowth318
