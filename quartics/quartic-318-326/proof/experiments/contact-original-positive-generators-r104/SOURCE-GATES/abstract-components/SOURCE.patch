+/-- Evaluate the canonical over-open comparison with an arbitrary morphism
+kept abstract, before substituting the concrete untwisting equivalence. -/
+private lemma overComparison_apply {X : Scheme.{u}} (M N : X.Modules)
+    (W : X.Opens) (f : M.over W ⟶ N.over W) (P : W.toScheme.Modules)
+    (t : P ⟶ M.restrict W.ι) (Z : W.toScheme.Opens) (s : Γ(P,Z)) :
+    (((t ≫ ((Scheme.Modules.overFunctorEquiv W).app M).inv) ≫
+      (Scheme.Modules.overEquiv W).functor.map f ≫
+        ((Scheme.Modules.overFunctorEquiv W).app N).hom).app Z) s =
+      (f.val.app (op (Over.mk (homOfLE (show W.ι ''ᵁ Z ≤ W from by
+        simpa using W.ι.image_le_opensRange Z))))) (t.app Z s) := by
+  rfl
+
+/-- The canonical over-open restriction acts on the same component, with
+its input isomorphism abstract rather than unfolded through its preimage. -/
+private lemma overRestriction_apply {X : Scheme.{u}} (M N : X.Modules)
+    (U W : X.Opens) (h : W ≤ U) (g : M.over U ≅ N.over U)
+    (V : X.Opens) (hV : V ≤ W) (s : Γ(M,V)) :
+    ((((SheafOfModules.overFunctorMap (R:=X.ringCatSheaf) (homOfLE h)).app M).symm ≪≫
+      (SheafOfModules.overMap X.ringCatSheaf (homOfLE h)).mapIso g ≪≫
+        (SheafOfModules.overFunctorMap (R:=X.ringCatSheaf) (homOfLE h)).app N).hom.val.app
+          (op (Over.mk (homOfLE hV)))) s =
+      (g.hom.val.app (op (Over.mk (homOfLE (hV.trans h))))) s := by
+  rfl
+
