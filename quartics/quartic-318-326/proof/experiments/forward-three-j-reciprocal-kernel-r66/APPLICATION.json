  "obligations": [
    {
      "name": "Recovery of whole ideals",
      "required_input": "Agreement on a punctured chart does not imply equality of arbitrary whole-chart ideals.",
      "constructed_input": "PrincipalLocalizationIdealRecovery318 proves exact extension-contraction when the parameter is a unit modulo the ideal, then compares two such ideals.",
      "justification": "Localization ideal membership supplies a power multiplier; cancellation takes place in the actual quotient ring. No radical or closed-point substitution is used.",
      "sources": [
        "PrincipalLocalizationIdealRecovery318.lean"
      ]
    },
    {
      "name": "Proposed reciprocal ideal saturation",
      "required_input": "The proposed equation needs its own saturation certificate.",
      "constructed_input": "The exact infinityEquation plus X times the explicit cubic inverseCoordinate is1.",
      "justification": "The resulting inverse in the quotient by span infinityEquation proves the second saturation premise, retaining all polynomial multiplicities.",
      "sources": [
        "ThreeJReciprocalKernelCertificate318.lean"
      ]
    },
    {
      "name": "Actual affine coordinates and support",
      "required_input": "The actual ideal-sheaf restriction must be related to its full scheme-prime support.",
      "constructed_input": "coordinates is defined through the canonical GammaSpecIso inverse; support_coordinates proves the corresponding zero locus identity.",
      "justification": "The actual affine ideal-sheaf equivalence and Spec zero-locus theorem identify these sets without choosing new chart maps.",
      "sources": [
        "AffineIdealCoordinates318.lean"
      ]
    },
    {
      "name": "Actual reciprocal saturation",
      "required_input": "The actual restricted global ideal needs a quotient-unit proof independent of the proposed polynomial.",
      "constructed_input": "Its support lies in the punctured reciprocal chart because the actual global closed scheme lies in the original finite chart.",
      "justification": "The full original chart intersection gives D(X); zero-locus emptiness then proves I plus span X is top, yielding an explicit quotient inverse.",
      "sources": [
        "ThreeJReciprocalKernelSupport318.lean",
        "AffineIdealCoordinates318.lean"
      ]
    },
    {
      "name": "Restriction and canonical ring maps",
      "required_input": "Scheme ideal restriction must commute with the actual affine-coordinate maps.",
      "constructed_input": "AffineIdealLocalization318 proves restriction is ideal extension by the actual global-section map, then transports through the canonical GammaSpecIso maps.",
      "justification": "The open-image isomorphism and GammaSpecIso inverse naturality preserve the literal Spec map, not just an abstract ring isomorphism.",
      "sources": [
        "AffineIdealLocalization318.lean"
      ]
    },
    {
      "name": "Exact original Laurent overlap",
      "required_input": "Both restrictions must come from the same global object on the same intersection.",
      "constructed_input": "actual_overlap applies global ideal comap to the original projective maps_agree and computes its canonical affine coordinates.",
      "justification": "It equates the actual reciprocal extension through aeval S and actual finite extension through the canonical algebra map on the entire Laurent ring.",
      "sources": [
        "ThreeJWholeReciprocalKernel318.lean"
      ]
    },
    {
      "name": "Whole reciprocal equality and cusp consumer",
      "required_input": "The entire reciprocal chart, including its origin, must be recovered before joining its cusp differential module.",
      "constructed_input": "The actual Laurent inversion maps S to T and converts both extensions to canonical X localization. Whole reciprocal equation follows by the two quotient-unit certificates.",
      "justification": "infinity_cusp_join now uses extension of the actual global reciprocal coordinate ideal as the full literal relative differential annihilator under the actual1/j target action.",
      "sources": [
        "ThreeJWholeReciprocalKernel318.lean"
      ]
    },
    {
      "name": "Frozen predecessors and exact source identity",
      "required_input": "A new join cannot change the previous original scheme or silently treat pending code as accepted.",
      "constructed_input": "105 unchanged sources; ActualThreeJQDiscGerms318 proves exact qGerm function identities and retains the same cusp index when simplifying conditionals.",
      "justification": "The204 run passes manifold holomorphy and fails only curried function/conditional and cusp-index rewrites. No q-disc, map or order statement changes.",
      "sources": [
        "INHERITANCE.json",
        "README.md",
        "intake.json"
      ]
    },
    {
      "name": "Explicit remaining global sheaf boundary",
      "required_input": "Three local module annihilator joins do not automatically identify a globally sheafified differential or Fitting object.",
      "constructed_input": "The actual global closed kernel now has exact equations on both entire original affine charts and matches all three literal relative differential module annihilators.",
      "justification": "A global relative-differential sheaf identification and its Fitting/annihilator ideal-sheaf equality remain separate next obligations. No PEL, full integral model or full318/326 theorem is claimed.",
