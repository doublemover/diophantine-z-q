+        (infinitySections c L) ⟶ ContactCommonLaurentModule318.common c L => f x)
+    (ContactCommonLaurentModule318.transition_recovery c L)
+  rw [ModuleCat.comp_apply] at hrec
+  rw [← hrec]
+  simp only [coordinates, ContactOriginalLaurentCoordinates318.rawTransition,
+    LinearEquiv.trans_apply, inverse_hom_apply, LinearEquiv.symm_apply_apply,
+    Iso.toLinearEquiv_apply]
 
