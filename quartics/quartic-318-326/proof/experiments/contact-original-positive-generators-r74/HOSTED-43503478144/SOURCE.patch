+      (infinitySections c L)) :
+    coordinates c L ((ContactCommonLaurentModule318.infinityIso c L).hom x) =
+      ContactOriginalLaurentCoordinates318.rawTransition c L
+        (ContactOriginalLaurentCoordinates318.infinityCoordinates c L x) := by
+  have hrec := congrArg
