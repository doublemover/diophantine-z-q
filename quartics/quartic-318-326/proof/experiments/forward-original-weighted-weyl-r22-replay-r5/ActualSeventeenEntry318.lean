lemma unit_depth (r : ℕ) (a b : ℤ) (ha : ¬(17:ℤ)∣a) (hb : ¬(17:ℤ)∣b) :
    padicValRat 17 ((17:ℚ)^r*((a:ℚ)/(b:ℚ)))=(r:ℤ) := by
  have ha0 : a≠0 := fun h => ha (h ▸ dvd_zero _)
  have hb0 : b≠0 := fun h => hb (h ▸ dvd_zero _)
  rw [padicValRat.mul (pow_ne_zero _ (by norm_num))
      (div_ne_zero (by exact_mod_cast ha0) (by exact_mod_cast hb0)),
    padicValRat.pow,padicValRat.self (by norm_num),AnchorNorm318.rational_unit_value 17 a b ha hb]
  ring

theorem u_real_depth : padicValRat 17 (chartU 20).re=1 := by
  have he := unit_depth 1 (-) ()
    (by norm_num [Int.dvd_iff_emod_eq_zero]) (by norm_num [Int.dvd_iff_emod_eq_zero])
  rw [actual20.1]
  convert he using 1 <;> norm_num [u20,v20,pair]

theorem u_imaginary_depth : padicValRat 17 (chartU 20).im=1 := by
  have he := unit_depth 1 () ()
    (by norm_num [Int.dvd_iff_emod_eq_zero]) (by norm_num [Int.dvd_iff_emod_eq_zero])
  rw [actual20.1]
  convert he using 1 <;> norm_num [u20,v20,pair]

