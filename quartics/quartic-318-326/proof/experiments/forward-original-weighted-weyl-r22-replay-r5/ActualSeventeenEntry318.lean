/-- Actual roots for the two17-adic embeddings, obtained from the simple
residue root6. The negative embedding is the exact conjugate. -/
theorem square_root_two : ∃ ρ : ℚ_[17], ρ^2=2 :=
  InertHensel318.square_root_lift 17 (by norm_num) ⟨6,by norm_num⟩

