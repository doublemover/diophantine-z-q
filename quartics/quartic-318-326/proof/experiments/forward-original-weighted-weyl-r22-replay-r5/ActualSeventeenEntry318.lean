theorem actual1 : chartU 1=u1 ∧ chartV 1=v1 := by
  constructor
  · rw [GeneratorScalarProgression318.chartU_one] <;> rfl
  · rw [ScalarTranslatedIndex318.chartV_one]
    ext <;> norm_num [v1,CompressedOrientation318.k,CompressedOrientation318.m,
      pair,pow_succ,QuadraticAlgebra.norm_def]

theorem actual2 : chartU 2=u2 ∧ chartV 2=v2 := by
  constructor
  · rw [show (2:ℤ)=1+1 by norm_num,CoherentAdditionV318.chartU_add]
    simp only [actual1.1,actual1.2]
    ext <;> norm_num [ReciprocalGroup318.sumU,u1,v1,u2,D,ConcreteG8Domain.i,pair,pow_succ,QuadraticAlgebra.norm_def]
  · rw [show (2:ℤ)=1+1 by norm_num,CoherentAdditionV318.chartV_add]
    simp only [actual1.1,actual1.2]
    ext <;> norm_num [ReciprocalGroup318.sumV,u1,v1,v2,D,ConcreteG8Domain.i,pair,pow_succ,QuadraticAlgebra.norm_def]

