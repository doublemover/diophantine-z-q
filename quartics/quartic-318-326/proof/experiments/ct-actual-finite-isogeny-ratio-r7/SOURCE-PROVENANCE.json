        "-    exact (map_ne_zero (algebraMap K A) a.ne_zero) hr.symm",
        "+    exact ((map_ne_zero (algebraMap K A)).mpr a.ne_zero) hr.symm",
        "   exact \u27e8Units.mk0 r hne,hr\u27e9",
        " ",
        "@@ -152,5 +156,6 @@\n",
        "     have hp := act_on_square_root K r a hr (show G from g)",
