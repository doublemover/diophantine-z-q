+    (k : X ⟶ Z) [IsOpenImmersion k] (h : f ≫ g = k)
+    (M : Z.Modules) (W : Z.Opens) (hW : k ''ᵁ ⊤ = W) (hi : W ≤ g ''ᵁ ⊤)
