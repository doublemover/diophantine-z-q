module
public import ProjectiveSectionFinitePresentation318
public import ProjectiveKernelFiniteEquations318
public section
noncomputable section
namespace ProjectiveKernelFinitePresentation318
universe u
variable (R P Q : Type u) [CommRing R] [AddCommGroup P] [Module R P]
  [AddCommGroup Q] [Module R Q] (d : P →ₗ[R] Q)
  [hpfinite : Module.Finite R P] [hpprojective : Module.Projective R P]
  [hqfinite : Module.Finite R Q] [hqprojective : Module.Projective R Q]

include hqfinite hqprojective in
/-- The SAME full linear kernel ideal is finitely generated by actual
finite dual-frame equations. No radical or geometric-point replacement. -/
lemma ideal_fg : (ProjectiveKernelParameter318.ideal R P Q d).FG := by
  rw [ProjectiveKernelFiniteEquations318.finite_equations R P Q d
    (FiniteProjectiveEvaluationFrame318.frame R Q)]
  exact Submodule.fg_span (Set.finite_range _)

include hpfinite hpprojective hqfinite hqprojective in
/-- Arbitrary finite-projective two-term kernels have an actual finitely
presented parameter, even when their kernel module is not projective. -/
instance finitePresentation : Algebra.FinitePresentation R (ProjectiveKernelParameter318.algebra R P Q d) :=
  Algebra.FinitePresentation.quotient (ideal_fg R P Q d)
end ProjectiveKernelFinitePresentation318
