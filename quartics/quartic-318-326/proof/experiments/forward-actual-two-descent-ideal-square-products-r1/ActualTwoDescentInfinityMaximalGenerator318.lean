module
public import ActualTwoDescentInfinityLocalParameter318
public section
noncomputable section
namespace ActualTwoDescentInfinityMaximalGenerator318
open ActualTwoDescentInfinityChartRing318 ActualTwoDescentInfinityLocalParameter318
variable {K : Type*} [Field K] [CharZero K]

/-- Exact ideal of the original chart origin, not an assumed local parameter ideal. -/
theorem actual_origin_ideal_generators (n : K) :
    originIdeal n=Ideal.span {chartU n,chartV n} := by
  let J : Ideal (InfinityChart n) := Ideal.span {chartU n,chartV n}
  let q : InfinityChart n →+* InfinityChart n ⧸ J := Ideal.Quotient.mk J
  have hu : q (chartU n)=0 := Ideal.Quotient.eq_zero_iff_mem.mpr
    (Ideal.subset_span (by simp))
  have hv : q (chartV n)=0 := Ideal.Quotient.eq_zero_iff_mem.mpr
    (Ideal.subset_span (by simp))
  have he : q=(q.comp (chartCoefficient n)).comp (originEvaluation n) := by
    apply AdjoinRoot.ringHom_ext
    · apply Polynomial.ringHom_ext
      · apply RingHom.ext
        intro a
        change q (chartCoefficient n a)=q (chartCoefficient n (originEvaluation n (chartCoefficient n a)))
        rw [actual_origin_coefficient]
      · change q (chartU n)=q (chartCoefficient n (originEvaluation n (chartU n)))
        rw [actual_origin_u,map_zero,map_zero,hu]
    · change q (chartV n)=q (chartCoefficient n (originEvaluation n (chartV n)))
      rw [actual_origin_v,map_zero,map_zero,hv]
  apply le_antisymm
  · intro a ha
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    change q a=0
    rw [he]
    change q (chartCoefficient n (originEvaluation n a))=0
    change originEvaluation n a=0 at ha
    rw [ha,map_zero,map_zero]
  · apply Ideal.span_le.mpr
    intro a ha
    rcases Set.mem_insert_iff.mp ha with rfl|ha
    · exact actual_origin_u n
    · have heq := Set.mem_singleton_iff.mp ha
      subst a
      exact actual_origin_v n

/-- The unique maximal ideal of the actual infinity local ring is
GENERATED by u. This follows from v=e*u^3 and the exact origin ideal. -/
theorem actual_infinity_maximal_principal (n : K) :
    IsLocalRing.maximalIdeal (InfinityLocalRing n)=Ideal.span {localU n} := by
  have hm : IsLocalRing.maximalIdeal (InfinityLocalRing n)=
      Ideal.span {localU n,localV n} := by
    rw [←Localization.AtPrime.map_eq_maximalIdeal,actual_origin_ideal_generators,
      Ideal.map_span,Set.image_pair]
    rfl
  rw [hm]
  apply le_antisymm
  · apply Ideal.span_le.mpr
    intro a ha
    rcases Set.mem_insert_iff.mp ha with rfl|ha
    · exact Ideal.subset_span (Set.mem_singleton _)
    · have heq := Set.mem_singleton_iff.mp ha
      subst a
      obtain ⟨e,he⟩ := actual_local_v_unit_cube n
      rw [he,Ideal.mem_span_singleton]
      refine ⟨(e : InfinityLocalRing n)*localU n^2,?_⟩
      ring
  · apply Ideal.span_mono
    intro a ha
    have heq := Set.mem_singleton_iff.mp ha
    subst a
    simp

end ActualTwoDescentInfinityMaximalGenerator318
