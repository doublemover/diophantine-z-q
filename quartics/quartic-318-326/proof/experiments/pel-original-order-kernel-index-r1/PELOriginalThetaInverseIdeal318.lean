module
public import IntegralInverseIdealImage318
public import PELOriginalThetaLocalNonzerodivisor318
public import LineSheafTensorPower318
public section
noncomputable section
namespace PELOriginalThetaInverseIdeal318
open AlgebraicGeometry CategoryTheory CategoryTheory.Limits LineSheafClass318
open PELOriginalReducedProjectiveCandidate318 PELOriginalMixedRatioCover318
open PELOriginalAlgebraicPolarizationLine318 PELOriginalThetaZeroScheme318
variable (τ : ℂ) (hτ : 0 < τ.im)
local instance candidateIntegral : IsIntegral (candidate τ hτ) := PELOriginalCandidateIntegral318.integral τ hτ
abbrev sectionLine := LineSheafTensorPower318.line (line τ hτ) 1
abbrev inverseSectionLine := FramedLineInverse318.inverse (sectionLine τ hτ)

/-- Genuine inverse-line multiplication by the ORIGINAL theta section,
using its exact power-one inverse-frame coefficients. -/
abbrev multiplication : (inverseSectionLine τ hτ).object ⟶
    SheafOfModules.unit (candidate τ hτ).ringCatSheaf :=
  FramedSectionInverseIdealMap318.hom (sectionLine τ hτ) (coefficient τ hτ) (compatible τ hτ)
instance multiplication_mono : Mono (multiplication τ hτ) :=
  IntegralInverseIdealImage318.mono (sectionLine τ hτ) (coefficient τ hτ) (compatible τ hτ)
    (PELOriginalThetaLocalNonzerodivisor318.coefficient_nonzero τ hτ)

/-- An actual submodule sheaf of the ORIGINAL structure sheaf, formed as
the categorical image of theta multiplication from the inverse line. -/
abbrev idealModule := image (multiplication τ hτ)
abbrev idealInclusion : idealModule τ hτ ⟶ SheafOfModules.unit (candidate τ hτ).ringCatSheaf :=
  image.ι (multiplication τ hτ)
@[expose] def inverseSectionIso : (inverseSectionLine τ hτ).object ≅ idealModule τ hτ :=
  IntegralInverseIdealImage318.iso (sectionLine τ hτ) (coefficient τ hτ) (compatible τ hτ)
    (PELOriginalThetaLocalNonzerodivisor318.coefficient_nonzero τ hτ)
@[reassoc] lemma inverseSectionIso_inclusion :
    (inverseSectionIso τ hτ).hom≫idealInclusion τ hτ=multiplication τ hτ :=
  IntegralInverseIdealImage318.iso_inclusion (sectionLine τ hτ) (coefficient τ hτ) (compatible τ hτ)
    (PELOriginalThetaLocalNonzerodivisor318.coefficient_nonzero τ hτ)

/-- A chosen actual isomorphism to the inverse of the SAME original L.
The choice uses proved sheaf isomorphism, not an analytic/class analogy. -/
@[expose] def inverseIso : (FramedLineInverse318.inverse (line τ hτ)).object ≅ idealModule τ hτ := by
  have h : classOf (FramedLineInverse318.inverse (line τ hτ))=
      classOf (inverseSectionLine τ hτ) := by
    rw [LineSheafClassGroup318.classOf_inverse,LineSheafClassGroup318.classOf_inverse,
      LineSheafTensorPower318.classOf_power,pow_one]
  exact Classical.choice ((classOf_eq_iff _ _).mp h) ≪≫ inverseSectionIso τ hτ

/-- Exact FULL section image on every smaller open, not just residue
values or generic sections. -/
lemma image_membership (a : NonemptyIndex τ hτ) (W : (candidate τ hτ).Opens)
    (hW : W≤opens τ hτ a) (r : Γ(candidate τ hτ,W)) :
    (∃ s : Γ(idealModule τ hτ,W),(idealInclusion τ hτ).app W s=r) ↔
      r∈Ideal.span {(candidate τ hτ).presheaf.map (homOfLE hW).op (coefficient τ hτ a)} :=
  IntegralInverseIdealImage318.local_range (sectionLine τ hτ) (coefficient τ hτ) (compatible τ hτ)
    (PELOriginalThetaLocalNonzerodivisor318.coefficient_nonzero τ hτ) a W hW r
lemma image_span (a : NonemptyIndex τ hτ) (W : (candidate τ hτ).Opens) (hW : W≤opens τ hτ a) :
    Ideal.span (Set.range ((idealInclusion τ hτ).app W))=
      Ideal.span {(candidate τ hτ).presheaf.map (homOfLE hW).op (coefficient τ hτ a)} := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro r ⟨s,hs⟩
    exact (image_membership τ hτ a W hW r).mp ⟨s,hs⟩
  · apply Ideal.span_le.mpr
    intro r hr
    rcases Set.mem_singleton_iff.mp hr with rfl
    obtain ⟨s,hs⟩ := (image_membership τ hτ a W hW _).mpr (Ideal.subset_span (Set.mem_singleton _))
    exact Ideal.subset_span ⟨s,hs⟩

/-- The full zero-scheme kernel on every smaller frame open is the
principal ideal sheaf of the literal restricted coefficient. -/
lemma zeroIdeal_subopen (a : NonemptyIndex τ hτ) (W : (candidate τ hτ).Opens)
    (hW : W≤opens τ hτ a) :
    (ideal τ hτ).comap W.ι=PrincipalIdealOpenRestriction318.principal
      ((LineFrameTopScalar318.ringTop W).inv
        ((candidate τ hτ).presheaf.map (homOfLE hW).op (coefficient τ hτ a))) := by
  rw [←Scheme.homOfLE_ι (candidate τ hτ) hW,Scheme.IdealSheafData.comap_comp,ideal_restriction,
    localIdeal,PrincipalFrameZeroOverlaps318.ideal,PrincipalIdealOpenRestriction318.comap_principal,
    PrincipalFrameZeroOverlaps318.coefficient_restriction]

/-- Exact comparison of the ENTIRE scheme kernel ideal with the genuine
inverse-line image: on every frame subopen it is generated by precisely
that image's actual sections under the original ringTop scalar map.
No radical, point-support or sectionwise categorical-image shortcut. -/
theorem ideal_line_comparison (a : NonemptyIndex τ hτ) (W : (candidate τ hτ).Opens)
    (hW : W≤opens τ hτ a) :
    (ideal τ hτ).comap W.ι=Scheme.IdealSheafData.ofIdealTop
      ((Ideal.span (Set.range ((idealInclusion τ hτ).app W))).map
        (LineFrameTopScalar318.ringTop W).inv.hom) := by
  rw [image_span τ hτ a W hW,Ideal.map_span,Set.image_singleton,zeroIdeal_subopen τ hτ a W hW]
  rfl

/-- Genuine rank-one frames on the entire original cover, transported
through the actual inverse-line image isomorphism. -/
@[expose] def idealLine : Line (candidate τ hτ) where
  object := idealModule τ hτ
  Index := NonemptyIndex τ hτ
  opens := opens τ hτ
  cover := coversTop τ hτ
  frame a := (inverseSectionLine τ hτ).frame a ≪≫
    (Scheme.Modules.restrictFunctor (opens τ hτ a).ι).mapIso (inverseSectionIso τ hτ)
lemma locallyFree : (idealModule τ hτ).IsLocallyFree :=
  ModuleFreeOpenFrames318.locallyFree (idealModule τ hτ) PUnit.{1} (opens τ hτ) (coversTop τ hτ)
    (fun a => CategoryTheory.Limits.coproductUniqueIso
      (fun _ : PUnit.{1} => SheafOfModules.unit (opens τ hτ a).toScheme.ringCatSheaf) ≪≫
      (idealLine τ hτ).frame a)
lemma ideal_class : classOf (idealLine τ hτ)=(classOf (line τ hτ))⁻¹ := by
  exact (classOf_eq (inverseIso τ hτ)).symm.trans
    (LineSheafClassGroup318.classOf_inverse (line τ hτ))

/-- Actual tensor cancellation for the full ideal module and SAME L.
This is an isomorphism of module sheaves, not a divisor-class label. -/
@[expose] def ideal_tensor_line :
    (LineSheafTensor318.line (idealLine τ hτ) (line τ hτ)).object ≅
      SheafOfModules.unit (candidate τ hτ).ringCatSheaf := by
  apply Classical.choice
  apply (LineSheafUnit318.eq_unitClass_iff _).mp
  rw [LineSheafClassGroup318.classOf_tensor,ideal_class,inv_mul_cancel]
end PELOriginalThetaInverseIdeal318
