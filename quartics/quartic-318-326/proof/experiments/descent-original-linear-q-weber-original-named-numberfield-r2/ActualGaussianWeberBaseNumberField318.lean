module
public import Mathlib.NumberTheory.Zsqrtd.GaussianInt
public import Mathlib.NumberTheory.NumberField.Basic
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
public import Mathlib.Tactic
public section
noncomputable section

namespace ActualGaussianWeberBaseNumberField318

open IntermediateField NumberField
open scoped IntermediateField

abbrev Base := FractionRing GaussianInt

/-- The actual comparison number field generated by the indicated
complex root, not a second freely chosen model of the Gaussian field. -/
abbrev Quadratic := ↥(ℚ⟮Complex.I⟯)

private theorem complex_i_integral : IsIntegral ℚ Complex.I := by
  have h : IsIntegral ℚ (Complex.I^2) := by
    rw [Complex.I_sq]
    exact isIntegral_one.neg
  exact IsIntegral.of_pow (by decide : 0 < (2:ℕ)) h

@[expose] def quadraticI : Quadratic := AdjoinSimple.gen ℚ Complex.I

theorem quadraticI_value : (quadraticI : ℂ) = Complex.I := by
  unfold quadraticI
  rfl

theorem quadraticI_mul : quadraticI * quadraticI = ((-1:ℤ):Quadratic) := by
  apply Subtype.ext
  change (quadraticI:ℂ)*(quadraticI:ℂ) = ((-1:ℤ):ℂ)
  rw [quadraticI_value,←pow_two,Complex.I_sq] <;> norm_num

@[expose] def intoQuadraticInteger : GaussianInt →+* Quadratic :=
  Zsqrtd.lift ⟨quadraticI,quadraticI_mul⟩

theorem intoQuadraticInteger_injective : Function.Injective intoQuadraticInteger := by
  unfold intoQuadraticInteger
  apply Zsqrtd.lift_injective
  intro n hn
  have h : 0 ≤ n*n := mul_self_nonneg n
  omega

@[expose] def intoQuadratic : Base →+* Quadratic :=
  IsFractionRing.lift intoQuadraticInteger_injective

/-- The Gaussian fraction field used in the signed-prime construction
is a number field in the literal stock instance sense. -/
theorem actual_gaussian_number_field : NumberField Base := by
  letI : CharZero Base :=
    CharZero.of_addMonoidHom intoQuadratic.toAddMonoidHom (by simp) intoQuadratic.injective
  letI : Algebra Base Quadratic := intoQuadratic.toAlgebra
  letI : IsScalarTower ℚ Base Quadratic := by
    apply IsScalarTower.of_algebraMap_eq
    intro x
    exact (intoQuadratic.map_rat_algebraMap x).symm
  letI : FiniteDimensional ℚ Quadratic := adjoin.finiteDimensional complex_i_integral
  exact ⟨inferInstance,FiniteDimensional.left ℚ Base Quadratic⟩

/-- The quadratic tower factors the very same complex embedding
used for the signed Gaussian comparison. -/
theorem actual_complex_embedding_eq :
    (algebraMap Quadratic ℂ).comp intoQuadratic =
      (IsFractionRing.lift GaussianInt.toComplex_injective : Base →+* ℂ) := by
  apply IsFractionRing.ringHom_ext
  intro z
  rw [RingHom.comp_apply,intoQuadratic,IsFractionRing.lift_algebraMap,
    IsFractionRing.lift_algebraMap]
  obtain ⟨a,b⟩ := z
  change algebraMap Quadratic ℂ ((a:Quadratic)+(b:Quadratic)*quadraticI) =
    ((⟨a,b⟩:GaussianInt):ℂ)
  rw [map_add,map_mul,map_intCast,map_intCast]
  change (a:ℂ)+(b:ℂ)*(quadraticI:ℂ)=((⟨a,b⟩:GaussianInt):ℂ)
  rw [quadraticI_value,GaussianInt.toComplex_def']

end ActualGaussianWeberBaseNumberField318
