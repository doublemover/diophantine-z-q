module
public import RationalFourRootFiber318
public import FourRootPointUniversal318
public import Mathlib.FieldTheory.Normal.Basic
public import Mathlib.FieldTheory.Galois.Basic
public section
noncomputable section
namespace RationalFourRootSplitting318
open Polynomial FourRootOrder318 FourRootOrderSigns318 RationalFourRootFiber318
set_option maxHeartbeats 600000
attribute [-instance] DivisionRing.toRatAlgebra
variable (a : Fin 4 → ℚ)

/-- The polynomial of all four actual rational fiber root equations. -/
@[expose] def fiberPolynomial : ℚ[X] := ∏ i : Fin 4, (X^2 - C (a i))

lemma fiberPolynomial_monic : (fiberPolynomial a).Monic :=
  Polynomial.monic_prod_of_monic _ _ (fun i _ => monic_X_pow_sub_C (a i) (by decide : 2 ≠ 0))

lemma quadratic_factorization (i : Fin 4) :
    (X^2 - C (a i)).map (algebraMap ℚ (PointField a)) =
      (X - C (root a i)) * (X + C (root a i)) := by
  simp only [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C]
  rw [← root_square a i, map_pow]
  ring

lemma fiberPolynomial_splits : ((fiberPolynomial a).map (algebraMap ℚ (PointField a))).Splits := by
  rw [fiberPolynomial, Polynomial.map_prod]
  apply Splits.prod
  intro i _
  rw [quadratic_factorization]
  exact (Splits.X_sub_C _).mul (Splits.X_add_C _)

lemma root_mem_rootSet (i : Fin 4) : root a i ∈ (fiberPolynomial a).rootSet (PointField a) := by
  apply (fiberPolynomial_monic a).mem_rootSet.mpr
  rw [fiberPolynomial, map_prod]
  apply Finset.prod_eq_zero (Finset.mem_univ i)
  simp only [map_sub, map_pow, aeval_X, aeval_C, root_square, sub_self]

/-- The actual residue field is generated by the roots of these same
quadratic equations, proved using its surjective quotient map. -/
lemma adjoin_rootSet : Algebra.adjoin ℚ ((fiberPolynomial a).rootSet (PointField a) : Set (PointField a)) = ⊤ := by
  let B := Algebra.adjoin ℚ ((fiberPolynomial a).rootSet (PointField a) : Set (PointField a))
  have hb : ∀ i, point a (generator a i) ∈ B :=
    fun i => Algebra.subset_adjoin (root_mem_rootSet a i)
  have hf := FourRootPointUniversal318.factor_comp a (point a) B hb
  apply Algebra.eq_top_iff.mpr
  intro x
  obtain ⟨z, rfl⟩ := point_surjective a x
  have he := AlgHom.congr_fun hf z
  exact he ▸ (FourRootPointUniversal318.factor a (point a) B hb z).property

/-- The already constructed field, not a newly chosen normal closure, is
an actual splitting field of the literal fiber polynomial. -/
instance splittingField : IsSplittingField ℚ (PointField a) (fiberPolynomial a) :=
  ⟨fiberPolynomial_splits a, adjoin_rootSet a⟩

instance normal : Normal ℚ (PointField a) := Normal.of_isSplittingField (fiberPolynomial a)
instance galois : IsGalois ℚ (PointField a) := isGalois_iff.mpr ⟨inferInstance, inferInstance⟩

end RationalFourRootSplitting318
