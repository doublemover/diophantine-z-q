module
public import PELInertiaSquaredCoordinate318
public import Mathlib.Topology.Algebra.ConstMulAction
public section
noncomputable section
namespace PELOriginalMaximalQuotient318
open QuaternionicJointPeriodTopology318 PELJointComplexAtlas318 PELPrincipalBaseHolomorphy318
open PELUnlevelledComplexBase318 PELOriginalElementaryAction318
open scoped Manifold ContDiff
set_option maxHeartbeats 1500000
abbrev Labels := Multiplicative InertiaLabels318.V
local instance : ChartedSpace ℂ UnlevelledBase := unlevelledCharts
local instance : IsManifold 𝓘(ℂ,ℂ) ω UnlevelledBase := unlevelled_manifold
local instance : LocallyCompactSpace HalfPlane := (baseChart.isOpenEmbedding rfl).locallyCompactSpace

instance originalContinuous : ContinuousConstSMul Labels UnlevelledBase where
  continuous_const_smul g := (original_action_holomorphic g).continuous

instance coarseLocallyCompact : LocallyCompactSpace UnlevelledBase :=
  ChartedSpace.locallyCompactSpace (H:=ℂ)

instance coarseT2 : T2Space UnlevelledBase := inferInstance

/-- Literal topological quotient by the COMPLETE actual positive-normalizer
action image, identified with its original parity action. No compactness or
algebraic PEL model is built into this definition. -/
abbrev MaximalBase := Quotient (MulAction.orbitRel Labels UnlevelledBase)
@[expose] def projection : UnlevelledBase → MaximalBase := Quotient.mk _

instance maximalT2 : T2Space MaximalBase := inferInstance

theorem projection_surjective : Function.Surjective projection := Quotient.mk_surjective

theorem projection_open : IsOpenMap projection := isOpenMap_quotient_mk'_mul

theorem projection_continuous : Continuous projection := continuous_quot_mk

theorem projection_eq_iff (x y : UnlevelledBase) :
    projection x=projection y ↔ ∃ g : Labels,g • y=x := by
  constructor
  · exact Quotient.exact
  · exact Quotient.sound

/-- The quotient uses every original positive normalizer, not merely an
arbitrary subgroup generated by chosen examples. -/
theorem full_normalizer_orbit_iff (x y : UnlevelledBase) :
    projection x=projection y ↔ ∃ g : PELPositiveOrderNormalizer318.positiveNormalizer,
      PELUnlevelledNormalizerAction318.coarseAction g y=x := by
  rw [projection_eq_iff]
  constructor
  · rintro ⟨v,hv⟩
    exact ⟨PELPositiveOrderNormalizer318.word (Multiplicative.toAdd v),hv⟩
  · rintro ⟨g,hg⟩
    exact ⟨PELPositiveOrderNormalizer318.parity g,
      (PELFullNormalizerAction318.actual_action_factorization g y).symm.trans hg⟩
end PELOriginalMaximalQuotient318
