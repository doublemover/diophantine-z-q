module
public import ProjectiveKernelParameter318
public section
noncomputable section
namespace ProjectiveKernelFiniteEquations318
open scoped BigOperators
universe u
variable (R P Q : Type u) [CommRing R] [AddCommGroup P] [Module R P]
  [AddCommGroup Q] [Module R Q] (d : P →ₗ[R] Q)
  (F : FiniteProjectiveEvaluationFrame318.Frame R Q)

/-- All linear equations are generated by a genuine finite projective dual frame;
no choice of a nonexistent global basis of Q is made. -/
lemma equation_expansion (φ : Module.Dual R Q) :
    ProjectiveKernelEquations318.equation R P Q d φ =
      ∑ i, φ (F.vector i) • ProjectiveKernelEquations318.equation R P Q d (F.coordinate i) := by
  have hd : φ.comp d=∑ i,φ (F.vector i) • (F.coordinate i).comp d := by
    ext x
    have h := congrArg (fun ψ : Module.Dual R Q => ψ (d x)) (F.dual_reconstruct φ)
    simpa only [LinearMap.sum_apply,LinearMap.smul_apply,LinearMap.comp_apply] using h.symm
  change SymmetricAlgebra.ι R _ (φ.comp d)=_
  rw [hd,map_sum]
  simp only [map_smul,ProjectiveKernelEquations318.equation]

lemma finite_equations : ProjectiveKernelParameter318.ideal R P Q d =
    Ideal.span (Set.range (fun i : Fin F.size =>
      ProjectiveKernelEquations318.equation R P Q d (F.coordinate i))) := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro a ⟨φ,rfl⟩
    rw [equation_expansion R P Q d F φ]
    apply Submodule.sum_mem
    intro i hi
    rw [Algebra.smul_def]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_range_self i))
  · apply Ideal.span_le.mpr
    rintro a ⟨i,rfl⟩
    exact Ideal.subset_span (Set.mem_range_self (F.coordinate i))
end ProjectiveKernelFiniteEquations318
