module
public import DirectHodgeSectionHeight318
public import OriginalKSLatticeMetricSections318
public section
noncomputable section
namespace OriginalHodgeSectionInequalities318
open NumberField SectionHeight318 FinitePlacePrincipalLattice318 FinitePlacePrincipalImage318
open OriginalConstructedMetricSections318 OriginalExcludedPlaceData318 ContactArithmeticDenominator318
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1000000

section Local
variable {F : Type*} [Field F] [NumberField F] (w : FinitePlace F)
theorem mem_iff_le (γ x : F) (hγ : γ≠0) : x∈lattice w γ ↔ w x≤w γ := by
  rw [mem_iff_norm w γ hγ x,←div_eq_mul_inv]
  constructor
  · intro h; simpa only [one_mul] using (div_le_iff₀ (w.pos hγ)).mp h
  · intro h; exact (div_le_iff₀ (w.pos hγ)).mpr (by simpa only [one_mul] using h)

theorem image_iff (k γ β : F) (hk : k≠0) (hγ : γ≠0) (hβ : β≠0) :
    (lattice w γ).map (scalarMap w k)=productLattice w β β ↔ w (k*γ)=w (β^2) := by
  rw [scalar_image,product_lattice,←pow_two]
  exact lattice_eq_iff_norm w _ _ (mul_ne_zero hk hγ) (pow_ne_zero _ hβ)

theorem prescribed_bound (k β x : F) (hk : k≠0) (hβ : β≠0) :
    x∈lattice w (β^2/k) ↔ w(k*x)≤w(β^2) := by
  rw [mem_iff_le _ _ _ (div_ne_zero (pow_ne_zero _ hβ) hk),map_div₀,map_mul,le_div_iff₀ (w.pos hk),mul_comm (w x)]
end Local

variable (c : Fin 4 → ℚˣ) (u v : ℤ) (hf : ∀ j : Fin 5,ContactRadical318.forms u v j≠0) (i : Fin 4)
abbrev value (n : Fin 2) : K c u v :=
  ![ContactBicanonicalPointHeight318.a0 c (t u v) (hn c u v hf) i,
    ContactBicanonicalPointHeight318.a1 c (t u v) (hn c u v hf) i] n

variable (β : FinitePlace (K c u v) → K c u v) (hβ : ∀ w,β w≠0)
@[expose] def GoodNorms : Prop := ∀ (w : FinitePlace (K c u v))
    (hgood : w (denominator c : K c u v)=1),
  w ((210:K c u v)*OriginalGoodPlaceCotangentNorms318.normalizer c (t u v) (hn c u v hf) w hgood i)=w ((β w)^2)

@[expose] def BadBounds : Prop := ∀ (b : BadPlace c (t u v)) (n : Fin 2),
  b.val ((210:K c u v)*value c u v hf i n)≤b.val ((β b.val)^2)

/-- The strongest canonical-good-place consumer has no need for an unfixed
excluded generator: once β is supplied, its only possible embedded bad
lattice is generated by β²/210. This does NOT identify it as a geometric
cotangent lattice of the resolved model. -/
@[expose] def prescribedGenerators (hb : BadBounds c u v hf i β) :
    ExcludedGenerators c (t u v) (hn c u v hf) i where
  generator b := (β b.val)^2/210
  nonzero b := div_ne_zero (pow_ne_zero _ (hβ b.val)) (by norm_num)
  original_mem b n := (prescribed_bound b.val 210 _ _ (by norm_num) (hβ b.val)).mpr (hb b n)

include hβ in
theorem exists_localKS_iff :
    (∃ B : ExcludedGenerators c (t u v) (hn c u v hf) i,
      OriginalKSLatticeMetricSections318.LocalKSImages c u v hf i B β) ↔
      GoodNorms c u v hf i β ∧ BadBounds c u v hf i β := by
  constructor
  · rintro ⟨B,images⟩
    constructor
    · intro w hw
      have hi := images w
      rw [OriginalCanonicalFiniteLattices318.modelLattice_good _ _ _ _ _ _ hw] at hi
      exact (image_iff w 210 _ _ (by norm_num)
        (OriginalGoodPlaceCotangentNorms318.normalizer_ne c _ _ w hw i) (hβ w)).mp hi
    · intro b n
      have hi := images b.val
      rw [OriginalCanonicalFiniteLattices318.modelLattice_bad _ _ _ _ _ _ b.property] at hi
      have eqn := (image_iff b.val 210 _ _ (by norm_num) (B.nonzero b) (hβ b.val)).mp hi
      have hle := (mem_iff_le b.val (B.generator b) (value c u v hf i n) (B.nonzero b)).mp (B.original_mem b n)
      rw [←eqn,map_mul,map_mul]
      exact mul_le_mul_of_nonneg_left hle (b.val.nonneg _)
  · rintro ⟨hg,hb⟩
    let B := prescribedGenerators c u v hf i β hβ hb
    refine ⟨B,?_⟩
    intro w
    by_cases hw : w (denominator c : K c u v)=1
    · rw [OriginalCanonicalFiniteLattices318.modelLattice_good _ _ _ _ _ _ hw]
      exact (image_iff w 210 _ _ (by norm_num)
        (OriginalGoodPlaceCotangentNorms318.normalizer_ne c _ _ w hw i) (hβ w)).mpr (hg w hw)
    · rw [OriginalCanonicalFiniteLattices318.modelLattice_bad _ _ _ _ _ _ hw,
        scalar_image,product_lattice]
      change lattice w ((210:K c u v)*((β w)^2/210))=lattice w (β w*β w)
      congr 1
      field_simp <;> ring

/-- Direct route for the numerical height alone: the sections are exactly
the original pair. It needs all-place Hodge inequalities, but not KS equality
with the independently constructed canonical good-place models. -/
theorem original_height_direct (H : FrameNorms (K c u v)) (hYuan : ℝ)
    (hdegree : H.normalizedDegree=hYuan)
    (ha : ∀ (w : InfinitePlace (K c u v)) n,
      w (value c u v hf i n)*(H.arch w)^2≤ContactMetricSections318.sectionBound)
    (hv : ∀ (w : FinitePlace (K c u v)) n,
      w ((210:K c u v)*value c u v hf i n)*(H.finiteNorm w)^2≤1) :
    ContactHeight318.pointHeight u v<2*(hYuan-Real.log Real.pi)+120 :=
  DirectHodgeSectionHeight318.height_from_local_hodge_inequalities H hYuan hdegree u v _ _
    (ContactBicanonicalPointHeight318.a0_ne c (t u v) (hn c u v hf) i)
    (ContactBicanonicalPointHeight318.ratio c (t u v) (hn c u v hf) i) ha hv

end OriginalHodgeSectionInequalities318
