module
public import CanonicalPrimitiveXPolynomial318
public section
noncomputable section
namespace CoarseMarkingResolvent318
open WeierstrassCurve.Affine TranscendentalJGenericFiber318 GenericMarkingOrbitField318
open GenericPrimitiveXCoordinate318 Polynomial
variable (N:ℕ) [NeZero N] (L:Type*) [Field L] [Algebra (K N) L]
variable [FiniteDimensional (K N) L] [IsGalois (K N) L]
variable (H:Subgroup (ZMod N)ˣ)
local instance : Fintype H := Fintype.ofFinite _
private def mark (u:H) (Q:A N L) : A N L := (u.val:ZMod N).val • Q
private theorem mark_mul (u v:H) (Q:A N L) (ho:addOrderOf Q=N) :
    mark N L H (u*v) Q=mark N L H u (mark N L H v Q) := by
  change ((u.val:ZMod N)*(v.val:ZMod N)).val • Q = _ • (_ • Q)
  rw [ZMod.val_mul,←ho,mod_addOrderOf_nsmul,mul_nsmul]
private theorem mark_one (Q:A N L) (ho:addOrderOf Q=N) : mark N L H 1 Q=Q := by
  change (1:ZMod N).val • Q=Q
  rw [ZMod.val_one_eq_one_mod,←ho,mod_addOrderOf_nsmul,one_nsmul]

/-- Polynomial encoding the whole H-packet of projective x-values at an affine mark.
Multiplicity from the central sign is intentionally retained. -/
def R (P:A N L) : Polynomial L := ∏u:H,(X-C (x N L (mark N L H u P)))

theorem R_scalar (P:A N L) (ho:addOrderOf P=N) (v:H) :
    R N L H (mark N L H v P)=R N L H P := by
  classical
  unfold R
  exact Fintype.prod_equiv (Equiv.mulRight v) _ _ (fun u=>by rw [←mark_mul N L H u v P ho] <;> rfl)

private theorem x_g (g:G N L) (Q:A N L) :
    g (x N L Q)=x N L (Point.map (W':=W N) g.toAlgHom Q) := by
  cases Q <;> simp [x,Point.map_some,Point.map_zero]
theorem R_galois (g:G N L) (P:A N L) :
    (R N L H P).map g.toRingEquiv.toRingHom=
      R N L H (Point.map (W':=W N) g.toAlgHom P) := by
  classical
  simp [R,Polynomial.map_prod,mark,x_g,map_nsmul]

def field (P:A N L) := IntermediateField.adjoin (K N) (Set.range (R N L H P).coeff)

theorem contained (P:A N L) (hP:addOrderOf P=N) :
    field N L H P ≤ orbitField N L P hP H := by
  apply IntermediateField.adjoin_le_iff.mpr
  rintro _ ⟨n,rfl⟩ g
  obtain ⟨u,hu⟩ := (mem_stabilizer N L P hP H g.val).mp g.property
  have hh := R_galois N L H g.val P
  rw [hu,R_scalar N L H P hP u] at hh
  simpa only [Polynomial.coeff_map] using congrArg (fun p:Polynomial L=>p.coeff n) hh

/-- Genuine field generated by the resolvent coefficients of the actual
point. No irreducibility, primitive equation, or choice of modular
function-field embedding is an input. -/
theorem degree (P:A N L) (hP:addOrderOf P=N) :
    Module.finrank (K N) (field N L H P)≤(GammaHGroup318.gammaH N H).index := by
  let f := IntermediateField.inclusion (contained N L H P hP)
  exact (LinearMap.finrank_le_finrank_of_injective (f:=f.toLinearMap) f.injective).trans
    (GenericMarkingOrbitField318.degree N L P hP H)

theorem root_iff (P:A N L) (z:L) :
    (R N L H P).eval z=0 ↔ ∃u:H,x N L (mark N L H u P)=z := by
  classical
  simp [R,Polynomial.eval_prod,sub_eq_zero,eq_comm]

/-- Every true diamond-invariant x-coordinate function belongs to the
resolvent field. An automorphism fixing its coefficients carries x(P) to
a root and hence to x([u]P), which suffices on a field generated by x(P).
Only the one-way inclusion needed for the degree is used. -/
def coarseEmbedding (P:A N L) (hP:addOrderOf P=N)
    (hc:∀u:H,minpoly (K N) (x N L P)=minpoly (K N) (XP N L P H u)) :
    invariantField N L P H hc →ₐ[K N] field N L H P := by
  let F := F₁ N L P
  let D := invariantField N L P H hc
  let i := F.val.comp D.val
  refine i.codRestrict (field N L H P).toSubalgebra ?_
  intro z
  change i z∈field N L H P
  rw [←IsGalois.fixedField_fixingSubgroup (field N L H P)]
  intro g
  have hh : (R N L H P).map g.val.toRingEquiv.toRingHom=R N L H P := by
    ext n
    rw [Polynomial.coeff_map]
    exact g.property ⟨(R N L H P).coeff n,IntermediateField.subset_adjoin _ _ ⟨n,rfl⟩⟩
  have hgord : addOrderOf (Point.map (W':=W N) g.val.toAlgHom P)=N :=
    (addOrderOf_injective _ (Point.map_injective (W':=W N) g.val.toAlgHom) P).trans hP
  let gP:=Point.map (W':=W N) g.val.toAlgHom P
  have hr : (R N L H gP).eval (x N L gP)=0 :=
    (root_iff N L H gP _).mpr ⟨1,congrArg (x N L) (mark_one N L H gP hgord)⟩
  have hsame : R N L H gP=R N L H P := (R_galois N L H g.val P).symm.trans hh
  rw [hsame] at hr
  obtain ⟨u,hu⟩ := (root_iff N L H P _).mp hr
  have he : g.val.toAlgHom.comp F.val=F.val.comp (diamond N L P H hc u) := by
    apply IntermediateField.adjoin_algHom_ext
    rintro a (rfl : a=x N L P)
    change g.val (x N L P)=((diamond N L P H hc u (gen N L P):F):L)
    rw [x_g,diamond_gen]
    exact hu.symm
  exact (DFunLike.congr_fun he z.val).trans (congrArg (fun v:F=>(v:L)) (z.property u))
end CoarseMarkingResolvent318
