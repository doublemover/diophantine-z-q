module
public import OriginalReesDomainChart318
public section
noncomputable section

namespace OriginalReesChartGeneration318

open Polynomial HomogeneousLocalization
open OriginalAffineReesGrading318 OriginalAffineReesBlowup318
open OriginalAffineReesChartLocal318 OriginalReesDomainChart318

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

variable {R : Type*} [CommRing R] [IsDomain R]
variable (I : Ideal R) (a : R) (ha : a ∈ I) (hn : a ≠ 0)

abbrev m := chartScalars I a ha
abbrev a₀ := m I a ha a

abbrev scalarRead : R →+* Localization.Away (generator I a ha) :=
  (algebraMap (chart I a ha) (Localization.Away (generator I a ha))).comp (m I a ha)

omit [IsDomain R] in
private theorem read_ratio (n : ℕ) (u : ↥(I^n)) :
    (ratio I a ha n u).val * (a₀ I a ha).val^n = (m I a ha u.val).val := by
  have h := congrArg (fun z : chart I a ha => z.val) (clear_ratio I a ha n u)
  simpa only [val_mul, val_pow] using h

include hn in
theorem ratio_add (n : ℕ) (b c : ↥(I^n)) :
    ratio I a ha n (b+c) = ratio I a ha n b + ratio I a ha n c := by
  apply cancel_scalar_pow I a ha hn n
  apply HomogeneousLocalization.val_injective (Submonoid.powers (generator I a ha))
  simp only [val_mul, val_pow, val_add]
  rw [add_mul, read_ratio, read_ratio, read_ratio]
  exact (scalarRead I a ha).map_add b.val c.val

include hn in
theorem ratio_zero (n : ℕ) : ratio I a ha n 0 = 0 := by
  apply cancel_scalar_pow I a ha hn n
  apply HomogeneousLocalization.val_injective (Submonoid.powers (generator I a ha))
  simp only [val_mul, val_pow, val_zero, zero_mul]
  rw [read_ratio]
  exact (scalarRead I a ha).map_zero

include hn in
theorem ratio_smul (n : ℕ) (b : R) (c : ↥(I^n)) :
    ratio I a ha n (b • c) = m I a ha b * ratio I a ha n c := by
  apply cancel_scalar_pow I a ha hn n
  apply HomogeneousLocalization.val_injective (Submonoid.powers (generator I a ha))
  simp only [val_mul, val_pow]
  rw [mul_assoc, read_ratio, read_ratio]
  exact (scalarRead I a ha).map_mul b c.val

include hn in
theorem ratio_succ (n : ℕ) (b : I) (c : ↥(I^n)) :
    ratio I a ha (n+1) ⟨b.val*c.val,by rw [pow_succ']; exact Ideal.mul_mem_mul b.property c.property⟩ =
      ratio I a ha 1 ⟨b.val,by simpa only [pow_one] using b.property⟩ * ratio I a ha n c := by
  apply cancel_scalar_pow I a ha hn (n+1)
  apply HomogeneousLocalization.val_injective (Submonoid.powers (generator I a ha))
  simp only [val_mul, val_pow]
  rw [read_ratio]
  calc
    _ = (m I a ha b.val).val * (m I a ha c.val).val :=
      (scalarRead I a ha).map_mul b.val c.val
    _ = ((ratio I a ha 1 ⟨b.val,by simpa only [pow_one] using b.property⟩).val * (a₀ I a ha).val^1) *
        ((ratio I a ha n c).val * (a₀ I a ha).val^n) := by rw [read_ratio, read_ratio]
    _ = _ := by
      rw [pow_one ((a₀ I a ha).val), pow_succ' ((a₀ I a ha).val)]
      ac_rfl

omit [IsDomain R] in
/-- All elements of the actual degree-zero homogeneous localization
are represented by a ratio with coefficient in the correct ideal power. -/
theorem exists_ratio (z : chart I a ha) :
    ∃ (n : ℕ) (r : ↥(I^n)), ratio I a ha n r = z := by
  obtain ⟨n,w,hw,he⟩ := Away.mk_surjective (grade I) (generator_grade I a ha) z
  have hw' : w ∈ grade I n := by simpa only [Nat.nsmul_eq_mul, mul_one] using hw
  let r : ↥(I^n) := ⟨w.val.coeff n,w.property n⟩
  refine ⟨n,r,?_⟩
  have eq : (homogeneous I n r.val r.property).val = w := by
    apply Subtype.ext
    exact (homogeneous_value I hw').symm
  let u : ↥(grade I (n • (1 : ℕ))) :=
    ⟨(homogeneous I n r.val r.property).val, by
      simpa only [Nat.nsmul_eq_mul, mul_one] using (homogeneous I n r.val r.property).property⟩
  have e : u = (⟨w,hw⟩ : ↥(grade I (n • (1 : ℕ)))) := Subtype.ext eq
  exact (congrArg (fun t : ↥(grade I (n • (1 : ℕ))) =>
    Away.mk (grade I) (generator_grade I a ha) n t.val t.property) e).trans he

include hn in
/-- The real chart is generated by the honest first-degree ratios of
a given set of ideal generators. No presentation for the chart is assumed. -/
theorem generated (G : Set R) (hG : Ideal.span G = I) :
    letI : Algebra R (chart I a ha) := (m I a ha).toAlgebra
    Algebra.adjoin R {z : chart I a ha | ∃ v : ↥(I^1), v.val ∈ G ∧ ratio I a ha 1 v = z} = ⊤ := by
  let : Algebra R (chart I a ha) := (m I a ha).toAlgebra
  let S := Algebra.adjoin R {z : chart I a ha | ∃ v : ↥(I^1), v.val ∈ G ∧ ratio I a ha 1 v = z}
  change S = ⊤
  have h₁ (b : R) (hb : b ∈ I) :
      ratio I a ha 1 ⟨b,by simpa only [pow_one] using hb⟩ ∈ S := by
    have hg : Submodule.span R G = I := hG
    have hz : b ∈ Submodule.span R G := hg.symm ▸ hb
    exact Submodule.span_induction
      (p:=fun t ht => ratio I a ha 1 ⟨t,by simpa only [pow_one] using (hg ▸ ht : t ∈ I)⟩ ∈ S)
      (by
        intro t ht
        apply Algebra.subset_adjoin
        exact ⟨_,ht,rfl⟩)
      (by
        change ratio I a ha 1 (0 : ↥(I^1)) ∈ S
        rw [ratio_zero I a ha hn]
        exact S.zero_mem)
      (by
        intro t u ht hu h₁' h₂'
        let tt : ↥(I^1) := ⟨t,by simpa only [pow_one] using (hg ▸ ht : t ∈ I)⟩
        let uu : ↥(I^1) := ⟨u,by simpa only [pow_one] using (hg ▸ hu : u ∈ I)⟩
        change ratio I a ha 1 (tt + uu) ∈ S
        rw [ratio_add I a ha hn]
        exact S.add_mem h₁' h₂')
      (by
        intro c t ht h₁'
        let tt : ↥(I^1) := ⟨t,by simpa only [pow_one] using (hg ▸ ht : t ∈ I)⟩
        change ratio I a ha 1 (c • tt) ∈ S
        rw [ratio_smul I a ha hn]
        exact S.mul_mem (S.algebraMap_mem c) h₁') hz
  have hAll : ∀ n (v : ↥(I^n)), ratio I a ha n v ∈ S := by
    intro n
    induction n with
    | zero =>
      intro v
      have h : ratio I a ha 0 v = m I a ha v.val := by
        apply HomogeneousLocalization.val_injective (Submonoid.powers (generator I a ha))
        simpa only [pow_zero ((a₀ I a ha).val), mul_one] using read_ratio I a ha 0 v
      rw [h]
      exact S.algebraMap_mem v.val
    | succ n ih =>
      rintro ⟨v,hv⟩
      have H : v ∈ I*I^n := by rw [←pow_succ']; exact hv
      exact Submodule.mul_induction_on'
        (C:=fun t ht => ratio I a ha (n+1) ⟨t,by rw [pow_succ']; exact ht⟩ ∈ S)
        (by
          intro b hb c hc
          rw [ratio_succ I a ha hn n ⟨b,hb⟩ ⟨c,hc⟩]
          exact S.mul_mem (h₁ b hb) (ih ⟨c,hc⟩))
        (by
          intro b hb c hc h₁' h₂'
          let bb : ↥(I^(n+1)) := ⟨b,by rw [pow_succ']; exact hb⟩
          let cc : ↥(I^(n+1)) := ⟨c,by rw [pow_succ']; exact hc⟩
          change ratio I a ha (n+1) (bb+cc) ∈ S
          rw [ratio_add I a ha hn]
          exact S.add_mem h₁' h₂') H
  apply top_unique
  intro z _
  obtain ⟨n,r,rfl⟩ := exists_ratio I a ha z
  exact hAll n r

end OriginalReesChartGeneration318

#print axioms OriginalReesChartGeneration318.exists_ratio
