open SelectedActualAbelTargetLatticeHaar318 (targetVolume targetVolume_mass targetVolume_restrict_chart)

def interleaved (g : ℕ) : RealRow g ≃ Index g where
  toFun x := if x.2=0 then Sum.inl x.1 else Sum.inr x.1
  invFun := Sum.elim (fun i=>⟨i,0⟩) (fun i=>⟨i,1⟩)
  left_inv x := by
    rcases x with ⟨i,j⟩
    fin_cases j <;> rfl
  right_inv j := by cases j <;> rfl

variable {g : ℕ} (P Q G : Mat ℂ (Fin g))
variable (h : complexIsotropy P Q=0)
variable (hG : mixedPairing P Q = ((2:ℂ)*Complex.I) • G) (hp : 0<G.det.re)

abbrev L : Submodule ℤ (OriginalSameJGroupedPeriodBasis318.V g) :=
  Submodule.span ℤ (Set.range (periodBasis P Q G h hG hp))

/-- The exact lattice is generated by the literal period columns.
The real basis was proved, not supplied as another hypothesis. -/
theorem exact_span :
    L P Q G h hG hp = Submodule.span ℤ (Set.range (periodColumn P Q)) := by
  have hr : (periodBasis P Q G h hG hp : Index g→OriginalSameJGroupedPeriodBasis318.V g) =
    periodColumn P Q := funext (reads_basis P Q G h hG hp)
  unfold L
  rw [hr]

def literalZBasis : Module.Basis (RealRow g) ℤ (L P Q G h hG hp) :=
  ((periodBasis P Q G h hG hp).restrictScalars ℤ).reindex (interleaved g).symm

theorem literal_row_matrix :
    literalRealPeriodMatrix (literalZBasis P Q G h hG hp) =
      (groupedReal P Q).submatrix (interleaved g) (interleaved g) := by
  ext i j
  rw [literalRealPeriodMatrix_apply, Matrix.submatrix_apply]
  have column :
      ((literalZBasis P Q G h hG hp j : L P Q G h hG hp) :
        OriginalSameJGroupedPeriodBasis318.V g) =
      periodColumn P Q (interleaved g j) := by
    unfold literalZBasis
    rw [Module.Basis.reindex_apply, Equiv.symm_symm, Module.Basis.restrictScalars_apply]
    exact reads_basis P Q G h hG hp (interleaved g j)
  rw [column, ← grouped_read P Q (interleaved g i) (interleaved g j)]
  rcases i with ⟨i,t⟩
  fin_cases t
  · change Complex.measurableEquivPi ((periodColumn P Q (interleaved g j)) i) 0 =
      ((periodColumn P Q (interleaved g j)) i).re
    exact congrFun (Complex.measurableEquivPi_apply _) (0 : Fin 2)
  · change Complex.measurableEquivPi ((periodColumn P Q (interleaved g j)) i) 1 =
      ((periodColumn P Q (interleaved g j)) i).im
    exact congrFun (Complex.measurableEquivPi_apply _) (1 : Fin 2)

theorem actual_covolume :
    ZLattice.covolume (L P Q G h hG hp)
      (volume : Measure (OriginalSameJGroupedPeriodBasis318.V g))=G.det.re := by
  let B := periodBasis P Q G h hG hp
  let : DiscreteTopology (L P Q G h hG hp) :=
    inferInstanceAs (DiscreteTopology (Submodule.span ℤ (Set.range B)))
  let : IsZLattice ℝ (L P Q G h hG hp) :=
    inferInstanceAs (IsZLattice ℝ (Submodule.span ℤ (Set.range B)))
  rw [covolume_eq_literal_real_period_determinant _ (literalZBasis P Q G h hG hp),
    literal_row_matrix,Matrix.det_submatrix_equiv_self]
  exact actual_determinant P Q G h hG hp

variable {J : Type*} [AddCommGroup J] [MeasurableSpace J]
variable (exp : OriginalSameJGroupedPeriodBasis318.V g→+J) (hexp : Measurable exp)

/-- On the actual complex group the volume is the pushed Lebesgue
restriction of the SAME period box, not Haar probability. -/
def actualTargetVolume : Measure J := by
  let B := periodBasis P Q G h hG hp
  let : DiscreteTopology (L P Q G h hG hp) :=
    inferInstanceAs (DiscreteTopology (Submodule.span ℤ (Set.range B)))
  let : IsZLattice ℝ (L P Q G h hG hp) :=
    inferInstanceAs (IsZLattice ℝ (Submodule.span ℤ (Set.range B)))
  exact targetVolume (L P Q G h hG hp) (literalZBasis P Q G h hG hp) volume exp

include hexp in
theorem actual_target_mass :
    ((actualTargetVolume P Q G h hG hp exp) Set.univ).toReal = G.det.re := by
  let B := periodBasis P Q G h hG hp
  let : DiscreteTopology (L P Q G h hG hp) :=
    inferInstanceAs (DiscreteTopology (Submodule.span ℤ (Set.range B)))
  let : IsZLattice ℝ (L P Q G h hG hp) :=
    inferInstanceAs (IsZLattice ℝ (Submodule.span ℤ (Set.range B)))
  exact (targetVolume_mass _ (literalZBasis P Q G h hG hp) volume exp hexp).trans
    (actual_covolume P Q G h hG hp)

include hexp in
/-- Once the actual integral Abel-cycle comparison identifies exp's
kernel with this integer span, the SAME volume on every injective
exponential chart is ordinary local Lebesgue volume. -/
theorem actual_target_chart
    (exactKernel : ∀ z, exp z=0 ↔ z ∈ L P Q G h hG hp)
    (U : Set (OriginalSameJGroupedPeriodBasis318.V g)) (hU : MeasurableSet U)
    (hinj : Set.InjOn exp U) (hW : MeasurableSet (exp '' U)) :
    (actualTargetVolume P Q G h hG hp exp).restrict (exp '' U) =
      (volume.restrict U).map exp := by
  let B := periodBasis P Q G h hG hp
  let : DiscreteTopology (L P Q G h hG hp) :=
    inferInstanceAs (DiscreteTopology (Submodule.span ℤ (Set.range B)))
  let : IsZLattice ℝ (L P Q G h hG hp) :=
    inferInstanceAs (IsZLattice ℝ (Submodule.span ℤ (Set.range B)))
  exact targetVolume_restrict_chart _ (literalZBasis P Q G h hG hp) volume exp hexp
    exactKernel U hU hinj hW

end OriginalSameJLiteralPeriodHaar318

