module
public import Mathlib.RingTheory.DedekindDomain.Dvr
public import Mathlib.RingTheory.DedekindDomain.IntegralClosure
public import Mathlib.RingTheory.Polynomial.Basic

public section
noncomputable section

namespace SelectedJStructuralNormalization318

open IsLocalRing Module

/-- Structural vertical prime of the affine j-line over the coefficient trait. -/
abbrev verticalIdeal (O : Type*) [CommRing O] [IsLocalRing O] : Ideal (Polynomial O) :=
  (maximalIdeal O).map Polynomial.C

/-- Localize at the generic point of the vertical line, not at the centre j = 1. -/
abbrev Structural (O : Type*) [CommRing O] [IsLocalRing O] :=
  Localization.AtPrime (verticalIdeal O)

/-- The structural maximal ideal is generated by the image of the coefficient
uniformizer, not by j - 1. This uses only the actual localization. -/
private theorem structural_maximal_isPrincipal (O : Type*) [CommRing O]
    [IsLocalRing O] [IsDedekindDomain O] :
    (maximalIdeal (Structural O)).IsPrincipal := by
  let : (maximalIdeal O).IsPrincipal := maximalIdeal_isPrincipal_of_isDedekindDomain O
  obtain ⟨π, hπ⟩ := Submodule.IsPrincipal.principal (maximalIdeal O)
  let f : Polynomial O →+* Structural O := algebraMap _ _
  refine ⟨⟨f (Polynomial.C π), ?_⟩⟩
  calc
    maximalIdeal (Structural O) = Ideal.map f (verticalIdeal O) :=
      Localization.AtPrime.map_eq_maximalIdeal.symm
    _ = Ideal.map f (Ideal.map Polynomial.C (Ideal.span {π})) :=
      congrArg (fun I : Ideal O => Ideal.map f (Ideal.map Polynomial.C I)) hπ
    _ = Ideal.span {f (Polynomial.C π)} := by
      rw [Ideal.map_span, Set.image_singleton, Ideal.map_span, Set.image_singleton]

private theorem structural_noetherian (O : Type*) [CommRing O] [IsLocalRing O]
    [IsDedekindDomain O] : IsNoetherianRing (Structural O) :=
  IsLocalization.isNoetherianRing (verticalIdeal O).primeCompl (Structural O) inferInstance

theorem structural_pid (O : Type*) [CommRing O] [IsLocalRing O]
    [IsDedekindDomain O] : IsPrincipalIdealRing (Structural O) := by
  let := structural_noetherian O
  exact ((tfae_of_isNoetherianRing_of_isLocalRing_of_isDomain (Structural O)).out 5 1).mp
    (structural_maximal_isPrincipal O)

theorem structural_dedekind (O : Type*) [CommRing O] [IsLocalRing O]
    [IsDedekindDomain O] : IsDedekindDomain (Structural O) := by
  let := structural_noetherian O
  exact ((tfae_of_isNoetherianRing_of_isLocalRing_of_isDomain (Structural O)).out 5 3).mp
    (structural_maximal_isPrincipal O)

theorem structural_nonunit (O : Type*) [CommRing O] [IsLocalRing O] (p : ℕ)
    (hp : (p : O) ∈ maximalIdeal O) : ¬ IsUnit (p : Structural O) := by
  have hc : Polynomial.C (p : O) ∈ verticalIdeal O := Ideal.mem_map_of_mem _ hp
  have hmap := Ideal.mem_map_of_mem (algebraMap (Polynomial O) (Structural O)) hc
  rw [Localization.AtPrime.map_eq_maximalIdeal] at hmap
  simpa only [map_natCast, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] using hmap

section Closure

variable (R K L : Type*) [CommRing R] [IsDedekindDomain R] [IsPrincipalIdealRing R]
  [Field K] [Algebra R K] [IsFractionRing R K] [Field L] [Algebra K L] [Algebra R L]
  [IsScalarTower R K L] [FiniteDimensional K L] [Algebra.IsSeparable K L]

/-- Use the integral closure itself. No type with a coincidentally equal rank is supplied. -/
theorem closureModule :
    Module.IsTorsionFree R (integralClosure R L) ∧
    Module.Free R (integralClosure R L) ∧
    Module.Finite R (integralClosure R L) ∧
    Module.finrank R (integralClosure R L) = Module.finrank K L := by
  let : Module.IsTorsionFree R L := .trans_faithfulSMul R K L
  exact ⟨IsIntegralClosure.isTorsionFree R L,
    IsIntegralClosure.module_free R K L (integralClosure R L),
    IsIntegralClosure.finite R K L (integralClosure R L),
    IsIntegralClosure.rank R K L (integralClosure R L)⟩

end Closure

end SelectedJStructuralNormalization318

#print axioms SelectedJStructuralNormalization318.structural_pid
#print axioms SelectedJStructuralNormalization318.structural_dedekind
#print axioms SelectedJStructuralNormalization318.structural_nonunit
#print axioms SelectedJStructuralNormalization318.closureModule
