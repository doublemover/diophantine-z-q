module
public import OpenJModel318
public import Mathlib.LinearAlgebra.TensorProduct.Quotient
public import Mathlib.RingTheory.TensorProduct.Maps

public section
noncomputable section

open Algebra Polynomial
open scoped TensorProduct

namespace SelectedJAbsoluteStructuralKernel318

abbrev A (N : ℕ) := OpenJModel318.Base N

/-- Two maps out of the *whole localized ordinary base* agreeing on j agree
on all coefficients and all inverted functions. No polynomial generation
assertion ignoring the localization is used. -/
theorem hom_ext_j (N : ℕ) {S : Type*} [CommRing S] (f g : A N →+* S)
    (hj : f (OpenJModel318.jCoord N) = g (OpenJModel318.jCoord N)) : f = g := by
  apply IsLocalization.ringHom_ext (Submonoid.powers (OpenJModel318.denominator N))
  apply Polynomial.ringHom_ext
  · intro n
    rw [show (C n : ℤ[X]) = (n : ℤ[X]) from map_intCast (C : ℤ →+* ℤ[X]) n]
    simp only [map_intCast]
  · exact hj

variable (N : ℕ) (B : Type*) [CommRing B] [Algebra (A N) B]

abbrev structural :=
  Algebra.TensorProduct.mapOfCompatibleSMul (A N) ℤ (A N) B B

def delta (b : B) : B ⊗[ℤ] B := b ⊗ₜ[ℤ] (1:B) - (1:B) ⊗ₜ[ℤ] b

def deltaJ : B ⊗[ℤ] B := delta B (algebraMap (A N) B (OpenJModel318.jCoord N))

theorem delta_base_mem (a : A N) :
    delta B (algebraMap (A N) B a) ∈ Ideal.span ({deltaJ N B} : Set (B ⊗[ℤ] B)) := by
  let I := Ideal.span ({deltaJ N B} : Set (B ⊗[ℤ] B))
  let left := (Algebra.TensorProduct.includeLeft : B →ₐ[ℤ] B ⊗[ℤ] B).toRingHom
  let right := (Algebra.TensorProduct.includeRight : B →ₐ[ℤ] B ⊗[ℤ] B).toRingHom
  let f := ((Ideal.Quotient.mk I).comp left).comp (algebraMap (A N) B)
  let g := ((Ideal.Quotient.mk I).comp right).comp (algebraMap (A N) B)
  have hj : f (OpenJModel318.jCoord N) = g (OpenJModel318.jCoord N) := by
    apply Ideal.Quotient.eq.mpr
    exact Ideal.mem_span_singleton_self (deltaJ N B)
  exact Ideal.Quotient.eq.mp (DFunLike.congr_fun (hom_ext_j N f g hj) a)

/-- The kernel of the *actual* map from the absolute self-product to the
self-product over the ordinary j-line is generated by exactly j₁−j₂.
This works for any algebra on the literal localized base, even nonreduced. -/
theorem structural_kernel :
    RingHom.ker (structural N B).toRingHom =
      Ideal.span ({deltaJ N B} : Set (B ⊗[ℤ] B)) := by
  let I := Ideal.span ({deltaJ N B} : Set (B ⊗[ℤ] B))
  apply le_antisymm
  · intro w hw
    have hlin : w ∈ (_root_.TensorProduct.mapOfCompatibleSMul (A N) ℤ (A N) B B).ker := hw
    rw [_root_.TensorProduct.AlgebraTensorModule.ker_mapOfCompatibleSMul] at hlin
    have H : Submodule.span (A N)
        {(a • m) ⊗ₜ[ℤ] n - m ⊗ₜ[ℤ] (a • n) | (a : A N) (m : B) (n : B)}
          ≤ I.restrictScalars (A N) := by
      apply Submodule.span_le.mpr
      rintro _ ⟨a,m,n,rfl⟩
      have fac : (a • m) ⊗ₜ[ℤ] n - m ⊗ₜ[ℤ] (a • n) =
          (m ⊗ₜ[ℤ] n) * delta B (algebraMap (A N) B a) := by
        simp only [delta, mul_sub, Algebra.TensorProduct.tmul_mul_tmul,
          mul_one, Algebra.smul_def, mul_comm m (algebraMap (A N) B a),
          mul_comm n (algebraMap (A N) B a)]
      rw [fac]
      exact I.mul_mem_left _ (delta_base_mem N B a)
    exact H hlin
  · apply Ideal.span_le.mpr
    intro v hv
    obtain rfl := Set.mem_singleton_iff.mp hv
    change structural N B (deltaJ N B) = 0
    let j := OpenJModel318.jCoord N
    change structural N B ((algebraMap (A N) B j) ⊗ₜ[ℤ] (1 : B) -
      (1 : B) ⊗ₜ[ℤ] (algebraMap (A N) B j)) = 0
    rw [map_sub]
    apply sub_eq_zero.mpr
    exact DFunLike.congr_fun (Algebra.TensorProduct.includeLeftRingHom_comp_algebraMap
      (R := A N) (A := B) (B := B)) j

end SelectedJAbsoluteStructuralKernel318
#print axioms SelectedJAbsoluteStructuralKernel318.structural_kernel
