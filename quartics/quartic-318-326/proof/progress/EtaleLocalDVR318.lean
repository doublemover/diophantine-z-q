module
public import SeparatedPrincipalLocal318
public import Mathlib.RingTheory.Unramified.LocalRing
public import Mathlib.RingTheory.AdicCompletion.Noetherian
public import Mathlib.RingTheory.Flat.TorsionFree
public import Mathlib.RingTheory.RamificationInertia.Ramification
public section
noncomputable section
namespace EtaleLocalDVR318
set_option maxHeartbeats 800000
open IsLocalRing
variable (R S:Type*) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
  [CommRing S] [IsLocalRing S] [Algebra R S] [IsLocalHom (algebraMap R S)]
  [Algebra.EssFiniteType R S] [Algebra.FormallyUnramified R S] [Module.Flat R S]
include R

/-- A genuine local, essentially finite-type flat unramified extension has
maximal ideal generated by the image of any source uniformizer. -/
theorem maximal_eq (pi:R) (hp:Irreducible pi) :
    maximalIdeal S=Ideal.span {algebraMap R S pi} := by
  rw [←Algebra.FormallyUnramified.map_maximalIdeal (R:=R)]
  rw [hp.maximalIdeal_eq,Ideal.map_span]
  simp

/-- The target local ring is a domain, derived from unramifiedness, flatness,
and Noetherian separation. It is not an input. -/
theorem domain : IsDomain S := by
  letI:IsNoetherianRing S:=Algebra.EssFiniteType.isNoetherianRing R S
  obtain ⟨pi,hpi⟩:=IsDiscreteValuationRing.exists_irreducible R
  apply SeparatedPrincipalLocal318.domain (algebraMap R S pi) (maximal_eq R S pi hpi)
  intro n hn
  apply pow_ne_zero n hpi.ne_zero
  apply FaithfulSMul.algebraMap_injective R S
  simpa only [map_pow,map_zero] using hn

/-- The actual local target is a DVR, not merely a local ring with a
numerically asserted ramification index. -/
theorem dvr : letI:=domain R S; IsDiscreteValuationRing S := by
  letI:=domain R S
  letI:IsNoetherianRing S:=Algebra.EssFiniteType.isNoetherianRing R S
  obtain ⟨pi,hpi⟩:=IsDiscreteValuationRing.exists_irreducible R
  have hm:=maximal_eq R S pi hpi
  refine { toIsPrincipalIdealRing := SeparatedPrincipalLocal318.principal _ hm
           toIsLocalRing := inferInstance
           not_a_field' := ?_ }
  intro hz
  have hi:algebraMap R S pi∈maximalIdeal S := by
    rw [hm]
    exact Ideal.subset_span (by simp)
  rw [hz] at hi
  apply hpi.ne_zero
  apply FaithfulSMul.algebraMap_injective R S
  simpa only [map_zero,Ideal.mem_bot] using hi

/-- Every actual source uniformizer stays irreducible. -/
theorem uniformizer (pi:R) (hp:Irreducible pi) :
    letI:=domain R S
    letI:=dvr R S
    Irreducible (algebraMap R S pi) := by
  letI:=domain R S
  letI:=dvr R S
  exact IsDiscreteValuationRing.irreducible_of_span_eq_maximalIdeal _
    (by simpa only [map_zero] using (FaithfulSMul.algebraMap_injective R S).ne hp.ne_zero)
    (maximal_eq R S pi hp)

/-- The canonical valuations agree on every source element, including zero. -/
theorem value (x:R) :
    letI:=domain R S
    letI:=dvr R S
    IsDiscreteValuationRing.addVal S (algebraMap R S x)=
      IsDiscreteValuationRing.addVal R x := by
  letI:=domain R S
  letI:=dvr R S
  by_cases hx:x=0
  · simp [hx]
  obtain ⟨pi,hp⟩:=IsDiscreteValuationRing.exists_irreducible R
  obtain ⟨n,u,rfl⟩:=IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hx hp
  rw [map_mul,map_pow,IsDiscreteValuationRing.addVal_mul,
    IsDiscreteValuationRing.addVal_mul,hp.addVal_pow,(uniformizer R S pi hp).addVal_pow,
    IsDiscreteValuationRing.addVal_eq_zero_of_unit]
  have hu:IsDiscreteValuationRing.addVal S (algebraMap R S (u:R))=0 :=
    IsDiscreteValuationRing.addVal_eq_zero_of_unit (Units.map (algebraMap R S).toMonoidHom u)
  rw [hu]

end EtaleLocalDVR318
