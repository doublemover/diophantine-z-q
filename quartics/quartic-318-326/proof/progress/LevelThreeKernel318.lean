module
public import Mathlib.RingTheory.Nilpotent.Basic
public import Mathlib.GroupTheory.OrderOfElement
public import Mathlib.GroupTheory.Index
public import Mathlib.Data.ZMod.Basic
public import Mathlib.FieldTheory.Finite.GaloisField
public import FiberCentralizer318
public section
noncomputable section
namespace LevelThreeKernel318
set_option maxHeartbeats 0
variable {R F : Type*} [Ring R] [Field F] [Fintype R] [Fintype F]

/-- A lift of a nonzero residue is a unit, using square-zero kernel and
finiteness of the actual possibly noncommutative ring. -/
theorem isUnit_iff_residue_ne_zero (π:R→+*F) (hs:Function.Surjective π)
    (hn:∀x:R,π x=0→x^2=0) (x:R) : IsUnit x ↔ π x≠0 := by
  constructor
  · intro h
    exact (h.map π).ne_zero
  · intro hx
    obtain ⟨y,hy⟩ := hs ((π x)⁻¹)
    have he:π (x*y-1)=0 := by simp [hy,hx]
    have hp:IsNilpotent (x*y-1) := ⟨2,hn _ he⟩
    have hu:IsUnit (x*y) := by simpa using hp.isUnit_add_one
    exact isUnit_of_mul_isUnit_left hu

/-- The actual additive kernel has size9 from ring size81 and residue size9. -/
theorem kernel_card (π:R→+*F) (hs:Function.Surjective π)
    (hR:Nat.card R=81) (hF:Nat.card F=9) : Nat.card π.toAddMonoidHom.ker=9 := by
  have h := AddSubgroup.card_ker_mul_card_of_surjective (f:=π.toAddMonoidHom) hs
  rw [hR,hF] at h
  omega

/-- The full unit group is the actual complement of the residue kernel. -/
theorem units_card (π:R→+*F) (hs:Function.Surjective π)
    (hn:∀x:R,π x=0→x^2=0) (hR:Nat.card R=81) (hF:Nat.card F=9) :
    Nat.card Rˣ=72 := by
  classical
  let f:Rˣ→{x:R // π x≠0}:=fun u=>⟨u,(isUnit_iff_residue_ne_zero π hs hn u).mp u.isUnit⟩
  have hi:Function.Injective f:=by
    intro u v huv
    exact Units.ext (congrArg Subtype.val huv)
  have hsur:Function.Surjective f:=by
    intro x
    obtain ⟨u,hu⟩ := (isUnit_iff_residue_ne_zero π hs hn x.val).mpr x.property
    exact ⟨u,Subtype.ext hu⟩
  have he:=Nat.card_congr (Equiv.ofBijective f ⟨hi,hsur⟩)
  have hk := kernel_card π hs hR hF
  let e:π.toAddMonoidHom.ker≃{x:R // π x=0}:={
    toFun:=fun x=>⟨x,by exact x.property⟩
    invFun:=fun x=>⟨x,by exact x.property⟩
    left_inv:=fun x=>rfl
    right_inv:=fun x=>rfl }
  have hk':Fintype.card {x:R // π x=0}=9 := by
    rw [←Nat.card_eq_fintype_card,←Nat.card_congr e]
    exact hk
  rw [he,Nat.card_eq_fintype_card,Fintype.card_subtype_compl]
  rw [←Nat.card_eq_fintype_card,hR,hk']

/-- The actual scalar subgroup generated by -1. -/
@[expose] def signs (R:Type*) [Ring R] : Subgroup Rˣ := Subgroup.zpowers (-1)

instance signs_normal (R:Type*) [Ring R] : (signs R).Normal := by
  apply Subgroup.normal_of_le_center
  rw [signs,Subgroup.zpowers_le,Subgroup.mem_center_iff]
  intro u
  apply Units.ext
  simp

theorem signs_card (h2:(2:R)≠0) : Nat.card (signs R)=2 := by
  rw [signs,Nat.card_zpowers]
  apply orderOf_eq_prime (p:=2)
  · apply Units.ext
    simp
  · intro h
    have hv:(-1:R)=1 := congrArg (fun u:Rˣ => (u:R)) h
    apply h2
    calc
      (2:R) = 1+1 := by norm_num
      _ = (-1:R)+1 := by rw [hv]
      _ = 0 := by simp

/-- The effective principal-level-three kernel is the actual central quotient. -/
theorem effective_kernel_card (π:R→+*F) (hs:Function.Surjective π)
    (hn:∀x:R,π x=0→x^2=0) (hR:Nat.card R=81) (hF:Nat.card F=9)
    (h2:(2:R)≠0) : Nat.card (Rˣ ⧸ signs R)=36 := by
  have h:Nat.card Rˣ=Nat.card (Rˣ ⧸ signs R)*Nat.card (signs R) :=
    Subgroup.card_eq_card_quotient_mul_card_subgroup (signs R)
  rw [units_card π hs hn hR hF,signs_card h2] at h
  omega

/-- The literal rank-four Atkin--Lehner group. -/
abbrev W := Fin 4 → Multiplicative (ZMod 2)

theorem W_card : Nat.card W=16 := by
  simp [W,Nat.card_eq_fintype_card,Fintype.card_fun]

/-- An actual extension of the effective kernel by W has order576. -/
theorem extension_card {Γ:Type*} [Group Γ]
    (π:R→+*F) (hs:Function.Surjective π) (hn:∀x:R,π x=0→x^2=0)
    (hR:Nat.card R=81) (hF:Nat.card F=9) (h2:(2:R)≠0)
    (q:Γ→*W) (hq:Function.Surjective q) (e:q.ker≃*(Rˣ ⧸ signs R)) :
    Nat.card Γ=576 := by
  have hk:Nat.card q.ker=36 := by
    rw [Nat.card_congr e.toEquiv]
    exact effective_kernel_card π hs hn hR hF h2
  have h:=Subgroup.card_ker_mul_card_of_surjective hq
  rw [hk,W_card] at h
  exact h.symm

instance : Fact (Nat.Prime 3) := ⟨by decide⟩

/-- A literal field of nine elements. The geometric local-ring identification
must supply the residue map into this field, not its desired unit count. -/
abbrev Residue := GaloisField 3 2
noncomputable instance : Fintype Residue := Fintype.ofFinite Residue

theorem residue_card : Nat.card Residue=9 := by
  simpa using GaloisField.card 3 2 (by decide)

/-- A four-coordinate additive basis over F3 gives the actual size81. -/
theorem ring_card_from_coordinates (e:R≃+(Fin 4→ZMod 3)) : Nat.card R=81 := by
  rw [Nat.card_congr e.toEquiv]
  simp [Nat.card_eq_fintype_card]

theorem two_ne_zero_of_residue (π:R→+*Residue) : (2:R)≠0 := by
  intro h
  have hh:(2:Residue)=0 := by
    calc
      (2:Residue) = π (1+1) := by simp only [map_add,map_one]; norm_num
      _ = π (2:R) := by congr 1; norm_num
      _ = 0 := by rw [h,map_zero]
  have ht:((2:ℕ):Residue)≠0 := by
    intro hh'
    have hd := (CharP.cast_eq_zero_iff Residue 3 2).mp hh'
    norm_num at hd
  exact ht hh

/-- All three local counts are derived from actual additive coordinates,
residue map and square-zero kernel, with no cardinality supplied as a premise. -/
theorem local_counts (e:R≃+(Fin 4→ZMod 3)) (π:R→+*Residue)
    (hs:Function.Surjective π) (hn:∀x:R,π x=0→x^2=0) :
    Nat.card R=81 ∧ Nat.card π.toAddMonoidHom.ker=9 ∧
      Nat.card Rˣ=72 ∧ Nat.card (Rˣ ⧸ signs R)=36 := by
  have hR:=ring_card_from_coordinates e
  exact ⟨hR,kernel_card π hs hR residue_card,units_card π hs hn hR residue_card,
    effective_kernel_card π hs hn hR residue_card (two_ne_zero_of_residue π)⟩

/-- Actual normalizer-group order, without a supplied576 or36 premise. -/
theorem extension_card_from_local {Γ:Type*} [Group Γ]
    (eR:R≃+(Fin 4→ZMod 3)) (π:R→+*Residue)
    (hs:Function.Surjective π) (hn:∀x:R,π x=0→x^2=0)
    (q:Γ→*W) (hq:Function.Surjective q) (e:q.ker≃*(Rˣ ⧸ signs R)) :
    Nat.card Γ=576 :=
  extension_card π hs hn (ring_card_from_coordinates eR) residue_card
    (two_ne_zero_of_residue π) q hq e

/-- Compose actual local kernel/extension counts with the genuine regular
fiber action. The field degree divides576; no group-cardinality oracle remains. -/
theorem galois_fiber_degree {Γ Ω:Type*} [Group Γ]
    (eR:R≃+(Fin 4→ZMod 3)) (π:R→+*Residue)
    (hs:Function.Surjective π) (hn:∀x:R,π x=0→x^2=0)
    (q:Γ→*W) (hq:Function.Surjective q) (e:q.ker≃*(Rˣ ⧸ signs R))
    (L:Type*) [Field L] [Algebra ℚ L] [FiniteDimensional ℚ L] [IsGalois ℚ L]
    (a:Γ→*Equiv.Perm Ω) (o:Ω) (ha:Function.Bijective (fun g:Γ=>a g o))
    (ρ:(L≃ₐ[ℚ]L)→*Equiv.Perm Ω)
    (hc:∀s:L≃ₐ[ℚ]L,∀g:Γ,∀x:Ω,ρ s (a g x)=a g (ρ s x))
    (hρ:Function.Injective ρ) :
    Module.finrank ℚ L∣576 ∧ Module.finrank ℚ L≤576 := by
  apply FiberCentralizer318.galois_torsor_degree_576 L a o ha _ ρ hc hρ
  exact extension_card_from_local eR π hs hn q hq e

end LevelThreeKernel318
