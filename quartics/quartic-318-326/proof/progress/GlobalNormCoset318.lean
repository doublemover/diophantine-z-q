module
public import GlobalNormClasses318
public import GlobalSquareHalving318
public section
namespace GlobalNormCoset318
open ConcreteG8Domain LocalGenerator318 GlobalGeneratorPoints318 GlobalNormClasses318
open WeierstrassCurve.Affine
open scoped QuadraticAlgebra
set_option maxHeartbeats 0
set_option maxRecDepth 100000
noncomputable section

/-- Representatives of the eight classes in the actual first 2-isogeny
descent, generated by -1, 1+sqrt(2), and 3-sqrt(2). -/
@[expose] def classRepresentative (i:Fin 8) : K :=
  ![1,-1,pair 1 1,pair (-1) (-1),pair 3 (-1),pair (-3) 1,pair 1 2,pair (-1) (-2)] i

/-- The exact outstanding first-descent class bound. The finite class
elimination and all point-translation consequences below are proved. -/
@[expose] def FirstDescentClasses : Prop :=
  ∀(x y:K),E.Nonsingular x y → x≠0 →
    ∃(i:Fin 8)(r:K),r≠0 ∧ x=classRepresentative i*r^2

theorem seven_times_square_not_square (r:ℚ) (hr:r≠0) : ¬IsSquare (7*r^2) := by
  rintro ⟨q,hq⟩
  have hs : IsSquare (7:ℚ) := by
    refine ⟨q/r,?_⟩
    field_simp [hr]
    nlinarith [hq]
  exact (by decide +kernel : ¬IsSquare (7:ℚ)) hs

theorem class_norm_forces_signed_square (x:K) (i:Fin 8) (r:K) (hr:r≠0)
    (hx:x=classRepresentative i*r^2) (hn:IsSquare (AnchorNorm318.norm x)) :
    ∃s:K,s≠0 ∧ (x=s^2 ∨ x= -s^2) := by
  have hnr : AnchorNorm318.norm r≠0 := AnchorNorm318.norm_ne_zero hr
  have hval := congrArg AnchorNorm318.norm hx
  rw [AnchorNorm318.norm_mul,AnchorNorm318.norm_pow] at hval
  fin_cases i
  · refine ⟨r,hr,Or.inl ?_⟩; simpa [classRepresentative] using hx
  · refine ⟨r,hr,Or.inr ?_⟩; simpa [classRepresentative] using hx
  · exfalso; have hh := hn.nonneg
    norm_num [classRepresentative,AnchorNorm318.norm_pair] at hval
    nlinarith [sq_pos_of_ne_zero hnr]
  · exfalso; have hh := hn.nonneg
    norm_num [classRepresentative,AnchorNorm318.norm_pair] at hval
    nlinarith [sq_pos_of_ne_zero hnr]
  · exfalso
    norm_num [classRepresentative,AnchorNorm318.norm_pair] at hval
    rw [hval] at hn
    exact seven_times_square_not_square _ hnr hn
  · exfalso
    norm_num [classRepresentative,AnchorNorm318.norm_pair] at hval
    rw [hval] at hn
    exact seven_times_square_not_square _ hnr hn
  · exfalso; have hh := hn.nonneg
    norm_num [classRepresentative,AnchorNorm318.norm_pair] at hval
    nlinarith [sq_pos_of_ne_zero hnr]
  · exfalso; have hh := hn.nonneg
    norm_num [classRepresentative,AnchorNorm318.norm_pair] at hval
    nlinarith [sq_pos_of_ne_zero hnr]

theorem add_zero_torsion_x (x y:K) (h:E.Nonsingular x y) (hx:x≠0) :
    ∃(yy:K)(hh:E.Nonsingular (-D/x) yy),Point.some x y h+T 0=Point.some _ yy hh := by
  let m := E.slope x 0 y 0
  let xx := E.addX x 0 m
  let yy := E.addY x 0 y m
  have hh : E.Nonsingular xx yy := nonsingular_add h (torsion_nonsingular 0) (fun he => hx he.1)
  have he : Point.some x y h+T 0=Point.some xx yy hh := Point.add_of_X_ne hx
  have hxx : xx= -D/x := by
    change E.addX x 0 (E.slope x 0 y 0)=_
    rw [addX,slope_of_X_ne hx]
    simp only [E,sub_zero,zero_sub,zero_mul,add_zero]
    field_simp [hx]
    have hc := h.1
    rw [equation_iff] at hc
    simp only [E,zero_mul,mul_zero,add_zero] at hc
    linear_combination hc
  simp only [hxx] at hh he
  exact ⟨yy,hh,he⟩

theorem label_square_point (hg:RawGroupAnchor318.SquarePointGeneration)
    (r y:K) (hr:r≠0) (h:E.Nonsingular (r^2) y) :
    ∃n:ℤ,n • P=Point.some (r^2) y h := by
  obtain ⟨j,hj,he⟩ := RootPointAlgebra318.factor_of_square_point r y hr h
  obtain ⟨n,hn⟩ := hg r j hj
  refine ⟨n,?_⟩
  simpa only [he] using hn

/-- The needed global H coset theorem is reduced to the actual first
2-descent class bound and actual square-point generation. All norm-class
elimination, x=0, identity, and T0 translation branches are discharged. -/
theorem norm_square_coset (classes:FirstDescentClasses)
    (hg:RawGroupAnchor318.SquarePointGeneration) (Q:E.Point) (hn:NormSquare Q) :
    ∃n:ℤ,Q=n • P ∨ Q=n • P+T 0 := by
  cases Q with
  | zero => exact ⟨0,Or.inl (by rw [zero_zsmul]; rfl)⟩
  | some x y h =>
    by_cases hx:x=0
    · subst x
      have he := h.1
      rw [equation_iff] at he
      have hy:y=0 := by
        have hy2:y^2=0 := by simpa [E] using he
        exact mul_self_eq_zero.mp (by simpa [pow_two] using hy2)
      subst y
      exact ⟨0,Or.inr (by simp [T,torsionX])⟩
    · obtain ⟨idx,r,hr,hrep⟩ := classes x y h hx
      have hnorm : IsSquare (AnchorNorm318.norm x) := by simpa [NormSquare,Point.xRep_some] using hn
      obtain ⟨s,hs,hp|hm⟩ := class_norm_forces_signed_square x idx r hr hrep hnorm
      · have hh : E.Nonsingular (s^2) y := by simpa only [hp] using h
        obtain ⟨n,he⟩ := label_square_point hg s y hs hh
        refine ⟨n,Or.inl ?_⟩
        simpa only [hp] using he.symm
      · obtain ⟨yy,hh,he⟩ := add_zero_torsion_x x y h hx
        have hd : 3-i≠0 := by
          intro hz
          apply GlobalSquareHalving318.D_ne
          simp [D,hz]
        have hs' : (3-i)/s≠0 := div_ne_zero hd hs
        have hx' : -D/x=((3-i)/s)^2 := by
          rw [hm]
          dsimp [D]
          field_simp [hs]
        have hh' : E.Nonsingular (((3-i)/s)^2) yy := by simpa only [hx'] using hh
        obtain ⟨n,hlabel⟩ := label_square_point hg ((3-i)/s) yy hs' hh'
        have hsum : Point.some x y h+T 0=n • P := by
          rw [he]
          simpa only [hx'] using hlabel.symm
        refine ⟨n,Or.inr ?_⟩
        calc
          Point.some x y h = (Point.some x y h+T 0)+T 0 := by rw [add_assoc,double_T,add_zero]
          _ = n • P+T 0 := by rw [hsum]

end
end GlobalNormCoset318
