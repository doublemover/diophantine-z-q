module
public import Mathlib.Analysis.SpecialFunctions.Elliptic.Weierstrass
public import Mathlib.NumberTheory.ModularForms.EisensteinSeries.QExpansion
public import Mathlib.Tactic
public section
noncomputable section
namespace PeriodEisenstein318
set_option maxHeartbeats 0

/-- The actual lattice generated by tau and one, in Eisenstein summand order. -/
@[expose] def periods (tau : UpperHalfPlane) : PeriodPair where
  ω₁ := tau
  ω₂ := 1
  indep := by
    apply LinearIndependent.pair_iff.mpr
    intro a b h
    have hi := congrArg Complex.im h
    simp only [Complex.real_smul, Complex.add_im, Complex.mul_im,
      Complex.ofReal_re, Complex.ofReal_im, mul_zero, zero_mul, add_zero,
      Complex.one_im, Complex.one_re, Complex.zero_im] at hi
    have ha : a = 0 := (mul_eq_zero.mp hi).resolve_right tau.im_pos.ne'
    subst a
    simp only [zero_smul, zero_add, smul_eq_zero, one_ne_zero, or_false] at h
    exact ⟨rfl, h⟩

@[expose] def latticeMap (tau : UpperHalfPlane) (v : Fin 2 → ℤ) : (periods tau).lattice :=
  ⟨(v 0 : ℂ)*tau + v 1, (PeriodPair.mem_lattice).mpr ⟨v 0, v 1, by simp [periods]⟩⟩

theorem latticeMap_injective (tau : UpperHalfPlane) : Function.Injective (latticeMap tau) := by
  intro v w h
  have he : (v 0 : ℂ)*tau + v 1 = (w 0 : ℂ)*tau + w 1 := congrArg Subtype.val h
  have hi := congrArg Complex.im he
  simp only [Complex.add_im, Complex.mul_im, Complex.intCast_re, Complex.intCast_im,
    zero_mul, add_zero] at hi
  have hv0 : v 0 = w 0 := by
    have hreal : (v 0 : ℝ) = (w 0 : ℝ) := mul_right_cancel₀ tau.im_pos.ne' hi
    exact_mod_cast hreal
  have hv1 : v 1 = w 1 := by
    rw [hv0] at he
    exact_mod_cast add_left_cancel he
  funext i
  fin_cases i <;> assumption

theorem latticeMap_surjective (tau : UpperHalfPlane) : Function.Surjective (latticeMap tau) := by
  intro l
  obtain ⟨m,n,h⟩ := PeriodPair.mem_lattice.mp l.property
  refine ⟨![m,n], ?_⟩
  apply Subtype.ext
  simpa [latticeMap,periods] using h

@[expose] def latticeEquiv (tau : UpperHalfPlane) : (Fin 2 → ℤ) ≃ (periods tau).lattice :=
  Equiv.ofBijective (latticeMap tau) ⟨latticeMap_injective tau,latticeMap_surjective tau⟩

/-- Actual lattice summation is reindexed through the bijection Z² -> Z*tau+Z. -/
theorem G_eq_eisenstein_sum (tau : UpperHalfPlane) (n : ℕ) :
    (periods tau).G n = ∑' v : Fin 2 → ℤ, EisensteinSeries.eisSummand n v tau := by
  rw [PeriodPair.G, ← (latticeEquiv tau).tsum_eq]
  apply tsum_congr
  intro v
  change (((v 0 : ℂ)*tau+v 1)^n)⁻¹ = _
  simp only [EisensteinSeries.eisSummand,zpow_neg,zpow_natCast]

/-- Absolute convergence of the actual lattice sum in the range used here. -/
theorem G_norm_summable (tau : UpperHalfPlane) (n : ℕ) (hn : 3 ≤ n) :
    Summable (fun l : (periods tau).lattice => ‖((l : ℂ)^n)⁻¹‖) := by
  apply (latticeEquiv tau).summable_iff.mp
  convert EisensteinSeries.summable_norm_eisSummand (k := (n : ℤ))
    (by exact_mod_cast hn) tau using 1
  funext v
  change ‖(((v 0 : ℂ)*tau+v 1)^n)⁻¹‖ = _
  simp only [EisensteinSeries.eisSummand,zpow_neg,zpow_natCast]

/-- The actual lattice Eisenstein series has its genuine zeta normalization. -/
theorem G_eq_normalized (tau : UpperHalfPlane) (n : ℕ) (hn : 3 ≤ n) :
    (periods tau).G n = 2 * riemannZeta n * ModularForm.E hn tau := by
  rw [G_eq_eisenstein_sum, tsum_eisSummand_eq_riemannZeta_mul_eisensteinSeries hn]
  change riemannZeta n * eisensteinSeries (N := 1) 0 n tau =
    2 * riemannZeta n * ((1/2 : ℂ) * eisensteinSeries (N := 1) 0 n tau)
  ring

end PeriodEisenstein318
