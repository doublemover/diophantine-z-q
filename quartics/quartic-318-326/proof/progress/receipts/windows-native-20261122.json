  "verification": "Path-specific Windows kernel checks; not default-target CI nor the full quartic theorem. Olean hashes record native artifacts, not committed build inputs.",
  "groups": [
    {
      "id": "reverse-height",
      "modules": [
        "SelectedActualSameAPlusEleven318"
      ],
      "scope": "Height logarithmic bound < 2·normalizedDegree+11 and exact square finite/infinite transport for explicit local frames; assumes finite primitive lifts and archimedean period calibration. Does not construct actual same-A frames or prove the reverse contradiction."
    },
    {
      "id": "reverse-curvature",
      "modules": [
        "SelectedActualSameACurvature64",
        "SelectedActualSameAWeightedLaplacian318"
      ],
      "scope": "Certified ordinary curvature bound and explicit weighted-Laplacian transport in the selected finite setting. Does not identify the theorem’s entire intrinsic/geometric arithmetic metric or rule out rational zeros."
    },
    {
      "id": "marked-positive-boundary",
      "modules": [
        "SelectedSameAActualLiftDifference318",
        "SelectedSameAGenuineBoundaryLifts318",
        "SelectedSameALiteralInjectiveRow318",
        "SelectedSameALocalImageLift318",
        "SelectedSameASignedLiftCocycle318",
        "SelectedSameASignedOpenInjectiveImage318",
        "SelectedSameACoboundaryGivesActualGlobalLift318",
        "SelectedSameASignedCoefficientsAcrossRow318",
        "SelectedSameASignedCoverInjectiveJoin318",
        "SelectedSameACompareCoveredBoundaries318"
      ],
      "scope": "Actual lifts, overlap comparisons, gluing, and injective-row comparison yield the H¹ equality for an explicit same-cover restricted sign gauge; they do not construct the sign gauge, unconditional positive Φ, or an arithmetic point."
    },
    {
      "id": "conditional-Artin-matrix",
      "modules": [
        "PointwiseConverseInnerStabilization",
        "PointwiseConverseOuterDefect",
        "PointwiseConverseRawMatrixReceiver",
        "PointwiseConverseRawMatrixReconstruction",
        "PointwiseConverseCochainFiniteNormalFactor",
        "PointwiseConverseMatchedInnerOuter",
        "PointwiseConverseRationalArtin",
        "PointwiseConverseRetainedArtinRows",
        "PointwiseConverseArtinRingCut"
      ],
      "scope": "Conditional §5.7 inner/outer stabilization and reconstruction; compact finite-normal factorization and finite rational Artin restriction, retained rows, and ring cut. No proof that actual Selmer corank one yields rational marked points."
    },
    {
      "id": "rational-Hilbert-basis",
      "modules": [
        "RationalHilbertPrimeBasis318"
      ],
      "scope": "Finite odd Hilbert sign reciprocity, supplementary signs, rational coordinate matrix, pivot inverse and crossed annihilator; no genuine full local/global pairing, Cassels–Tate injection, or exact Selmer corank."
    },
    {
      "id": "point-integral-certificate",
      "modules": [
        "ActualTorsorIntegralCertificates318"
      ],
      "scope": "Standalone polynomial certificates for integral torsor radical/Veronese model equations and map forms; no global torsor isomorphism or construction of rational marked points."
    },
    {
      "id": "literal-A4-finite",
      "modules": [
        "LinearA4GaussianCounts318",
        "LinearA4MixedNormCounts318",
        "LinearSelbergOmittedPrime318",
        "LinearA4EulerDensity318",
        "LinearA4ObservedResidues318"
      ],
      "scope": "Exact finite rank-two and rank-four Gaussian norm counts, common intersection, union, and Euler-factor density for actual q or u+kQ²q forms with good distinct reductions, plus separate uniform omission factor for truncated Selberg sum. No analytic FT mass bound, continuum sieve remainder, prime existence or Ready proof."
    }
  ],
