module
public import ModuleLocalIsomorphism318
public import ModuleTopExt318
public section
noncomputable section
namespace SectionGeneratedGluing318
open AlgebraicGeometry CategoryTheory Opposite
open ModuleLocalGluing318
set_option maxHeartbeats 250000
set_option backward.isDefEq.respectTransparency.types false
set_option backward.isDefEq.respectTransparency false
universe u
abbrev unit (X : Scheme.{u}) : X.Modules := SheafOfModules.unit X.ringCatSheaf
variable {X : Scheme.{u}} {M N : X.Modules}
@[expose] def genLinear (f : unit X ⟶ M) (V : X.Opens) : Γ(X,V) →ₗ[Γ(X,V)] Γ(M,V) :=
  (f.val.app (op V)).hom

theorem gen_one_mul (f : unit X ⟶ M) (V : X.Opens) (a : Γ(X,V)) :
    genLinear f V a=a • genLinear f V 1 := by
  have h := (genLinear f V).map_smul a (1:Γ(X,V))
  simpa only [smul_eq_mul,mul_one] using h

theorem gen_natural (f : unit X ⟶ M) (V W : X.Opens) (h : W≤V) (a : Γ(X,V)) :
    res M h (genLinear f V a)=genLinear f W (X.presheaf.map (homOfLE h).op a) := by
  exact (congrArg (fun q => q a) (f.mapPresheaf.naturality (homOfLE h).op)).symm

variable {ι : Type u} (U : ι → X.Opens) (f : ι → (unit X ⟶ M)) (g : ι → (unit X ⟶ N))
    (hf : ∀ i V, V≤U i → Function.Bijective (genLinear (f i) V))
    (hg : ∀ i V, V≤U i → Function.Bijective (genLinear (g i) V))

@[expose] def localEquiv (i : ι) (V : X.Opens) (hV : V≤U i) : Γ(M,V) ≃ₗ[Γ(X,V)] Γ(N,V) :=
  (LinearEquiv.ofBijective (genLinear (f i) V) (hf i V hV)).symm.trans
    (LinearEquiv.ofBijective (genLinear (g i) V) (hg i V hV))

theorem local_generator (i : ι) (V : X.Opens) (hV : V≤U i) (a : Γ(X,V)) :
    localEquiv U f g hf hg i V hV (genLinear (f i) V a)=genLinear (g i) V a := by
  exact congrArg (LinearEquiv.ofBijective (genLinear (g i) V) (hg i V hV))
    ((LinearEquiv.ofBijective (genLinear (f i) V) (hf i V hV)).symm_apply_apply a)

theorem local_natural (i : ι) (V W : X.Opens) (hV : V≤U i) (hW : W≤V) (s : Γ(M,V)) :
    res N hW (localEquiv U f g hf hg i V hV s)=
      localEquiv U f g hf hg i W (hW.trans hV) (res M hW s) := by
  obtain ⟨a,rfl⟩ := (hf i V hV).surjective s
  rw [local_generator,gen_natural,gen_natural,local_generator]

variable (hr : ∀ i j, ∃ a : Γ(X,U i),
    genLinear (f j) (U i) 1=a • genLinear (f i) (U i) 1 ∧
    genLinear (g j) (U i) 1=a • genLinear (g i) (U i) 1)

include hr in
/-- Shared exact coefficient relations make every local comparison preserve
all the specified global sections on every subopen. -/
theorem local_preserves (i j : ι) (V : X.Opens) (hV : V≤U i) :
    localEquiv U f g hf hg i V hV (genLinear (f j) V 1)=genLinear (g j) V 1 := by
  obtain ⟨a,hfa,hga⟩ := hr i j
  have hn_f := gen_natural (f j) (U i) V hV 1
  have hn_g := gen_natural (g j) (U i) V hV 1
  rw [(X.presheaf.map (homOfLE hV).op).hom.map_one] at hn_f hn_g
  rw [←hn_f,←hn_g,hfa,hga]
  change localEquiv U f g hf hg i V hV
      (M.presheaf.map (homOfLE hV).op (a • genLinear (f i) (U i) 1))=
    N.presheaf.map (homOfLE hV).op (a • genLinear (g i) (U i) 1)
  rw [Scheme.Modules.map_smul,Scheme.Modules.map_smul,LinearEquiv.map_smul]
  change _ • localEquiv U f g hf hg i V hV (res M hV (genLinear (f i) (U i) 1))=
    _ • res N hV (genLinear (g i) (U i) 1)
  rw [gen_natural,gen_natural]
  simp only [(X.presheaf.map (homOfLE hV).op).hom.map_one]
  rw [local_generator]

/-- The actual compatible local linear data, with every comparison checked
using a generating global section rather than dense-locus agreement. -/
@[expose] def data : LocalData M N U where
  map i V hV := (localEquiv U f g hf hg i V hV).toLinearMap
  natural := local_natural U f g hf hg
  compatible i j V hi hj s := by
    obtain ⟨a,rfl⟩ := (hf j V hj).surjective s
    change localEquiv U f g hf hg i V hi (genLinear (f j) V a)=
      localEquiv U f g hf hg j V hj (genLinear (f j) V a)
    rw [local_generator,gen_one_mul (f j) V a,LinearEquiv.map_smul,
      local_preserves U f g hf hg hr i j V hi]
    exact (gen_one_mul (g j) V a).symm

/-- Actual global comparison isomorphism for line sheaves generated by the
same indexed sections and exact full-chart coefficient relations. -/
@[expose] def iso (hc : ⊤ ≤ iSup U) : M ≅ N :=
  ModuleLocalIsomorphism318.iso (data U f g hf hg hr) hc
    (fun i V hV => (localEquiv U f g hf hg i V hV).bijective)

/-- The globally glued isomorphism carries each specified section exactly,
with scalar one. -/
theorem iso_preserves (hc : ⊤ ≤ iSup U) (j : ι) :
    f j ≫ (iso U f g hf hg hr hc).hom=g j := by
  apply ModuleTopExt318.ext
  change value (data U f g hf hg hr) hc ⊤ (genLinear (f j) ⊤ 1)=genLinear (g j) ⊤ 1
  apply ext_value hc ⊤
  intro i
  rw [value_restrict]
  change localEquiv U f g hf hg i (cover (U:=U) ⊤ i) inf_le_right
    (res M inf_le_left (genLinear (f j) ⊤ 1))=res N inf_le_left (genLinear (g j) ⊤ 1)
  rw [gen_natural,gen_natural]
  simp only [map_one]
  exact local_preserves U f g hf hg hr i j _ inf_le_right
end SectionGeneratedGluing318
