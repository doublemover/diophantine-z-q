module
public import LenstraTrace318
public section
noncomputable section
namespace LenstraDifferent318
open Module Algebra
open scoped nonZeroDivisors

variable (A K B L:Type*) [CommRing A] [IsDomain A] [Field K]
    [CommRing B] [IsDomain B] [Field L]
    [Algebra A K] [IsFractionRing A K] [Algebra K L] [Algebra A L]
    [Algebra A B] [Algebra B L] [IsScalarTower A K L] [IsScalarTower A B L]
    [FiniteDimensional K L] [CharZero K] [Algebra.IsSeparable K L]
    [IsIntegralClosure B A L] [IsIntegrallyClosed A] [IsDedekindDomain B]
    [IsTorsionFree A B] [IsFractionRing B L]

/-- Lenstra's trace obstruction applied to the actual different ideal:
it cannot be contained in the principal ideal generated by n times any
nonzero nonunit of the base, where n is the actual extension degree. -/
theorem different_not_le_degree_mul (x:A) (hx:x≠0) (hunit:¬IsUnit x) :
    ¬ differentIdeal A B ≤ Ideal.span { (Module.finrank K L:B) * algebraMap A B x } := by
  let b:B := (Module.finrank K L:B) * algebraMap A B x
  let y:L := algebraMap K L (((Module.finrank K L:K) * algebraMap A K x)⁻¹)
  have hbmap : algebraMap B L b =
      algebraMap K L ((Module.finrank K L:K) * algebraMap A K x) := by
    simp only [b,map_mul,map_natCast]
    rw [← IsScalarTower.algebraMap_apply A B L,
      ← IsScalarTower.algebraMap_apply A K L]
  have hn:(Module.finrank K L:K)≠0 := by
    exact_mod_cast (Module.finrank_pos (R:=K) (M:=L)).ne'
  have hxK:algebraMap A K x≠0 :=
    (map_ne_zero_iff (algebraMap A K) (IsFractionRing.injective A K)).mpr hx
  have hb:b≠0 := by
    intro h
    have hh:algebraMap K L ((Module.finrank K L:K) * algebraMap A K x)=0 := by
      rw [← hbmap,h,map_zero]
    exact (mul_ne_zero hn hxK) ((algebraMap K L).injective (by simpa using hh))
  have hy:y=(algebraMap B L b)⁻¹ := by simp only [y,hbmap,map_inv₀]
  have hymem:y∈((Ideal.span {b}:Ideal B)⁻¹:FractionalIdeal B⁰ L) := by
    rw [FractionalIdeal.coeIdeal_span_singleton,FractionalIdeal.spanSingleton_inv,hy]
    exact FractionalIdeal.mem_spanSingleton_self _ _
  intro h
  have htr := (differentialIdeal_le_iff (A:=A) (K:=K) (L:=L)
      (I:=Ideal.span {b}) (Ideal.span_singleton_eq_bot.not.mpr hb)).mp h
  have hh:Algebra.trace K L y∈(1:Submodule A K) :=
    htr (Submodule.mem_map.mpr ⟨y,hymem,rfl⟩)
  have hh':Algebra.trace K L y∈(algebraMap A K).range := Submodule.mem_one.mp hh
  exact LenstraTrace318.trace_inverse_degree_not_in_base A K L x hx hunit hh'

end LenstraDifferent318
