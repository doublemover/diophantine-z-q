module
public import QuadraticFormalPolynomial318
public import Mathlib.FieldTheory.SeparableClosure
public section
noncomputable section
namespace QuadraticFormalDifferent318
set_option maxHeartbeats 300000
set_option synthInstance.maxHeartbeats 2000
open PowerSeries QuadraticFormalBasis318 QuadraticFormalPolynomial318 Module
attribute [local instance] FractionRing.liftAlgebra FractionRing.isScalarTower_liftAlgebra
variable (k:Type*) [Field k]

@[expose] def fieldRoot : FractionRing (Cover k) := algebraMap (Cover k) _ (root k)

@[expose] def fieldBasis : Basis (Fin 2) (FractionRing k⟦X⟧) (FractionRing (Cover k)) :=
  (basis k).localizationLocalization (FractionRing k⟦X⟧) (nonZeroDivisors k⟦X⟧)
    (FractionRing (Cover k))

@[expose] def fieldPowerBasis : PowerBasis (FractionRing k⟦X⟧) (FractionRing (Cover k)) where
  gen:=fieldRoot k
  dim:=2
  basis:=fieldBasis k
  basis_eq_pow i:=by
    fin_cases i <;> simp [fieldBasis,Basis.localizationLocalization_apply,basis_zero,basis_one,fieldRoot]

theorem fraction_rank_two : Module.finrank (FractionRing k⟦X⟧) (FractionRing (Cover k))=2 := by
  rw [IsFractionRing.finrank_eq k⟦X⟧ (FractionRing k⟦X⟧) (Cover k) (FractionRing (Cover k))]
  exact rank_two k

@[expose] def fieldPolynomial : Polynomial (FractionRing k⟦X⟧) :=
  Polynomial.X^2-Polynomial.C (algebraMap k⟦X⟧ (FractionRing k⟦X⟧) PowerSeries.X)

theorem field_root_equation : Polynomial.aeval (fieldRoot k) (fieldPolynomial k)=0 := by
  simp only [fieldPolynomial,map_sub,map_pow,Polynomial.aeval_X,Polynomial.aeval_C]
  change (algebraMap (Cover k) (FractionRing (Cover k)) (root k))^2-
    algebraMap (FractionRing k⟦X⟧) (FractionRing (Cover k))
      (algebraMap k⟦X⟧ (FractionRing k⟦X⟧) PowerSeries.X)=0
  rw [←map_pow,←base_parameter,←IsScalarTower.algebraMap_apply k⟦X⟧ (Cover k),
    ←IsScalarTower.algebraMap_apply k⟦X⟧ (FractionRing k⟦X⟧),sub_self]

theorem field_minpoly : minpoly (FractionRing k⟦X⟧) (fieldRoot k)=fieldPolynomial k := by
  apply minpoly.eq_of_linearIndependent (FractionRing k⟦X⟧) (fieldRoot k)
    (Polynomial.monic_X_pow_sub_C _ (by decide)) (field_root_equation k) 2
  · rw [Polynomial.degree_eq_natDegree (Polynomial.monic_X_pow_sub_C _ (by decide)).ne_zero]
    simp [fieldPolynomial]
  · have he:(fun i:Fin 2=>(fieldRoot k)^i.val)=fieldBasis k := by
      funext i
      fin_cases i <;> simp [fieldBasis,Basis.localizationLocalization_apply,basis_zero,basis_one,fieldRoot]
    rw [he]
    exact (fieldBasis k).linearIndependent

theorem root_separable (h2:(2:k)≠0) : IsSeparable (FractionRing k⟦X⟧) (fieldRoot k) := by
  change (minpoly (FractionRing k⟦X⟧) (fieldRoot k)).Separable
  rw [field_minpoly]
  apply Polynomial.separable_X_pow_sub_C
  · have h2R:(2:k⟦X⟧)≠0 := by
      intro he
      have hh:=congrArg PowerSeries.constantCoeff he
      exact h2 (by simpa only [map_ofNat,map_zero] using hh)
    simpa only [map_ofNat,Nat.cast_ofNat] using
      (map_ne_zero_iff (algebraMap k⟦X⟧ (FractionRing k⟦X⟧)) (IsFractionRing.injective _ _)).mpr h2R
  · exact (map_ne_zero_iff _ (IsFractionRing.injective _ _)).mpr PowerSeries.X_ne_zero

/-- Separability is derived from the actual quadratic generator and degree-two
power basis, including positive characteristic different from two. -/
theorem field_separable (h2:(2:k)≠0) :
    Algebra.IsSeparable (FractionRing k⟦X⟧) (FractionRing (Cover k)) := by
  have hs:Algebra.adjoin (FractionRing k⟦X⟧) {fieldRoot k}≤
      (separableClosure (FractionRing k⟦X⟧) (FractionRing (Cover k))).toSubalgebra := by
    apply Algebra.adjoin_le
    intro x hx
    obtain rfl:=Set.mem_singleton_iff.mp hx
    exact root_separable k h2
  constructor
  intro x
  apply hs
  change x∈Algebra.adjoin (FractionRing k⟦X⟧) {(fieldPowerBasis k).gen}
  rw [(fieldPowerBasis k).adjoin_gen_eq_top]
  trivial

/-- The actual different ideal of the constructed finite-free formal quadratic
extension is generated by twice its covering parameter. -/
theorem different_eq (h2:(2:k)≠0) :
    differentIdeal k⟦X⟧ (Cover k)=Ideal.span {2*root k} := by
  letI:=field_separable k h2
  have he:=conductor_mul_differentIdeal k⟦X⟧ (FractionRing k⟦X⟧)
    (FractionRing (Cover k)) (root k) (show Algebra.adjoin (FractionRing k⟦X⟧) {algebraMap (Cover k) (FractionRing (Cover k)) (root k)}=⊤ by
      exact (fieldPowerBasis k).adjoin_gen_eq_top)
  rw [conductor_top,Ideal.top_mul,derivative_value] at he
  exact he

end QuadraticFormalDifferent318
