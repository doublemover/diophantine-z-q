theorem composition2 (x : ℚ) : H2 (-2*x-x^2) = J2 x+x^3*R2 x := by
  unfold H2 J2 R2
  ring

theorem differential2 (x : ℚ) : (1+x)*J2 x+2*x*(2+x)*dJ2 x-1 = (1/3 : ℚ)*x^3 := by
  unfold J2 dJ2
  ring

