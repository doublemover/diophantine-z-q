@[expose] def H2 (x : ℚ) : ℚ := (1)*x^0 + ((1/10 : ℚ))*x^1 + ((1/24 : ℚ))*x^2

@[expose] def J2 (x : ℚ) : ℚ := (1)*x^0 + ((-1/5 : ℚ))*x^1 + ((1/15 : ℚ))*x^2

@[expose] def R2 (x : ℚ) : ℚ := ((1/6 : ℚ))*x^0 + ((1/24 : ℚ))*x^1

